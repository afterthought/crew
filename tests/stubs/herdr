#!/usr/bin/env -S python3 -S
"""Stub herdr for crew's tests: enough of herdr's socket API for crew, and nothing real.

Every call is logged to $CREW_TEST_LOG as `<host> <session> <args...>`. State lives in
$HOME/.stub-herdr/<session>.json, so each simulated host (its own HOME) has its own servers.
`pane run` of a crew-role command runs it at once, in the pane's folder; when it exits 0 (the stub
claude has recorded its launch), the pane holds an idle agent with no name, as herdr has it after
a new session. `agent prompt <pane> /exit` ends that agent; any other prompt to an agent that is blocked is refused
with `agent_blocked`, as herdr refuses it, and typed nowhere. An agent's Claude session is `sid-<pane>` with the
pane's colon a dash, letters, digits and dashes as Claude's session ids are.

A prompt the agent takes is written to its session's transcript, as Claude Code writes it once it receives the prompt:
appended to the transcript the session has under $HOME/.claude*/projects/, else to a new one in the folder Claude keeps
for the pane's folder, $HOME/.claude/projects/<the folder, every character but a letter or digit a dash>/. A record of
type user carries the text as sent, or for a slash command `/<command> <args>` Claude's
<command-name>/<command></command-name> and <command-args><args></command-args>, with the time it was taken.

`pane run` of anything else that starts a program leaves it in the pane's foreground, as a tab's loop stays, and `pane
process-info` answers as herdr 0.9.3 does: the pane's shell alone at its prompt, that program, or the pane's agent. A
tab's last pane closed closes the tab, and a workspace's last tab the workspace, as herdr 0.9.3 closes them.

Only for tests: `herdr --session S stub status <pane|name> <status>` sets an agent's status,
`herdr --session S stub agent <pane> [name]` puts an agent in a pane, `herdr --session S stub restore <pane>` brings
a pane back as herdr does after a restart, its shell alone with nothing running in it, and `herdr --session S stub dead
<pane> [cwd]` brings it back as herdr 0.9.3 does when the pane's saved folder (cwd, else its own) is gone at the restart:
listed with a restore_error and no terminal, so its read, run, send-keys and process-info answer pane_not_found, while
its split and close work. With CREW_TEST_BLOCKED naming agents, each one
named so is stopped on a question in its pane (blocked) once it has its name, as a first run's consent stops Claude.
`herdr --session S stub leave <pane|name> <n> [status]` makes the next n prompts to that agent, up now or started
later under that name, untaken, as a prompt that lands before Claude is ready, or whose Enter is lost: each is added to
the text left typed in its input (`typed` in the state) and nothing is written to its transcript, and with a status
the agent then has that status, as one that went to work with no prompt received. A prompt taken while text is typed
is received with that text before it, as Claude submits its whole input; `agent send-keys <agent> ctrl+c`, or
`pane send-keys` of ctrl+c to its pane, clears the input, as Claude's first Ctrl+C on an idle input does.

It starts Python without its site packages and imports only what every call needs, since every test calls it often:
not even the json package, whose import of re costs a call a third of its time, but json's own C parts, writing what
json.dumps writes."""
import _json, fcntl, os, shlex, sys


class Scanning:  # what json's C scanner reads of its decoder
    strict, object_hook, object_pairs_hook, parse_float, parse_int, parse_constant = True, None, None, float, int, None


scan = _json.make_scanner(Scanning())


def dumps(o, indent=None, at=""):
    """json.dumps(o, indent=indent) of the state's values: dicts, lists, strings, whole numbers, booleans and null."""
    if isinstance(o, (dict, list)) and o:
        inner = at + " " * indent if indent is not None else ""
        items = ([f"{_json.encode_basestring_ascii(str(k))}: {dumps(v, indent, inner)}" for k, v in o.items()] if isinstance(o, dict)
                 else [dumps(v, indent, inner) for v in o])
        sep, head, tail = (",\n" + inner, "\n" + inner, "\n" + at) if indent is not None else (", ", "", "")
        return ("{" if isinstance(o, dict) else "[") + head + sep.join(items) + tail + ("}" if isinstance(o, dict) else "]")
    if isinstance(o, (dict, list)):
        return "{}" if isinstance(o, dict) else "[]"
    if isinstance(o, str):
        return _json.encode_basestring_ascii(o)
    return "null" if o is None else "true" if o is True else "false" if o is False else str(int(o))

args = sys.argv[1:]
session = "default"
if args[:1] == ["--session"]:
    session, args = args[1], args[2:]
host = os.environ.get("CREW_TEST_HOST", "?")
if os.environ.get("CREW_TEST_LOG"):
    with open(os.environ["CREW_TEST_LOG"], "a") as f:
        f.write(f"{host} {session} {shlex.join(args)}\n")

path = os.path.join(os.environ["HOME"], ".stub-herdr", f"{session}.json")
os.makedirs(os.path.dirname(path), exist_ok=True)
lock = open(path + ".lock", "w")
fcntl.flock(lock, fcntl.LOCK_EX)


def load():
    with open(path) as f:
        return scan(f.read(), 0)[0]


st = load() if os.path.exists(path) else {"n": 0, "workspaces": {}, "tabs": {}, "panes": {}, "agents": {}}


def save():
    with open(path, "w") as f:
        f.write(dumps(st, indent=1))


def out(obj):
    print(dumps({"result": obj}))


def die(msg, code=1):
    save()
    print(dumps({"error": msg}), file=sys.stderr)
    sys.exit(code)


def opt(name, default=None):
    if name in args:
        i = args.index(name)
        return args[i + 1]
    return default


def new_id():
    st["n"] += 1
    return st["n"]


def new_pane(ws, tab, cwd):
    pid = f"{ws}:p{new_id()}"
    st["panes"][pid] = {"workspace": ws, "tab": tab, "cwd": cwd, "output": ""}
    return pid


def agent_pane(target):
    if target in st["agents"]:
        return target
    for p, a in st["agents"].items():
        if a.get("name") == target:
            return p
    return None


def transcript_of(p):
    """The transcript of the stub session in a pane: the one it has under any ~/.claude*/projects/*/, the first as
    crew's transcript.py finds it, else a new one in the folder Claude keeps for the pane's folder."""
    sid = "sid-" + p.replace(":", "-")
    home, found = os.environ["HOME"], []
    for d in (x for x in os.listdir(home) if x.startswith(".claude")):
        projects = os.path.join(home, d, "projects")
        for f in os.listdir(projects) if os.path.isdir(projects) else []:
            if os.path.isfile(os.path.join(projects, f, sid + ".jsonl")):
                found.append(os.path.join(projects, f, sid + ".jsonl"))
    if found:
        return sorted(found)[0]
    folder = os.path.join(home, ".claude", "projects", "".join(c if c.isascii() and c.isalnum() else "-" for c in st["panes"][p]["cwd"]))
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, sid + ".jsonl")


def take(p, text):
    """The agent in the pane receives the prompt: its record is written to its session's transcript."""
    import time
    if text.startswith("/") and text[1:2].strip():
        command, _, args = text[1:].partition(" ")
        text = f"<command-name>/{command}</command-name>\n<command-args>{args.strip()}</command-args>"
    at = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())
    with open(transcript_of(p), "a") as f:
        f.write(dumps({"type": "user", "timestamp": at, "message": {"role": "user", "content": text}}) + "\n")


def cleared(p):
    """Ctrl+C on an agent's idle input: what was left typed in it goes."""
    if p in st["agents"]:
        st["agents"][p].pop("typed", None)


def driven(p):
    """A pane herdr drives: one it lists with no terminal, as it brings back a pane whose folder is gone, is not found."""
    p in st["panes"] or die(f"no pane {p}")
    "restore_error" not in st["panes"][p] or die({"code": "pane_not_found", "message": f"pane {p} not found"})


def listed(p):
    """A pane as herdr's pane list and pane get give it, with its workspace's and tab's ids."""
    v = st["panes"][p]
    return dict(v, pane_id=p, workspace_id=v["workspace"], tab_id=v["tab"])


def close_pane(p):
    """A pane closed, and with a tab's last pane its tab and with a workspace's last tab its workspace, as herdr 0.9.3
    closes them."""
    v = st["panes"].pop(p, None)
    st["agents"].pop(p, None)
    if v and not any(o["tab"] == v["tab"] for o in st["panes"].values()):
        st["tabs"].pop(v["tab"], None)
    if v and not any(o["workspace"] == v["workspace"] for o in st["tabs"].values()):
        st["workspaces"].pop(v["workspace"], None)


group, cmd, rest = (args + ["", ""])[0], (args + ["", ""])[1], args[2:]

if group == "workspace" and cmd == "create":
    ws = f"w{new_id()}"
    st["workspaces"][ws] = {"label": opt("--label", ws)}
    tab = f"{ws}:t{new_id()}"
    st["tabs"][tab] = {"workspace": ws, "label": "1"}
    p = new_pane(ws, tab, opt("--cwd", os.environ["HOME"]))
    out({"workspace": {"workspace_id": ws, "label": st["workspaces"][ws]["label"]}, "tab": {"tab_id": tab}, "root_pane": {"pane_id": p}})
elif group == "workspace" and cmd == "list":
    out({"workspaces": [{"workspace_id": w, "label": v["label"]} for w, v in st["workspaces"].items()]})
elif group == "workspace" and cmd == "get":
    w = rest[0]
    w in st["workspaces"] or die(f"no workspace {w}")
    out({"workspace": {"workspace_id": w, "label": st["workspaces"][w]["label"]}})
elif group == "workspace" and cmd == "close":
    w = rest[0]
    w in st["workspaces"] or die(f"no workspace {w}")
    del st["workspaces"][w]
    for t in [t for t, v in st["tabs"].items() if v["workspace"] == w]:
        del st["tabs"][t]
    for p in [p for p, v in st["panes"].items() if v["workspace"] == w]:
        close_pane(p)
    out({})
elif group == "tab" and cmd == "create":
    ws = opt("--workspace")
    ws in st["workspaces"] or die(f"no workspace {ws}")
    tab = f"{ws}:t{new_id()}"
    st["tabs"][tab] = {"workspace": ws, "label": opt("--label", tab)}
    p = new_pane(ws, tab, opt("--cwd", os.environ["HOME"]))
    out({"tab": {"tab_id": tab, "label": st["tabs"][tab]["label"]}, "root_pane": {"pane_id": p}})
elif group == "tab" and cmd == "close":
    rest[0] in st["tabs"] or die(f"no tab {rest[0]}")
    del st["tabs"][rest[0]]
    for p in [p for p, v in st["panes"].items() if v["tab"] == rest[0]]:
        close_pane(p)
    out({})
elif group == "tab" and cmd == "rename":
    rest[0] in st["tabs"] or die(f"no tab {rest[0]}")
    st["tabs"][rest[0]]["label"] = rest[1]
    out({})
elif group == "tab" and cmd == "get":
    rest[0] in st["tabs"] or die(f"no tab {rest[0]}")
    out({"tab": dict(st["tabs"][rest[0]], tab_id=rest[0])})
elif group == "tab" and cmd == "list":
    ws = opt("--workspace")
    out({"tabs": [dict(v, tab_id=t) for t, v in st["tabs"].items() if ws in (None, v["workspace"])]})
elif group == "pane" and cmd == "split":
    src = rest[0]
    src in st["panes"] or die(f"no pane {src}")
    p = new_pane(st["panes"][src]["workspace"], st["panes"][src]["tab"], opt("--cwd", st["panes"][src]["cwd"]))
    out({"pane": {"pane_id": p}})
elif group == "pane" and cmd == "get":
    rest[0] in st["panes"] or die(f"no pane {rest[0]}")
    out({"pane": listed(rest[0])})
elif group == "pane" and cmd == "list":
    ws = opt("--workspace")
    out({"panes": [listed(p) for p, v in st["panes"].items() if ws in (None, v["workspace"])]})
elif group == "pane" and cmd == "close":
    rest[0] in st["panes"] or die(f"no pane {rest[0]}")
    close_pane(rest[0])
    out({})
elif group == "pane" and cmd == "run":
    p, line = rest[0], rest[1]
    driven(p)
    if line.startswith("cd ") and "&&" in line:  # the pane's shell moves, as herdr then saves it
        st["panes"][p]["cwd"] = shlex.split(line.split("&&", 1)[0])[1]
    if line.split(" ", 1)[0] not in ("cd", "export", "printf") and "crew-role" not in line:  # a program, not the shell's own
        st["panes"][p]["running"] = line
    if "crew-role" in line:
        import subprocess
        save()
        fcntl.flock(lock, fcntl.LOCK_UN)
        r = subprocess.run(["bash", "-c", line], cwd=st["panes"][p]["cwd"], capture_output=True, text=True,
                           env=dict(os.environ, HERDR_PANE_ID=p))
        fcntl.flock(lock, fcntl.LOCK_EX)
        st = load()
        st["panes"][p]["output"] = r.stdout + r.stderr
        if r.returncode == 0:
            st["agents"][p] = {"status": "idle", "name": None}
    out({})
elif group == "pane" and cmd == "process-info":  # as herdr 0.9.3 answers: the shell's pid is the group's at its prompt
    p = opt("--pane")
    p in st["panes"] or die({"code": "pane_not_found", "message": "pane not found"})
    driven(p)
    shell = 1000 + int(p.split(":p")[1])
    run = "claude" if p in st["agents"] else st["panes"][p].get("running")
    fg = [{"pid": shell + 1, "argv": shlex.split(run)}] if run else [{"pid": shell, "argv": ["-zsh"]}]
    out({"process_info": {"pane_id": p, "shell_pid": shell, "foreground_process_group_id": fg[0]["pid"], "foreground_processes": fg}})
elif group == "pane" and cmd == "send-keys":
    driven(rest[0])
    if "ctrl+c" in rest[1:]:
        cleared(rest[0])
    out({})
elif group == "pane" and cmd == "read":
    driven(rest[0])
    print(st["panes"][rest[0]]["output"])
elif group == "agent" and cmd == "get":
    p = agent_pane(rest[0]) or die(f"no agent {rest[0]}")
    a = st["agents"][p]
    out({"agent": {"pane_id": p, "name": a["name"], "agent_status": a["status"], "agent_session": {"value": "sid-" + p.replace(":", "-")}}})
elif group == "agent" and cmd == "list":  # as herdr 0.9.3 lists them: an agent with no name has none in its item
    out({"agents": [dict({"pane_id": p, "agent_status": a["status"], "agent_session": {"value": "sid-" + p.replace(":", "-")}},
                         **({"name": a["name"]} if a["name"] else {})) for p, a in st["agents"].items()]})
elif group == "agent" and cmd == "rename":
    p = agent_pane(rest[0]) or die(f"no agent {rest[0]}")
    st["agents"][p]["name"] = rest[1]
    if rest[1] in os.environ.get("CREW_TEST_BLOCKED", "").split():
        st["agents"][p]["status"] = "blocked"
    out({})
elif group == "agent" and cmd == "prompt":
    p = agent_pane(rest[0]) or die(f"no agent {rest[0]}")
    if rest[1] == "/exit":
        del st["agents"][p]
    elif st["agents"][p]["status"] == "blocked":  # as herdr 0.9.3 refuses it, typing nothing
        die({"code": "agent_blocked", "message": f"agent {rest[0]} is blocked on an approval or question UI"})
    else:
        a = st["agents"][p]
        a.setdefault("prompts", []).append(rest[1])
        left = st.setdefault("leave", {})
        k = next((k for k in (a["name"], p) if k and left.get(k, {}).get("n")), None)
        if k:  # typed, and never received
            left[k]["n"] -= 1
            a["typed"] = a.get("typed", "") + rest[1]
            if left[k].get("status"):
                a["status"] = left[k]["status"]
        else:
            take(p, a.pop("typed", "") + rest[1])
    out({})
elif group == "agent" and cmd == "send-keys":
    p = agent_pane(rest[0]) or die(f"no agent {rest[0]}")
    if "ctrl+c" in rest[1:]:
        cleared(p)
    out({})
elif group == "agent" and cmd == "wait":
    agent_pane(rest[0]) or die(f"no agent {rest[0]}")
    out({})
elif group == "stub" and cmd == "status":
    p = agent_pane(rest[0]) or die(f"no agent {rest[0]}")
    st["agents"][p]["status"] = rest[1]
elif group == "stub" and cmd == "leave":
    st.setdefault("leave", {})[rest[0]] = {"n": int(rest[1]), "status": rest[2] if len(rest) > 2 else None}
elif group == "stub" and cmd == "restore":
    rest[0] in st["panes"] or die(f"no pane {rest[0]}")
    st["panes"][rest[0]].pop("running", None)
    st["agents"].pop(rest[0], None)
elif group == "stub" and cmd == "dead":
    rest[0] in st["panes"] or die(f"no pane {rest[0]}")
    v = st["panes"][rest[0]]
    v.pop("running", None)
    st["agents"].pop(rest[0], None)
    v["cwd"] = rest[1] if len(rest) > 1 else v["cwd"]
    v["restore_error"] = "Saved directory is unavailable. Restore the directory and restart this session."
elif group == "stub" and cmd == "agent":
    rest[0] in st["panes"] or die(f"no pane {rest[0]}")
    st["agents"][rest[0]] = {"status": "idle", "name": rest[1] if len(rest) > 1 else None}
else:
    die(f"the stub herdr has no '{group} {cmd}'", 2)
save()
