#!/usr/bin/env python3
"""Stub plannotator for crew's tests: `annotate` and `sessions`, behaving as plannotator 0.28.6 was read to behave, and
serving nothing.

`plannotator annotate <file|folder...> --gate --json --result-file <f>` registers its session in
$HOME/.stub-plannotator/<pid>.json: its pid, mode, target (each path as given, made absolute, a folder's without its
last slash, several joined by ", "), url, port, project, label (annotate-<name>, or for several paths
annotate-<count> files: their basenames joined by ", ") and startedAt, as `sessions --json` lists them, and, for the
test alone, its argv and whether PLANNOTATOR_SKIP_BROWSER_OPEN=1 and PLANNOTATOR_REMOTE=1 were set. The url is
http://<host>:<port>: the host PLANNOTATOR_URL_HOST names, `auto` as <host>.ts.swancloud.net, and localhost when it is
unset. The port is chosen as plannotator 0.28.26 chooses it from PLANNOTATOR_PORT: a range, <a>-<b> with
1 <= a <= b <= 65535, gives the first port of it no live session holds; one port gives that port; unset or unreadable
gives 19432 under PLANNOTATOR_REMOTE=1 and else a free port of the stub's own. When the port, or every port of the
range, is held, it exits 1 before registering, its last line on stderr plannotator's words for that case. It says it is
ready on stderr, and, unless the browser was skipped, records `<host> plannotator opened a browser on <url>` in
$CREW_TEST_LOG. It then waits for the decision a test writes to $HOME/.stub-plannotator/<pid>.decision, one JSON
object ({"decision": "approved", "feedback": ...}, "annotated", or "dismissed"), and writes it as plannotator does:
atomically to the result file and to stdout, then exits. Killed first, it writes no result.

A test makes the next starts fail by writing a count to $HOME/.stub-plannotator/refuse-starts: each `annotate` while
it is above zero takes one from it and exits 1 before registering, saying `stub: refused to start` on stderr, as a
plannotator that ends before its session is ready does.

`plannotator sessions --json` lists the registered sessions whose pid is alive, and, for the test alone, adds a line
to $CREW_TEST_ROOT/plannotator-sessions.log, so a test knows a wait has looked.

It ends by itself when its registry is gone, as when tests/run removes a passed test's scratch directory, or after
five minutes, so no stub outlives its test for long."""
import datetime, fcntl, json, os, pathlib, re, sys, time

reg = pathlib.Path(os.environ["HOME"]) / ".stub-plannotator"
LISTED = ("index", "mode", "target", "url", "port", "pid", "project", "label", "startedAt")


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def live():
    out = []
    for f in sorted(reg.glob("*.json")) if reg.is_dir() else []:
        try:
            s = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if alive(s["pid"]):
            out.append(s)
    return sorted(out, key=lambda s: s["startedAt"], reverse=True)


args = sys.argv[1:]
if args[:1] == ["sessions"]:
    if os.environ.get("CREW_TEST_ROOT"):
        with open(os.path.join(os.environ["CREW_TEST_ROOT"], "plannotator-sessions.log"), "a") as log:
            log.write(f"{os.environ.get('CREW_TEST_HOST', '?')} sessions\n")
    if "--json" in args:
        print(json.dumps([dict({k: s[k] for k in LISTED if k != "index"}, index=i) for i, s in enumerate(live(), 1)]))
    else:
        for i, s in enumerate(live(), 1):
            print(f"#{i} {s['mode']} {s['target']} {s['url']} pid {s['pid']}")
    sys.exit(0)
if args[:1] != ["annotate"]:
    print(f"stub plannotator: {' '.join(args)} is not stubbed", file=sys.stderr)
    sys.exit(2)

paths, result, i = [], None, 1
while i < len(args):
    if args[i] == "--result-file":
        result, i = args[i + 1], i + 2
        continue
    if not args[i].startswith("--"):
        paths.append(args[i])
    i += 1
if result and not ("--gate" in args and "--json" in args):
    print("--result-file requires --gate --json", file=sys.stderr)
    sys.exit(2)
if not paths:
    print("Usage: plannotator annotate <file.md | folder/>", file=sys.stderr)
    sys.exit(2)

refuse = reg / "refuse-starts"
if refuse.exists():
    with open(refuse, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        left = int(f.read().strip() or 0)
        if left > 0:
            f.seek(0)
            f.truncate()
            f.write(f"{left - 1}\n")
            print("stub: refused to start", file=sys.stderr)
            sys.exit(1)

host = os.environ.get("CREW_TEST_HOST", "localhost")
url_host = os.environ.get("PLANNOTATOR_URL_HOST") or "localhost"
url_host = f"{host}.ts.swancloud.net" if url_host == "auto" else url_host
named, taken = os.environ.get("PLANNOTATOR_PORT", ""), {s["port"] for s in live()}
held = "Finish or close that session, or set PLANNOTATOR_PORT to a different port."
if (m := re.fullmatch(r"([0-9]+)-([0-9]+)", named)) and 1 <= int(m[1]) <= int(m[2]) <= 65535:
    port = next((p for p in range(int(m[1]), int(m[2]) + 1) if p not in taken), None)
    if port is None:
        print(f"Plannotator: every port in PLANNOTATOR_PORT {named} is already in use, most likely by other Plannotator "
              "sessions. Finish or close one, or widen the range.", file=sys.stderr)
        sys.exit(1)
elif re.fullmatch(r"[0-9]+", named) and 1 <= int(named) <= 65535:
    port = int(named)
    if port in taken:
        print(f"Plannotator: port {port} (PLANNOTATOR_PORT) is already in use, most likely by another Plannotator "
              f"session. {held}", file=sys.stderr)
        sys.exit(1)
elif os.environ.get("PLANNOTATOR_REMOTE") == "1":
    port = 19432
    if port in taken:
        print("Plannotator: port 19432 is already in use, most likely by another Plannotator session (remote mode uses "
              f"a fixed port so it can be forwarded). {held}", file=sys.stderr)
        sys.exit(1)
else:
    port = next(p for p in range(49152, 65536) if p not in taken)
targets = [os.path.abspath(p).rstrip("/") or "/" for p in paths]
target = ", ".join(targets)
label = (f"annotate-{len(targets)} files: " + ", ".join(os.path.basename(t) for t in targets) if len(targets) > 1
         else f"annotate-{os.path.basename(target)}")
url = f"http://{url_host}:{port}"
skipped = os.environ.get("PLANNOTATOR_SKIP_BROWSER_OPEN") == "1"
reg.mkdir(parents=True, exist_ok=True)
me = reg / f"{os.getpid()}.json"
me.write_text(json.dumps({
    "mode": "annotate", "target": target, "url": url, "port": port, "pid": os.getpid(), "project": os.path.basename(os.getcwd()),
    "label": label, "startedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "argv": args, "skip_browser": skipped, "remote": os.environ.get("PLANNOTATOR_REMOTE") == "1"}))
print(f"Plannotator session ready — open on your device\n  {url}", file=sys.stderr, flush=True)
if not skipped and os.environ.get("CREW_TEST_LOG"):
    with open(os.environ["CREW_TEST_LOG"], "a") as log:
        log.write(f"{host} plannotator opened a browser on {url}\n")

decision, give_up = reg / f"{os.getpid()}.decision", time.monotonic() + 300
while not decision.exists():
    if not reg.is_dir() or time.monotonic() > give_up:
        sys.exit(0)
    time.sleep(0.05)
time.sleep(0.05)  # the test's write is whole
out = json.dumps(json.loads(decision.read_text()))
if result:
    tmp = pathlib.Path(f"{result}.tmp-{os.getpid()}")
    tmp.write_text(out + "\n")
    tmp.replace(result)
print(out)
me.unlink()
