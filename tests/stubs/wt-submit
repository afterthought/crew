#!/usr/bin/env bash
# Stub wt-submit for crew's tests: `wt submit <branch> [--no-remove]`, which worktrunk runs as wt-submit from the path,
# landing as sluice was read to land (sluice d7fdc39, its own landings #4 to #10), with no queue and no checks run. From
# the worktree it runs in, on a branch (sluice refuses a detached head), it merges that head into <branch> by git
# merge-tree, and commits the merge as sluice <sluice@localhost>, <branch>'s tip its first parent, with the subject
# `chore(land): #<n> <the submitted branch>` and the trailers Sluice-Submission, Sluice-From (`$SLUICE_AGENT (<the
# submitted branch>)`), Sluice-Tested and Sluice-Result; it moves <branch> there by git update-ref, which leaves a
# checkout of <branch> behind its branch, as sluice's move does. A <branch> the policy keeps on a remote (route.py), as
# sluice 0.36.4 lands one: the merge is formed on the remote's tip after a fetch and pushed there, refused when the
# remote moved meanwhile, and the local branch then set to it; while $CREW_TEST_ROOT/sluice-leaves-copy exists, as
# sluice 0.36.4 under its app's identity landed on deneb, it is pushed to the remote's URL, so git moves no tracking
# ref, which stays at the tip the fetch read, and the local branch is not set, the host's copy left where it was.
# <n> counts the kit's submissions, in its git common dir.
# It exits as sluice does: 0 landed; 1 the checks failed, while $CREW_TEST_ROOT/sluice-fails exists, its words the
# failure; 2 refused or in conflict; nothing moved but on 0. It removes no worktree: crew always passes --no-remove,
# and a call without it is refused. With --no-wait --json, as crew's landing submits, it is the stub sluice's `submit
# <branch> --no-wait --json`, which lands at once through this stub and answers {id, branch, ahead}, its outcome
# waiting for `sluice wait`. Every call is logged to $CREW_TEST_LOG as `<host> wt submit <args> from <worktree> as
# <SLUICE_AGENT>`.
set -uo pipefail
here=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "sluice: not in a git worktree" >&2; exit 2; }
[[ -n ${CREW_TEST_LOG:-} ]] && printf '%s wt submit %s from %s as %s\n' "${CREW_TEST_HOST:-?}" "$*" "$here" "${SLUICE_AGENT:-}" >> "$CREW_TEST_LOG"
target= remove=yes queued=
for a in "$@"; do case $a in --no-remove) remove=no ;; --no-wait | --json) queued+=" $a" ;; -*) echo "wt-submit stub: $a is not stubbed" >&2; exit 2 ;; *) target=$a ;; esac; done
[[ -n $target ]] || { echo "usage: wt submit <BRANCH> [--no-remove] [--no-wait --json]" >&2; exit 2; }
[[ $remove == no ]] || { echo "wt-submit stub: crew submits with --no-remove" >&2; exit 2; }
if [[ -n $queued ]]; then
  [[ $queued == " --no-wait --json" ]] || { echo "wt-submit stub: --no-wait goes with --json, as crew passes them" >&2; exit 2; }
  exec sluice submit "$target" --no-wait --json
fi
from=$(git symbolic-ref -q --short HEAD) || { echo "sluice: $here is on a detached head; submit from a branch" >&2; exit 2; }
remote=$(python3 "$(dirname "$0")/route.py" "$target")
if [[ -n $remote ]]; then
  git fetch -q "$remote" "+refs/heads/$target:refs/remotes/$remote/$target" 2>/dev/null || { echo "sluice: no branch $target on $remote" >&2; exit 2; }
  old=$(git rev-parse --verify -q "refs/remotes/$remote/$target")
else
  old=$(git rev-parse --verify -q "refs/heads/$target") || { echo "sluice: no branch $target" >&2; exit 2; }
fi
head=$(git rev-parse HEAD)
if [[ -e ${CREW_TEST_ROOT:?}/sluice-fails ]]; then echo "sluice: $from failed $target's checks: $(cat "$CREW_TEST_ROOT/sluice-fails")" >&2; exit 1; fi
tree=$(git merge-tree --write-tree "$old" "$head" 2>/dev/null) || { echo "sluice: $from conflicts with $target" >&2; exit 2; }
count=$(git rev-parse --git-common-dir)/stub-sluice-submissions
n=$(( $(cat "$count" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$count"
new=$(GIT_AUTHOR_NAME=sluice GIT_AUTHOR_EMAIL=sluice@localhost GIT_COMMITTER_NAME=sluice GIT_COMMITTER_EMAIL=sluice@localhost \
  git commit-tree "$tree" -p "$old" -p "$head" -m "chore(land): #$n $from" \
  -m "Sluice-Submission: $n
Sluice-From: ${SLUICE_AGENT:-} ($from)
Sluice-Tested: $head
Sluice-Result: passed (stub)") || exit 2
if [[ -n $remote && -e $CREW_TEST_ROOT/sluice-leaves-copy ]]; then
  git push -q "$(git remote get-url "$remote")" "$new:refs/heads/$target" 2>/dev/null || { echo "sluice: $target moved on $remote under the submission" >&2; exit 2; }
elif [[ -n $remote ]]; then
  git push -q "$remote" "$new:refs/heads/$target" 2>/dev/null || { echo "sluice: $target moved on $remote under the submission" >&2; exit 2; }
  git update-ref "refs/heads/$target" "$new"
else
  git update-ref "refs/heads/$target" "$new" "$old" || { echo "sluice: $target moved under the submission" >&2; exit 2; }
fi
echo "sluice: #$n $from landed on $target at ${new:0:7}"
