#!/usr/bin/env bash
# Run crew's tests: tests/run [name...]. Each test is tests/t-<name>.sh, run by bash in a scratch directory of
# its own ($T) with tests/lib.sh to source, in one of the host's test slots (tests/slot). lib.sh gives each simulated host a scratch HOME holding fixture
# teams.json and herdr-hosts.json files, makes bare git remotes, and puts stub herdr, ssh, hostname, sleep,
# plannotator, pendingyou and claude commands first on PATH. The stubs record their calls in $T/calls.log and $T/claude.log, so no test
# ever reaches a real herdr session, a real host or a real agent. It runs only inside crew's devenv shell, so a test
# never runs on the host's tools in place of the shell's: started outside it, it runs itself again inside it, from the
# checkout it is in (tests.1, record 0024).
set -uo pipefail
if [[ -z ${DEVENV_ROOT:-} ]]; then
  [[ -z ${CREW_TESTS_ENTERING:-} ]] || { echo "tests/run: devenv shell set no DEVENV_ROOT, so crew can't tell it is inside crew's devenv shell" >&2; exit 2; }
  command -v devenv >/dev/null || { echo "tests/run runs inside crew's devenv shell, and devenv is not on this host's path" >&2; exit 2; }
  here=$(cd "$(dirname "$0")/.." && pwd -P) || exit 2
  cd "$here" && CREW_TESTS_ENTERING=1 exec devenv shell -- "$here/tests/run" "$@"
fi
unset CREW_TESTS_ENTERING
TESTS=$(cd "$(dirname "$0")" && pwd -P); export TESTS

# A test must never reach the real herdr, ssh, plannotator or Pending You: refuse to run if the stubs would not be the
# ones found.
for c in herdr ssh hostname claude plannotator pendingyou; do
  [[ $(PATH="$TESTS/stubs:$PATH" command -v "$c") == "$TESTS/stubs/$c" ]] || { echo "tests/stubs/$c would not shadow $c" >&2; exit 2; }
done
for c in recsel recfix git python3 jq; do
  command -v "$c" >/dev/null || { echo "tests need $c on PATH (recutils comes with crew's devenv: devenv shell)" >&2; exit 2; }
done
# t-stage-facts holds crew's reading of a change's tasks and planning to openspec's own, on the same worktrees.
command -v openspec >/dev/null || { echo "tests need openspec on PATH (each host has it from swancloud's packages)" >&2; exit 2; }

# Written for bash 3.2 as well, the one macOS ships: an empty array is expanded as ${a[@]+"${a[@]}"}.
tests=()
if (( $# )); then for n in "$@"; do n=${n#t-}; tests+=("$TESTS/t-${n%.sh}.sh"); done
else for t in "$TESTS"/t-*.sh; do [[ -e $t ]] && tests+=("$t"); done; fi

# A scratch directory is made by mktemp under the temp dir, and only such a directory is ever removed: a failed
# mktemp stops the run rather than leaving T empty or pointing anywhere else.
tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P) || exit 2
scratch() {
  local d; d=$(mktemp -d "$tmp/crew-test.XXXXXX") || return 1
  d=$(cd "$d" && pwd -P) || return 1
  case $d in "$tmp"/crew-test.??????) echo "$d" ;; *) echo "mktemp gave $d, not a crew-test directory under $tmp" >&2; return 1 ;; esac
}
unscratch() { case ${1:?} in "$tmp"/crew-test.??????) rm -rf -- "$1" ;; *) echo "not removing $1" >&2 ;; esac; }

pass=0; failed=()
for t in ${tests[@]+"${tests[@]}"}; do
  name=$(basename "$t" .sh)
  [[ -f $t ]] || { echo "no test $name" >&2; failed+=("$name"); continue; }
  T=$(scratch) || { echo "could not make a scratch directory under $tmp" >&2; exit 2; }
  # The test runs in one of the host's test slots (tests/slot, tests.9), waiting its turn when every slot is taken.
  if (cd "$T" && T=$T python3 "$TESTS/slot" bash "$t") >"$T/out" 2>&1; then
    pass=$((pass + 1)); echo "ok    $name"; [[ -n ${CREW_TEST_SHOW:-} ]] && sed 's/^/      /' "$T/out"; unscratch "$T"
  else
    failed+=("$name"); echo "FAIL  $name   (scratch kept: $T)"; tail -25 "$T/out" | sed 's/^/      /'
  fi
done
echo "${pass} passed, ${#failed[@]} failed"
(( ${#failed[@]} == 0 ))
