#!/usr/bin/env python3
"""crew's card hook, in two halves, on a crew agent's own Pending You calls (record 0031, briefs.11, briefs.17). Every
row's card is crew's, raised, changed and closed at its event through crew's own act; what is left to an agent is a
question of its own, asked through Pending You's tools in its session.

The PreToolUse half is the hook run as `cards --before`, before every Pending You tool in a session crew started.
First it refuses a call that names its caller as anyone but the agent (name_refusal, briefs.17): Pending You labels a
session by the name its latest call gives, so a call in another agent's name reroutes that agent's answers to this
session; a call that names no caller passes this check. Then, on a card's post, change or close (post_request,
update_request, cancel_request, ack_answer) and on an area's making (create_area), apart from the name, it asks
plan.card_refusal: a card is posted, changed or closed only by the planner, main-level ops or the design agent, and
never under crew's own key, the post's idempotencyKey or, for a change or a close, the key this host's run
record holds the card under, but for the close of an answered card under a key of a row form crew no longer raises,
which no event of crew's closes; an area is made only under create-area:<owner>/<kit> for a kit of the agent's
partition, one its plan or its landings name (plan.partition_kits).
Everything else passes: a question's form is its asker's. A call crew could not check is refused, naming what failed,
since a card let through can't be taken back (read.1). A refused call never reaches Pending You.

The PostToolUse half is the hook run with no argument, after a Pending You tool that posts (post_request), updates
(update_request), withdraws (cancel_request) or closes (ack_answer) a card, in a session crew started, and writes one
entry, card.post, card.update or card.close, on the agent's own object, agent/<the agent>, with the card's id in Card
and its key in Key: the post's idempotencyKey, or the key this host's record holds the card under. A reply that gives
no card's id is recorded as unread (State unread), which the rail lists. Nothing written on the card is recorded: no
title, summary, option, note or outcome.

A session crew started has CREW_AGENT and CREW_LABEL, or, when herdr resumed it, the record session-start keeps of
it. A session with a CREW_AGENT but no CREW_LABEL is a crew agent whose partition crew can't tell: its name is checked,
its card or area is refused, naming the missing CREW_LABEL, and nothing it does is recorded. Any other session, and a
tool of another server, is neither checked nor recorded; a result that is an error writes nothing. The PostToolUse
half never fails a tool call, whatever its input."""
import datetime
import json
import os
import pathlib
import re
import sys

LIB = pathlib.Path(__file__).resolve().parent.parent / "lib"
# The tools whose `name` names an area, not the caller (Pending You 0.35.1); every other tool's `name` is the caller's.
AREA_NAMED = ("create_area", "rename_area", "suggest_area_name")
# The calls checked, after the caller's name, for who makes them and under which key: a card posted, changed or
# closed, and an area made.
KEYED = ("post_request", "update_request", "cancel_request", "ack_answer", "create_area")
ACTS = {"post_request": "card.post", "update_request": "card.update", "cancel_request": "card.close", "ack_answer": "card.close"}
REQUEST_ID = re.compile(r"^req_[A-Za-z0-9-]{1,40}$")
# How far back a change's or a close's card is looked for among this host's posts.
DAYS = 30


def is_pending_you(server):
    """Pending You's server under any name, a plugin's as well: as the wake mod's isPendingYou reads it."""
    return "pendingyou" in re.sub(r"[^a-z0-9]", "", server.lower())


def result_object(result):
    """The tool's result as an object, as the wake mod's resultObject reads it: structuredContent, else the first text
    block that parses as a JSON object. Claude Code gives an MCP tool's result as its content blocks, as an object
    holding them, or, as 2.1.292 does for Pending You's, as the text itself."""
    if isinstance(result, str):
        result = {"text": result}
    if isinstance(result, list):
        result = {"content": result}
    if not isinstance(result, dict):
        return None
    if isinstance(result.get("structuredContent"), dict):
        return result["structuredContent"]
    texts = []

    def blocks(v):
        if isinstance(v, list):
            texts.extend(b["text"] for b in v if isinstance(b, dict) and isinstance(b.get("text"), str))
    if isinstance(result.get("text"), str):
        texts.append(result["text"])
    inner = result.get("result")
    if isinstance(inner, str):
        texts.append(inner)
    elif isinstance(inner, dict):
        if isinstance(inner.get("structuredContent"), dict):
            return inner["structuredContent"]
        blocks(inner.get("content"))
    else:
        blocks(inner)
    blocks(result.get("content"))
    for t in texts:
        try:
            parsed = json.loads(t)
        except ValueError:
            continue
        if isinstance(parsed, dict):
            return parsed
    return None


def failed(result):
    return isinstance(result, dict) and (result.get("isError") is True or "deny" in result)


def identity(sid):
    """The crew agent and its partition: from the environment, else from the record session-start wrote of the session."""
    agent, label = os.environ.get("CREW_AGENT"), os.environ.get("CREW_LABEL")
    if agent:
        return agent, label
    if not isinstance(sid, str) or not re.fullmatch(r"[A-Za-z0-9-]+", sid):
        return None, None
    record = pathlib.Path.home() / ".local/state/crew/sessions" / sid
    if not record.is_file():
        return None, None
    saved = dict(line.split("=", 1) for line in record.read_text().splitlines() if "=" in line)
    return saved.get("CREW_AGENT"), saved.get("CREW_LABEL")


def callers(tool, given):
    """The names a Pending You call gives for its caller, [(field, value)] in the call's order: `name` on every tool but
    those whose `name` is an area's (AREA_NAMED), whoami's previousName, which moves that name's cards and wake to this
    session, match_area's task and post_request's session.label. A field the call leaves out is not given."""
    named = [("name", given["name"])] if "name" in given and tool not in AREA_NAMED else []
    for field, on in (("previousName", "whoami"), ("task", "match_area")):
        if tool == on and field in given:
            named.append((field, given[field]))
    session = given.get("session")
    if isinstance(session, dict) and "label" in session:
        named.append(("session.label", session["label"]))
    return named


def name_refusal(agent, tool, given):
    """Before any Pending You call by a crew agent: None when every name the call gives for its caller is the agent's
    own, or it gives none, else the words that refuse it (briefs.17). Pending You labels a session by the name its
    latest call gives, so a call in another agent's name reroutes that agent's answers to this session. A call that
    gives no name claims none, so it passes: the session keeps the name its last named call gave, which this check
    holds to the agent's own. A name that is not a string, or is empty, is not the agent's."""
    wrong = [(f, v) for f, v in callers(tool, given) if v != agent]
    if not wrong:
        return None
    gives = " and ".join(f"{f} {json.dumps(v)}" for f, v in wrong)
    moved = ", or with no previousName" if any(f == "previousName" for f, _ in wrong) else ""
    return (f"crew refuses this {tool}: it gives {gives}, and this session is {agent}'s. Pending You labels a session by "
            f"the name its latest call gives, so a call in another agent's name reroutes that agent's answers to this "
            f"session. Call it again in your own name, {agent}{moved}.")


def posted(record, label, card):
    """The Key of this host's card.post entry for a card, from the label's run record of the last DAYS days; None when
    it holds none."""
    d = record.ROOT / label / "runs" / record.crew.this_host()
    since = (datetime.datetime.now(datetime.timezone.utc).date() - datetime.timedelta(days=DAYS)).isoformat()
    found = None
    for f in sorted(d.glob("*.rec")) if d.is_dir() else []:
        if f.stem < since:
            continue
        for e in record.parse(f.read_text()):
            if e.get("Act") == "card.post" and e.get("Card") == card:
                found = e.get("Key")
    return found


def card_key(label, tool, given):
    """The key a card call is under: a post's idempotencyKey or an area's, else the key this host's run record holds
    the card it names under."""
    if tool in ("post_request", "create_area"):
        return given.get("idempotencyKey")
    card = given.get("requestId")
    if not (isinstance(card, str) and REQUEST_ID.match(card)):
        return None
    sys.path.insert(0, str(LIB))
    import record
    return posted(record, label, card)


def key_refusal(hook, tool):
    """Before a card is posted, changed or closed, or an area made, in a session crew started: why crew refuses it, or
    None to let it through (plan.card_refusal); a refusal too when crew can't check it, saying to try again later."""
    what = "area" if tool == "create_area" else "card"
    try:
        agent, label = identity(hook.get("session_id"))
        if not agent:
            return None
        if not label:
            return f"crew could not check this {what}: {agent}'s session has no CREW_LABEL, so crew can't tell its partition."
        given = hook.get("tool_input")
        if not isinstance(given, dict):
            raise ValueError("its input is not an object")
        sys.path.insert(0, str(LIB))
        import plan
        fleet = plan.crew.load()
        kits = plan.kits_read(fleet, label) if tool == "create_area" else ()  # an area's kit is one the partition names
        return plan.card_refusal(fleet, agent, label, tool, card_key(label, tool, given), kits)
    except Exception as e:  # a card crew can't check is refused: one let through can't be taken back
        return f"crew could not check this {what}: {str(e).rstrip('.')}. Try it again later."


def refusal(hook):
    """Why crew refuses a Pending You call before it runs, or None to let it through: first a call in a name that is not
    the agent's own, on any tool; then a card's post, change or close, or an area's making, that is not the agent's
    to make (key_refusal)."""
    name = hook.get("tool_name")
    m = re.fullmatch(r"mcp__(.+)__([a-z_]+)", name) if isinstance(name, str) else None
    if not m or not is_pending_you(m.group(1)):
        return None
    tool = m.group(2)
    agent, _ = identity(hook.get("session_id"))
    if agent:
        given = hook.get("tool_input")
        if not isinstance(given, dict):
            raise ValueError("its input is not an object")
        why = name_refusal(agent, tool, given)
        if why:
            return why
    return key_refusal(hook, tool) if tool in KEYED else None


def check():
    """The PreToolUse half: deny the call with why crew refuses it, or print nothing to let it through."""
    try:
        hook = json.load(sys.stdin)
        if not isinstance(hook, dict):
            raise ValueError("the hook's input is not a JSON object")
        reason = refusal(hook)
    except Exception as e:  # a call crew can't check is refused, never let through unchecked
        reason = f"crew could not check this call: {e}"
    if reason:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": reason}}))


def main():
    hook = json.load(sys.stdin)
    m = re.fullmatch(r"mcp__(.+)__([a-z_]+)", hook.get("tool_name") or "")
    if not m or not is_pending_you(m.group(1)) or m.group(2) not in ACTS:
        return
    tool = m.group(2)
    sid = hook.get("session_id")
    agent, label = identity(sid)
    if not agent or not label:
        return
    result = hook.get("tool_response")
    if failed(result):
        return
    out = result_object(result) or {}
    given = hook.get("tool_input") if isinstance(hook.get("tool_input"), dict) else {}
    sys.path.insert(0, str(LIB))
    import record
    os.environ.update(CREW_AGENT=agent, CREW_LABEL=label, CREW_SESSION=f"{record.crew.this_host()}:{sid}" if sid else "")
    card = out.get("requestId") if tool == "post_request" else given.get("requestId") or out.get("requestId")
    card = card if isinstance(card, str) and REQUEST_ID.match(card) else None
    key = given.get("idempotencyKey") if tool == "post_request" else posted(record, label, card) if card else None
    record.emit(label, ACTS[tool], [f"agent/{agent}"], Card=card, Key=key if isinstance(key, str) and key else None,
                State=None if card else "unread")


if __name__ == "__main__":
    if sys.argv[1:] == ["--before"]:
        check()
        sys.exit(0)
    try:
        main()
    except Exception as e:  # a tool call is never failed by crew's bookkeeping after it, nor by input it can't read
        print(f"crew cards: {e}", file=sys.stderr)
    sys.exit(0)
