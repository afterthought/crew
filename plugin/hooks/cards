#!/usr/bin/env python3
"""crew's card hook, in two halves. Before a crew agent posts a Pending You card, changes one or makes an area, crew
refuses a card or an area under a key that is not the agent's own, and a card in another form than its key's. After it
posts, updates, withdraws or closes a card, the card is an entry in its partition's run record, so the rail knows which
of its rows, and which decision records, have a card open, and whose.

The PreToolUse half is the hook run as `cards --before`, before Pending You's post_request, create_area or
update_request in a session crew started. Before a card is posted or an area made, it asks plan.card_refusal whether
the agent may use the call's idempotencyKey: a card's must be a rail row's key the agent owns, which only the planner
and the conductors have, or, for the design agent, a decision record's, record/<kit>/<number>/<commit> for a kit of
its partition (briefs.15); an area's must be create-area:<owner>/<kit> for a kit of its own (briefs.11). Any other key
is refused in words naming the key to use, and so is a call crew could not check, in words saying to post it again
later, since a card crew let through can't be taken back (read.1). A card posted under a row's key the agent owns, or
a record key, is then checked against its key's form (FORMS), but a proposal's, which is checked against the proposal
itself: in the form `crew plan card <n>` prints, its unit questions holding the units the proposal makes new to a
bolt, each once (briefs.13); a proposal crew can't read refuses the card, saying to post it again later, and one that
no longer applies refuses it, saying to write the proposal again. A batch's card is one notice naming every unit of
the batch, read from the run record, with nothing to answer, no attachment, no code block in its words and one link,
to the batch's reading session; a batch's card posted under batch/<n>-<k>, before a batch was one card, is read as it
was posted and not checked. A record's card is an approval of low risk, reversible, with no options or steps. No row's
card asks a question in words, which Pending You makes required. A change is checked when this host's card.post entry
for the card names one of those keys, for what the change gives it: a landing card's high stakes cleared, options on
an approval or a notice, steps on any card, a question in words, a batch card's approval, attachment, code block,
second link or background that leaves out a unit, or a record card's approval of a risk other than low, or not
reversible. What the half cannot read of a batch's units refuses the card, saying to post it again later. A card in
another form is refused with the form to use. A refused call never reaches Pending You. What the half cannot otherwise
check, its own input that is not a JSON object and the run record among it, is refused with what failed. A change to a
card under any other key, or to a card this host has no post of, passes unchecked.

The PostToolUse half is the hook run with no argument, after a Pending You tool that posts (post_request), updates
(update_request), withdraws (cancel_request) or closes (ack_answer) a card, in a session crew started, and writes one
entry: card.post, card.update or card.close. The entry names the rail row's object in On (proposal/<n>, unit/<unit> or
bolt/<bolt>, from the card's key), or a decision record's, record/<kit>/<number>, the card's id in Card, and the key in
Key when the card was posted with a row key or a record key as its idempotencyKey. A card with any other key is on
agent/<the agent>, with no Key, since its key is text an agent wrote. Nothing written on the card is recorded: no
title, summary, option, note or outcome.

When a crew agent withdraws or closes a card with a row key, the hook then ends the plannotator session `crew card
session` started for that key on this host, as `crew card end` does, so no card's session outlives its card. When
plannotator's list of sessions can't be read, it ends nothing, keeps the session for a later rail read to end, and
says so to the agent, in end_session's words, as the tool's additional context. A batch card's one session, on the
whole batch, is on the main level's host, where the planner closes it, and is ended so too. An old batch card's
sessions, batch/<n>-<k>'s one per unit on each unit's team's host, are ended by `crew card end <key>` started apart,
since reaching those hosts takes longer than a hook may. A record card is given no session, so its close ends none.

A session crew started has CREW_AGENT and CREW_LABEL, or, when herdr resumed it, the record session-start keeps of
it. A session with a CREW_AGENT but no CREW_LABEL is a crew agent whose partition crew can't tell: its card or area is
refused, naming the missing CREW_LABEL, and nothing it does is recorded. Any other session, and a tool of another
server, is neither checked nor recorded; a result that is an error writes nothing. The PostToolUse half never fails a
tool call, whatever its input."""
import datetime
import json
import os
import pathlib
import re
import sys

LIB = pathlib.Path(__file__).resolve().parent.parent / "lib"
# The calls checked before they run: a card posted or an area made, for its key, and a card posted or changed, for
# its form.
KEYED = ("post_request", "create_area")
FORMED = ("post_request", "update_request")
ACTS = {"post_request": "card.post", "update_request": "card.update", "cancel_request": "card.close", "ack_answer": "card.close"}
REQUEST_ID = re.compile(r"^req_[A-Za-z0-9-]{1,40}$")
# The rail's row keys and a decision record's key, and the object of each, with a verify report's, which no row has
# had since its findings were fixed in one round (teams.17), so a card posted under it before is recorded closing.
KEYS = ((re.compile(r"^proposal/(\d+)$"), "proposal/{}"),
        (re.compile(r"^batch/(\d+)(?:-\d+)?$"), "batch/{}"),
        (re.compile(r"^verify/([a-z0-9][a-z0-9-]*)/\d{8}-\d{4}$"), "unit/{}"),
        (re.compile(r"^land/([a-z0-9][a-z0-9-]*)/[0-9a-f]{7}$"), "bolt/{}"),
        (re.compile(r"^record/([a-z0-9][a-z0-9-]*)/(\d{4})/[0-9a-f]{7}$"), "record/{}/{}"))
# The form each row's card takes, and a decision record's, in Pending You's kinds of card, by the key's shape: the kinds
# it may be, whether it is marked high stakes, whether it must carry options (True) or may carry none (False), whether it
# may carry steps, for a record's the risk its approval names, and the form in the briefs' words. A landing card asks
# only for the landing (record 0025): a step only the user can take is the deploy's, on its own card.
FORMS = {
    "proposal": dict(kinds=("approve",), high=False, options=False, steps=False,
                     says="a proposal's card is posted as `crew plan card <n>` prints it, and a change to it changes "
                          "only its words: no questions, options or steps"),
    "land": dict(kinds=("approve",), high=True, options=False, steps=False,
                 says="a landing's card is an approval, kind \"approve\", marked high stakes with highStakes true, "
                      "whose yes has you tell main-level ops to land; it has no options and no steps"),
    "batch": dict(kinds=("fyi",), high=False, options=False, steps=False,
                  says="a batch's card is one notice for the whole batch, kind \"fyi\", saying what it is, naming "
                       "every unit, with each unit's summary as prose in its background, one link to the batch's reading "
                       "session and nothing to answer: no options, no question, no approval, no steps and no attachment"),
    "record": dict(kinds=("approve",), high=False, options=False, steps=False, risk="low",
                   says="a decision record's card is an approval, kind \"approve\", whose approve block has risk "
                        "\"low\" and reversible true, with no options or steps"),
}
# A card that asks a question in words, on any row: Pending You makes every question required (briefs.13).
WORDS = "asks a question in words, which Pending You makes required"
NOTE = "The card's note is where the user's words go."
# A line of a card's words that opens a code block, which scrolls sideways on the phone.
FENCE = re.compile(r"^[ \t]*(```|~~~)", re.M)
# How far back a close looks for its card's post.
DAYS = 30


def is_pending_you(server):
    """Pending You's server under any name, a plugin's as well: as the wake mod's isPendingYou reads it."""
    return "pendingyou" in re.sub(r"[^a-z0-9]", "", server.lower())


def result_object(result):
    """The tool's result as an object, as the wake mod's resultObject reads it: structuredContent, else the first text
    block that parses as a JSON object. Claude Code gives an MCP tool's result as its content blocks, as an object
    holding them, or, as 2.1.292 does for Pending You's, as the text itself."""
    if isinstance(result, str):
        result = {"text": result}
    if isinstance(result, list):
        result = {"content": result}
    if not isinstance(result, dict):
        return None
    if isinstance(result.get("structuredContent"), dict):
        return result["structuredContent"]
    texts = []

    def blocks(v):
        if isinstance(v, list):
            texts.extend(b["text"] for b in v if isinstance(b, dict) and isinstance(b.get("text"), str))
    if isinstance(result.get("text"), str):
        texts.append(result["text"])
    inner = result.get("result")
    if isinstance(inner, str):
        texts.append(inner)
    elif isinstance(inner, dict):
        if isinstance(inner.get("structuredContent"), dict):
            return inner["structuredContent"]
        blocks(inner.get("content"))
    else:
        blocks(inner)
    blocks(result.get("content"))
    for t in texts:
        try:
            parsed = json.loads(t)
        except ValueError:
            continue
        if isinstance(parsed, dict):
            return parsed
    return None


def failed(result):
    return isinstance(result, dict) and (result.get("isError") is True or "deny" in result)


def identity(sid):
    """The crew agent and its partition: from the environment, else from the record session-start wrote of the session."""
    agent, label = os.environ.get("CREW_AGENT"), os.environ.get("CREW_LABEL")
    if agent:
        return agent, label
    if not isinstance(sid, str) or not re.fullmatch(r"[A-Za-z0-9-]+", sid):
        return None, None
    record = pathlib.Path.home() / ".local/state/crew/sessions" / sid
    if not record.is_file():
        return None, None
    saved = dict(line.split("=", 1) for line in record.read_text().splitlines() if "=" in line)
    return saved.get("CREW_AGENT"), saved.get("CREW_LABEL")


def keyed(key):
    """A row key or a record key and its object, or (None, None) for any other key."""
    for pattern, obj in KEYS:
        m = pattern.match(key) if isinstance(key, str) else None
        if m:
            return key, obj.format(*m.groups())
    return None, None


def approval(given):
    """The card's approve block, or the one question's when the card is grouped; None when it gives none."""
    questions = given.get("questions")
    if "approve" not in given and isinstance(questions, list) and len(questions) == 1 and isinstance(questions[0], dict):
        return questions[0].get("approve")
    return given.get("approve")


def words(given):
    """Whether a card, or a change to one, asks a question in words: a text card, a text field, or a question of kind
    text."""
    questions = given.get("questions")
    return (given.get("kind") == "text" or "text" in given
            or isinstance(questions, list) and any(isinstance(q, dict) and q.get("kind") == "text" for q in questions))


def background(given):
    """A card's background, as Pending You takes it in its context, or None when the card gives none."""
    context = given.get("context")
    return context.get("background") if isinstance(context, dict) else None


def links(given):
    """A card's links, as Pending You takes them in its context, or None when the card gives none."""
    context = given.get("context")
    return context.get("links") if isinstance(context, dict) else None


def listing(things):
    return things[0] if len(things) == 1 else ", ".join(things[:-1]) + " and " + things[-1]


def form_refusal(key, given, update=False, units=None):
    """None for a card in its key's form, else the words that refuse it: the form a card under the key takes, and each
    thing wrong with this one. An update is checked only for what it changes: its kind was checked when it was posted. A
    batch's card, given its batch's units, must name each in its background, as a whole word."""
    row = key.split("/")[0]
    form = FORMS[row]
    kind, options, action = given.get("kind"), given.get("options"), given.get("action")
    steps = action.get("steps") if isinstance(action, dict) else None
    steps = [s for s in steps if isinstance(s, dict)] if isinstance(steps, list) else []
    has_options = isinstance(options, list) and len(options) > 0
    wrong = []
    if "questions" in given:
        wrong.append("gives it questions" if update else "is a grouped card of questions")
    if words(given):
        wrong.append(WORDS)
    if not update:
        if not isinstance(kind, str):
            wrong.append("names no kind")
        elif kind not in form["kinds"] and kind != "text":
            wrong.append(f"is {'an' if kind[:1] in 'aeiou' else 'a'} \"{kind}\"")
    if form["high"]:
        if update and "highStakes" in given and given["highStakes"] is not True:
            wrong.append("clears its high stakes")
        elif not update and given.get("highStakes") is not True:
            wrong.append("is not marked high stakes")
    if form["options"] is False and has_options:
        wrong.append("gives it options" if update else "has options")
    elif form["options"] is True and not has_options and not update:
        wrong.append("has no options")
    if steps and not form["steps"]:
        wrong.append("gives it steps for the user to take" if update else "has steps for the user to take")
    if form.get("risk") and (not update or "approve" in given):
        approve = approval(given)
        if not isinstance(approve, dict):
            wrong.append("gives it no approve block" if update else "has no approve block")
        else:
            if approve.get("risk") != form["risk"]:
                risk = approve.get("risk")
                said = f"risk \"{risk}\"" if isinstance(risk, str) else "no risk"
                wrong.append(f"gives it {said}" if update else f"has {said}")
            if approve.get("reversible") is not True:
                wrong.append("makes it not reversible" if update else "is not reversible")
    if row == "batch":
        if given.get("approve") is not None:
            wrong.append("gives it an approval" if update else "approves something")
        if given.get("artifacts"):
            wrong.append("attaches its summary")
        if any(isinstance(t, str) and FENCE.search(t) for t in (given.get("summary"), background(given))):
            wrong.append("puts its summary in a code block, which scrolls sideways on the phone")
        if isinstance(links(given), list) and len(links(given)) > 1:
            wrong.append("links more than one session; a batch has one reading session")
    if units is not None:
        said = background(given) if isinstance(background(given), str) else ""
        missing = [u for u in units if not re.search(rf"(?<![A-Za-z0-9-]){re.escape(u)}(?![A-Za-z0-9-])", said)]
        if missing:
            wrong.append(f"leaves out {listing(missing)}")
    if not wrong:
        return None
    says = form["says"][0].upper() + form["says"][1:]
    listed = wrong[0] if len(wrong) == 1 else ", ".join(wrong[:-1]) + ", and " + wrong[-1]
    note = f" {NOTE}" if WORDS in wrong else ""
    if update:
        return f"crew refuses this change to card {key}. {says}. This change {listed}.{note} Change the card without it."
    return f"crew refuses card {key}. {says}. This card {listed}.{note} Post it again in that form."


def proposal_refusal(label, key, given):
    """None for a proposal's card in the form `crew plan card <n>` prints it, else the words that refuse it: the form
    the card takes, and each thing wrong with this one. A proposal that makes no unit new to a bolt, or more than
    fifteen, has a plain approval; one of one to fifteen asks `plan`, an approval, and units-<k> questions holding its
    new units each once, a lone one as a choice. No question asks for words, as on every row (WORDS). The card's questions are
    computed as crew plan card computes them, from the branch, fetched once (plan.12); a proposal crew can't read
    refuses the card (read.1), saying to post it again later; one that no longer applies to the plan refuses it saying
    to write the proposal again, and a closed one saying only that it has no card, since posting again helps neither."""
    sys.path.insert(0, str(LIB))
    import plan
    n = int(key.split("/")[1])
    later = f"crew could not check card {key} against proposal {n}: {{}}. Post it again later."
    try:
        fleet = plan.crew.load()
        w, _, p, _ = plan.at_tip(fleet, label, n)
    except Exception as e:  # a card crew can't check is refused: one let through can't be taken back
        return later.format(str(e).rstrip("."))
    try:
        m = plan.card_model(fleet, label, w, p)
    except plan.crew.Refusal as e:  # the card is drawn from the branch alone, so this is the proposal, not a read
        again = (f" Proposal {n} no longer applies to the plan as it stands: write the proposal again with "
                 f"`crew plan propose <file> --replaces {n}`, and post the card crew plan card prints for it."
                 if p.get("State") == "open" else "")
        return f"crew refuses card {key}: {str(e).rstrip('.')}.{again}"
    except Exception as e:
        return later.format(str(e).rstrip("."))
    return proposal_form(n, m, given, f"`{plan.crew.HOME}/plugin/bin/crew plan card {n} --label {label}`")


def proposal_form(n, m, given, shown):
    """None for proposal n's card in the form its card model m gives it, as `crew plan card` prints it (shown, the
    command that prints it), else the words that refuse it (briefs.13)."""
    key, (new, lone, asks) = f"proposal/{n}", (m["new"], m["lone"], m["questions"])
    kind, options, questions, action = given.get("kind"), given.get("options"), given.get("questions"), given.get("action")
    steps = action.get("steps") if isinstance(action, dict) else None
    wrong = [WORDS] if words(given) else []
    if len(asks) == 1:
        says = (f"Proposal {n} makes " + ("no unit" if not new else "more than fifteen units") + " new to a bolt, so its "
                "card is an approval, kind \"approve\", with a note for changes or for dropping it, and no options, steps "
                f"or questions, as {shown} prints it")
        if questions is not None:
            wrong.append("is a grouped card of questions")
        elif not isinstance(kind, str):
            wrong.append("names no kind")
        elif kind not in ("approve", "text"):
            wrong.append(f"is {'an' if kind[:1] in 'aeiou' else 'a'} \"{kind}\"")
        if isinstance(options, list) and options:
            wrong.append("has options")
    else:
        want = "choice" if lone else "multi"
        says = (f"Proposal {n} makes {len(new)} unit{'' if lone else 's'} new to a bolt, so its card asks `plan`, an "
                f"approval, and a question of its new units, of kind \"{want}\", as {shown} prints it, and no question of "
                "kind \"text\": the note is the place for words")
        asked = [q for q in questions if isinstance(q, dict)] if isinstance(questions, list) else []
        if not asked:
            wrong.append("asks no questions" + (", as a plain approval" if kind == "approve" else ""))
        else:
            if asked[0].get("id") != "plan" or asked[0].get("kind") != "approve":
                wrong.append("does not ask `plan`, of kind \"approve\", first")
            for q in asked[1:]:
                if q.get("kind") != "text" and (q.get("id") not in asks or q.get("id") == "plan" or q.get("kind") != want):
                    wrong.append(f"asks {q.get('id')}, which is no question of its new units of kind \"{want}\"")
            held = {q["id"]: [o.get("id") for o in q.get("options") or [] if isinstance(o, dict) and o.get("id") != "leave-out"]
                    for q in asked[1:] if q.get("id") in asks and q.get("id") != "plan"}
            units = [u for us in held.values() for u in us]
            missing = [u for u in new if u not in units]
            extra = [u for u in dict.fromkeys(units) if u not in new]
            twice = [u for u in dict.fromkeys(units) if units.count(u) > 1]
            if missing:
                wrong.append(f"does not ask about {', '.join(missing)}, new to a bolt in proposal {n}")
            if extra:
                wrong.append(f"asks about {', '.join(map(str, extra))}, which proposal {n} does not make new to a bolt")
            if twice:
                wrong.append(f"asks about {', '.join(twice)} more than once")
            if not (missing or extra or twice):
                for q, us in asks.items():
                    if q != "plan" and sorted(held.get(q, [])) != sorted(us):
                        wrong.append(f"does not hold {', '.join(us)} in {q}")
    if isinstance(steps, list) and any(isinstance(x, dict) for x in steps):
        wrong.append("has steps for the user to take")
    if not wrong:
        return None
    listed = wrong[0] if len(wrong) == 1 else "; ".join(wrong[:-1]) + "; and " + wrong[-1]
    note = f" {NOTE}" if WORDS in wrong else ""
    return f"crew refuses card {key}. {says}. This card {listed}.{note} Post it again in that form."


def posted(record, label, card):
    """The Key and On of this host's card.post entry for a card, from the label's run record of the last 30 days."""
    d = record.ROOT / label / "runs" / record.crew.this_host()
    since = (datetime.datetime.now(datetime.timezone.utc).date() - datetime.timedelta(days=DAYS)).isoformat()
    found = (None, None)
    for f in sorted(d.glob("*.rec")) if d.is_dir() else []:
        if f.stem < since:
            continue
        for e in record.parse(f.read_text()):
            if e.get("Act") == "card.post" and e.get("Card") == card:
                found = (e.get("Key"), e["On"][0] if e["On"] else None)
    return found


def key_refusal(hook, tool):
    """Before a card is posted or an area made in a session crew started: why crew refuses the call's key, or None when
    the agent may use it; a refusal too when crew can't check it, saying to post it again later."""
    what, later = ("area", "Make it again later.") if tool == "create_area" else ("card", "Post it again later.")
    try:
        agent, label = identity(hook.get("session_id"))
        if not agent:
            return None
        if label:
            sys.path.insert(0, str(LIB))
            import plan
            given = hook.get("tool_input") if isinstance(hook.get("tool_input"), dict) else {}
            why = plan.card_refusal(plan.crew.load(), agent, label, tool, given.get("idempotencyKey"))
        else:
            why = f"crew could not check this {what}: {agent}'s session has no CREW_LABEL, so crew can't tell its partition."
    except Exception as e:  # a card crew can't check is refused: one let through can't be taken back
        why = f"crew could not check this {what}: {str(e).rstrip('.')}. {later}"
    return why


def form_check(hook, tool):
    """Before a card is posted or changed in a session crew started: why crew refuses a row's card in another form than
    its row's, or None to let it through."""
    agent, label = identity(hook.get("session_id"))
    if not agent or not label:
        return None
    given = hook.get("tool_input")
    if not isinstance(given, dict):
        raise ValueError("its input is not an object")
    update = tool != "post_request"
    if not update:
        key = keyed(given.get("idempotencyKey"))[0]
        if key and key.startswith("proposal/"):
            return proposal_refusal(label, key, given)
    else:
        card = given.get("requestId")
        if not (isinstance(card, str) and REQUEST_ID.match(card)):
            return None
        sys.path.insert(0, str(LIB))
        import record
        key = keyed(posted(record, label, card)[0])[0]
    if not formed(key):
        return None
    units = None
    if key.startswith("batch/") and (not update or isinstance(given.get("context"), dict) and "background" in given["context"]):
        try:
            units = batch_units(label, key)
        except Exception as e:  # a card crew can't check is refused: one let through can't be taken back
            return (f"crew could not check card {key} against the units of batch {key.split('/')[1]}: {str(e).rstrip('.')}. "
                    f"{'Change it' if update else 'Post it'} again later.")
    return form_refusal(key, given, update=update, units=units)


def batch_units(label, key):
    """The units of the batch a card under batch/<n> holds, every one, from the partition's run record."""
    sys.path.insert(0, str(LIB))
    import plan
    return plan.card_units(plan.crew.load(), label, key)


def formed(key):
    """Whether a card under a row's key is checked against its row's form: every row's but a batch card posted under
    batch/<n>-<k>, before a batch was one card, which is read as it was posted."""
    return bool(key) and key.split("/")[0] in FORMS and not re.fullmatch(r"batch/\d+-\d+", key)


def refusal(hook):
    """Why crew refuses a Pending You card or area before it is posted, changed or made, or None to let the call
    through: first a key that is not the agent's own, then a row's card in another form than its row's."""
    name = hook.get("tool_name")
    m = re.fullmatch(r"mcp__(.+)__([a-z_]+)", name) if isinstance(name, str) else None
    if not m or not is_pending_you(m.group(1)):
        return None
    tool = m.group(2)
    return (key_refusal(hook, tool) if tool in KEYED else None) or (form_check(hook, tool) if tool in FORMED else None)


def check():
    """The PreToolUse half: deny the call with why crew refuses its card or area, or print nothing to let it through."""
    try:
        hook = json.load(sys.stdin)
        if not isinstance(hook, dict):
            raise ValueError("the hook's input is not a JSON object")
        reason = refusal(hook)
    except Exception as e:  # a card crew can't check is refused, never let through unchecked
        reason = f"crew could not check this card's form: {e}"
    if reason:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": reason}}))


def main():
    hook = json.load(sys.stdin)
    m = re.fullmatch(r"mcp__(.+)__([a-z_]+)", hook.get("tool_name") or "")
    if not m or not is_pending_you(m.group(1)) or m.group(2) not in ACTS:
        return
    tool = m.group(2)
    sid = hook.get("session_id")
    agent, label = identity(sid)
    if not agent or not label:
        return
    result = hook.get("tool_response")
    if failed(result):
        return
    out = result_object(result) or {}
    given = hook.get("tool_input") if isinstance(hook.get("tool_input"), dict) else {}
    sys.path.insert(0, str(LIB))
    import record
    os.environ.update(CREW_AGENT=agent, CREW_LABEL=label, CREW_SESSION=f"{record.crew.this_host()}:{sid}" if sid else "")
    if tool == "post_request":
        card = out.get("requestId")
        key, on = keyed(given.get("idempotencyKey"))
    else:
        card = given.get("requestId") or out.get("requestId")
        key, on = posted(record, label, card) if isinstance(card, str) and REQUEST_ID.match(card) else (None, None)
    card = card if isinstance(card, str) and REQUEST_ID.match(card) else None
    record.emit(label, ACTS[tool], [on or f"agent/{agent}"], Card=card, Key=key)
    # A key posted before its row's form changed (a bare land/<bolt>) is still closed under it, and has no session; nor
    # has a record card.
    if ACTS[tool] == "card.close" and keyed(key)[0] and re.fullmatch(r"batch/\d+-\d+", key):
        import subprocess
        crew_bin = pathlib.Path(__file__).resolve().parent.parent / "bin" / "crew"
        subprocess.Popen(["bash", str(crew_bin), "card", "end", key, "--label", label], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif ACTS[tool] == "card.close" and keyed(key)[0] and not key.startswith("record/"):
        import plan
        said, _ = plan.end_session(label, key)
        # A session end_session keeps is one whose plannotator list it could not read: the agent is told, in its
        # words, that nothing was ended and a later rail read ends it (read.1).
        if (plan.CARDS / label / key / "session.json").exists():
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": said}}))


if __name__ == "__main__":
    if sys.argv[1:] == ["--before"]:
        check()
        sys.exit(0)
    try:
        main()
    except Exception as e:  # a tool call is never failed by crew's bookkeeping after it, nor by input it can't read
        print(f"crew cards: {e}", file=sys.stderr)
    sys.exit(0)
