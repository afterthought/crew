#!/usr/bin/env bash
# Run one of a partition's main-level roles in the current pane, started from its agent definition
# (plugin/roles/<role>.md):
#
#   crew-role <label> design|planner|ops|reviewer|operator [resume]
#
# The definition's frontmatter gives the model and effort, unless the teams file's `roles` overrides them for
# that partition; its body, filled from the teams file, is appended to Claude Code's own system prompt.
# With "resume" the role picks its last conversation back up, by the name it was started under.
# A main level's role starts only on the host the teams file names for its main level; on any other it is refused,
# naming that host, and no Claude starts (crew.py main_elsewhere_said).
set -euo pipefail
scope=${1:?usage: crew-role <label> <role> [resume]}; role=${2:?usage: crew-role <label> <role> [resume]}
here=$(cd "$(dirname "$0")" && pwd)
spec=$(python3 "$here/../lib/crew.py" launch "$scope" "$role" ${3:+"$3"}) || exit 2
eval "$spec"
cd "$CWD"
# What the agent's own crew commands read: who is writing to the plan, and in which partition. sluice names the agent
# behind a submission from SLUICE_AGENT, so it carries the same name. crew's SessionStart hook records CREW_ROLE, the
# definition the brief comes from, to give the brief back to a session herdr resumes, and CREW_LAUNCH, what the start
# is made of besides crew's plugin, which tells an update that changes it (hooks/session-start, teams.19).
export CREW_AGENT=$NAME CREW_LABEL=$LABEL SLUICE_AGENT=$NAME CREW_ROLE=$ROLE CREW_LAUNCH=$LAUNCH
exec claude "${args[@]}"
