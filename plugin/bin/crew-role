#!/usr/bin/env bash
# Run one team role in the current pane: crew-role <team> conductor|fable|explorer|ops|coder-N|verifier [resume]
# With "resume" the role picks its last conversation back up, by the name it was started under, with its brief and tools intact.
set -euo pipefail
team=${1:?usage: crew-role <team> conductor|fable|explorer|ops|coder-N|verifier}
role=${2:?usage: crew-role <team> conductor|fable|explorer|ops|coder-N|verifier}
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../lib/team-env.sh"
wb=$DESIGN
git_read=('Bash(git log:*)' 'Bash(git show:*)' 'Bash(git diff:*)' 'Bash(git status:*)')
git_write=('Bash(git add:*)' 'Bash(git commit:*)')
case $role in
  conductor)
    cd "$wb"; name=$CONDUCTOR
    args=(--model 'opus[1m]' --effort medium --add-dir "$KIT"
      --allowed-tools 'Bash(herdr agent:*)' "Bash($TEAM_CMD status:*)" "Bash($TEAM_CMD clear:*)" "Bash($TEAM_CMD assign:*)" "Bash($TEAM_CMD release:*)" 'Bash(openspec list:*)' 'Bash(openspec status:*)' 'Bash(openspec show:*)' "${git_read[@]}")
    ;;
  fable)
    cd "$wb"; name=$FABLE
    args=(--model fable --effort high --add-dir "$KIT" --permission-mode acceptEdits
      --allowed-tools 'Bash(git -C:*)' 'Bash(herdr agent prompt:*)' "${git_read[@]}" "${git_write[@]}")
    ;;
  explorer)
    cd "$KIT"; name=$EXPLORER
    args=(--model 'opus[1m]' --effort high --add-dir "$wb" --permission-mode acceptEdits
      --allowed-tools 'Bash(openspec:*)' "${git_read[@]}" "${git_write[@]}")
    ;;
  coder-*)
    work=$(awk -v r="$role" '$1==r{print $3}' "$state/assignments" 2>/dev/null)
    [[ -n $work && -d $work ]] || { echo "$TEAM-$role holds no change. Give it one with: crew assign $team $role <change>" >&2; exit 2; }
    cd "$work"; name=$TEAM-$role
    args=(--model 'opus[1m]' --effort xhigh --add-dir "$wb" --add-dir "$KIT")
    ;;
  verifier)
    work=$(awk '$1=="verifier"{print $3}' "$state/assignments" 2>/dev/null)
    [[ -n $work && -d $work ]] || { echo "$VERIFIER holds no change. Give it one with: crew assign $team verifier <change>" >&2; exit 2; }
    cd "$work"; name=$VERIFIER
    args=(--model 'opus[1m]' --effort high --add-dir "$wb" --add-dir "$KIT"
      --allowed-tools 'Bash(openspec:*)' "${git_read[@]}")
    ;;
  ops)
    cd "$KIT"; name=$OPS
    args=(--model 'opus[1m]' --effort high --add-dir "$wb")
    ;;
  *) echo "unknown role: $role" >&2; exit 2 ;;
esac
[[ ${3:-} == resume ]] && args+=(--resume "$name")
brief=$role; [[ $role == coder-* ]] && brief=coder
prompt=$(CREW_SELF=$name python3 "$here/../lib/render.py" "$team" "$brief")
exec claude "${args[@]}" --name "$name" --append-system-prompt "$prompt"
