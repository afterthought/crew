#!/usr/bin/env bash
# Run one role in the current pane, started from its agent definition (plugin/roles/<role>.md):
#
#   crew-role <team> conductor|ops [resume]
#   crew-role <team> unit-<n> construct|code|verify|merge|fix
#   crew-role <label> design|planner|ops|dispatcher|operator [resume]
#
# The definition's frontmatter gives the model and effort, unless the teams file's `roles` overrides them for
# that team or partition; its body, filled from the teams file, is appended to Claude Code's own system prompt.
# With "resume" the role picks its last conversation back up, by the name it was started under.
set -euo pipefail
scope=${1:?usage: crew-role <team|label> <role> [stage|resume]}; role=${2:?usage: crew-role <team|label> <role> [stage|resume]}
here=$(cd "$(dirname "$0")" && pwd)
spec=$(python3 "$here/../lib/crew.py" launch "$scope" "$role" ${3:+"$3"}) || exit 2
eval "$spec"
cd "$CWD"
# What the agent's own crew commands read: who is writing to the plan, and in which partition.
export CREW_AGENT=$NAME CREW_LABEL=$LABEL
exec claude "${args[@]}"
