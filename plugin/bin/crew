#!/usr/bin/env bash
# crew: run bolt teams of agents in herdr, and each partition's main level. Teams and partitions are data in
# ~/.config/crew/teams.json.
#
# A team builds one bolt at a time:
#   crew list                          the teams that are defined
#   crew status  [team]                the conductor and ops (state, context use, compactions, age), and each unit
#                                      slot with the unit or fix it holds and its stage, a unit carried onto its
#                                      bolt inside another's merge named so, with its merge owed. It first frees each slot
#                                      whose work has merged, been dropped or left the team's bolt, once its agent
#                                      is not working, and removes, through the kit's wt remove, the worktrees in
#                                      the team's kit checkout whose work is over, naming one kept for uncommitted
#                                      changes or a remove hook
#   crew up      <team>                open the team's workspace and start its conductor and ops, each greeted: ops
#                                      told who it is, what its team holds and to wait to be told; the conductor told
#                                      to carry on with its bolt, its greeting (also on rebuild, restart and revive)
#                                      opening with the units of its bolt that wait amended, for it to start their
#                                      construct. A greeting is read back from the agent's transcript and sent once
#                                      more when not taken. A pane herdr lists with no terminal, its folder gone
#                                      when herdr started, is closed and opened again in the team's workspace, said
#                                      (also on restart, resume, revive and a stage's start); one an agent holds is
#                                      never touched
#   crew rebuild <team>                end everything the team has, close its panes, and stand it up fresh,
#                                      keeping only the slots of work still in flight on its bolt
#   crew close   <team>                end everything the team has and close its panes; nothing is started
#   crew restart <team> [role...] [--no-greet]
#                                      end the conductor's or ops' session and start a fresh one in the same pane,
#                                      greeted; --no-greet leaves the greeting to the caller, as a bolt's give does
#   crew resume  <team> [role...]      bring back the conductor or ops when not up, with its last conversation, or
#                                      fresh and greeted when it has none; a conductor brought back with its
#                                      conversation is sent, as crew's notice, the units of its bolt that wait amended
#   crew clear   <team> <role>         /clear the conductor or ops and give it its name back
#   crew down    <team>                end every session the team has; the panes stay
#   crew unit free <unit> [--team <team>]
#                                      free a slot still holding a unit no longer in the team's bolt now, rather
#                                      than at the read after its agent settles: end its agent, and remove the
#                                      worktrees whose work is over; refused while its worktree has uncommitted
#                                      changes
#   crew unit run <unit> construct|code|verify|settle|merge ["<words>"]
#                                      start the unit's stage in its slot, a fresh agent at that stage's effort:
#                                      construct writes its OpenSpec change, once each unit it comes after has
#                                      committed its own, its new place taking their work, made ready through the
#                                      kit's .config/sluice.toml (its toolchain, then its runner's setup); code
#                                      builds it as soon as it is committed, its prompt naming an overlap of
#                                      Touches; verify checks it once, naming the paths it changed and did not
#                                      declare, its report marking each finding fix or leave; code run again
#                                      with the report's path is its one round of fixes; settle takes what reached
#                                      a verified unit; merge archives its change and submits it to the bolt
#                                      through sluice, wt submit, once each unit it comes after has merged and
#                                      while its branch holds no other unit's change open that the bolt does not
#                                      hold archived, its place made again from the bolt when it was carried there
#                                      and its place is gone, delivered once the bolt holds the change archived. Construct run again on a
#                                      planned unit marks it amended: code waits
#                                      until that construct has committed. An amendment to a unit's intent runs
#                                      its construct itself, and anyone may start construct on a unit that waits
#                                      amended. Refused while the team is down. The stage begins only once its
#                                      agent's transcript shows its prompt, sent once more when it does not; else
#                                      it never started, with nothing left typed, and the command fails saying so
#   crew chore run <chore> code|verify|merge ["<words>"]
#                                      start a chore's stage in its slot, a fresh agent at that stage's effort, in
#                                      places/chore-<chore> on chore/<chore> from the bolt: code does the chore's words,
#                                      each commit carrying its Chore: trailer; verify checks the commits against them;
#                                      merge merges it into the bolt as a unit's merge does. Code starts once what it
#                                      comes after has something committed to build on, its place taking their heads;
#                                      verify needs a commit of its own; merge needs its verify delivered once, the
#                                      trailer on every commit of its own, and what it comes after merged. A chore has no
#                                      construct and no review; a unit after a chore is constructed once its code has
#                                      delivered
#   crew chore wait|free <chore> ...   as a unit's wait and free
#   crew unit wait <unit> [--timeout <ms>] [--stuck <ms>]
#                                      first forecast conflicts with git merge-tree, telling each later unit once,
#                                      ordering a later unit after an earlier one whose work its settle took, and
#                                      lifting an order of crew's whose settle found nothing to change, saying so;
#                                      rebase dependents whose unit merged, and count the partition's changes due for
#                                      a batch; then wait for the unit's stage to end at what it delivers (construct's
#                                      change, code's ticked tasks, verify's report, settle's commit, merge's commit
#                                      on the bolt, a unit's change archived in it), or at its agent saying what it needs; the stage's end is
#                                      recorded. It returns sooner when
#                                      the agent has been quiet past --stuck (15 minutes) with nothing of its own
#                                      running, or is gone, or the timeout (an hour) passes, and says which
#                                      first saying, in sluice's words, each conflict or failed check sluice's
#                                      overview shows for a submission from the stage's place
#   crew fix     <team> <name> "<what is wrong>"
#                                      a fix on the team's bolt: fix/<bolt>/<name> at places/fix-<bolt>--<name>,
#                                      built by a fresh code agent; a name already in use on the bolt is refused.
#                                      A place that could not be made ready refuses no fix: its agent starts there,
#                                      told the step that failed, since a fix is how a bolt is repaired. Its prompt,
#                                      and its merge's, is taken or sent again as a unit stage's is
#   crew fix     <team> <name> --merge merge the fix into the bolt: a merge stage, its submission to sluice as a
#                                      unit's is
#   crew fix     <team> <name> --drop [--force]
#                                      end a fix not wanted: its slot freed, its agent ended (a working one only with
#                                      --force), its place and branch removed as a dropped unit's, its branch kept and
#                                      named when git cherry finds commits of its own beyond the bolt; a merged fix is
#                                      refused
#   crew fix     <team> <name> --wait [--timeout <ms>] [--stuck <ms>]
#                                      wait for the fix's stage to end: its commits, or its merge on the bolt
#   crew needs   "<what you need>"     run by a stage's agent that can't finish without
#                                      something only someone else can give: its stage ends short, and the conductor
#                                      is given the words, by its wait or by a tell
#
# The plan, the moves and the signals crew records, on the flywheel's branch <label>/main of the partition's state
# repository; a meeting's signals stay in the partition's first blueprints repo:
#   crew state init <label>            create the flywheel's branch, adopting plan/<label> and the moves it had
#   crew bolts [<bolt>] [--label L] [--json]
#                                      every bolt, unit and chore of the plans, each one's stage read from its kit, and
#                                      each held bolt's verification, sluice's verdict on its last landing
#   crew bolt  new|give|order|drop|land ...
#                                      give makes bolt/<bolt> from GitHub's main, origin/main after a fetch, with no
#                                      worktree, refused in a kit whose .config/sluice.toml there names no checks for
#                                      its bolt branches
#   crew bolt  submit <bolt> [--label L]
#                                      main-level ops's landing: the bolt's branch submitted to its kit's main through
#                                      sluice from a short-lived worktree on the team's host, waiting for the outcome;
#                                      sluice pushes it to GitHub, and the landing pushes nothing and levels no host
#   crew unit  add|split|amend|order|after|move|drop ...
#   crew chore add|order|after|move|drop ...
#                                      planned maintenance that changes nothing a spec says, written as a unit is, by the
#                                      same hands, and built in its bolt by code, verify and merge
#   crew plan  propose|proposed|agree|approve|answer|drop ...
#                                      the planner's proposals: a change to the plan, applied once the user approves it,
#                                      crew raising its Pending You card at propose; approve --clear leaves out the new
#                                      units the user cleared; answer records the card's answers and applies the
#                                      approval once it holds them all
#   crew rail  [--label L]             what waits on the user: proposals, review batches and bolts to land,
#                                      each with when it began to wait, the command that answers it and its Pending
#                                      You card; then the questions the agents asked; then the decision records
#                                      waiting on you, each the design agent's open card for one; then any open card
#                                      whose row is gone. It sweeps the cards on this host under its sign-in: closes
#                                      a card whose row is gone, withdraws a question whose asker has ended, and
#                                      posts again a row's card Pending You no longer finds and a row's card that
#                                      has none, through its kind's raise; and it ends, on every host of the
#                                      partition, each card session crew started whose card is closed or whose row
#                                      is gone. It says what each did, and each host it could not check
#   crew board [--label L] [--json]    the flow, one partition at a time, as four lanes stacked: Inception (signals
#                                      no move has taken, explorations), Bolt plan (proposals, planned bolts, the
#                                      queue), Construction (each held bolt as a ledger of its units, fixes, slots and
#                                      dev servers) and Operation (bolts landed this week, each environment's deploys
#                                      and the operations waiting); each rail row a marker on its object, what needs
#                                      attention at the foot; it answers nothing
#   crew card  session|wait|end <key> [<unit>] [--label L]
#                                      the plannotator session on what a rail row's card asks the user to read, which
#                                      crew starts with a batch's card, a landing card and a long proposal's: session
#                                      prints its link (the running one's, else one started on this host with no
#                                      browser), a batch card's one on the whole batch, on the main level's host, a
#                                      landing's (land/<bolt>) one on what the bolt brings to main, on the host of the
#                                      team holding it, changing its open card to carry a new link while it waits on
#                                      the user, a proposal's only for one of more than fifteen new units, and an old
#                                      batch card's (batch/<n>-<k>) one per <unit> on that unit's team's host; wait
#                                      waits for the user's decision in it and prints it with their words, for a batch
#                                      card waits on the card too, printing its note and every annotation, and closes
#                                      the card, and for a landing prints its annotations as notes on the landing card
#                                      and its approval as landing nothing, leaving the card, starting the reading
#                                      first when none runs while its conductor holds the card, refused naming crew
#                                      card session land/<bolt> when it will not open; end ends it, as the card's
#                                      close does
#   crew card  sweep --label L         the rail's, run on each host of the partition with what it judged on standard
#                                      input: ends the sessions there whose card is closed or whose row is gone; not
#                                      for hand use
#   crew card  read <key> [--label L] [--json]
#                                      where the asker's card stands: its status, whose turn, the user's answer and words;
#                                      an approval the user declined is closed with their words
#   crew signal <slug> "<what it asserts>" --excerpt "<the words, verbatim>" ...
#                                      record a finding as a signal, quoting the words that show it, which are
#                                      checked against the agent's own Claude transcript
#   crew signal show <id>              a signal, where its excerpt came from, and its move
#   crew signal move <id> attach|challenge|new-territory|answered|drop ...
#                                      curation's move for a signal
#   crew signal land <capture-dir> --label L
#                                      a program's capture, a deployer's or another adapter's, with its signals,
#                                      landed on the flywheel's branch from the host that banked its raw record
#   (crew bolt|unit|chore|plan|signal --help says more)
#
# Each partition's main level, and the operator agent in each operator session:
#   crew main     up|down|status <label>  the design agent, the planner and ops in the <label> workspace of the
#                                      main level's session, and a dispatcher on each host the partition's teams run on;
#                                      each agent up starts is greeted to read where the partition stands and carry on;
#                                      a pane herdr brought back dead is closed and opened again in its workspace, said
#   crew review   <label> [--wait [--timeout <ms>]]
#                                      the partition's reviewer, started fresh for the batch of changes due, in a
#                                      review tab beside the planner; --wait waits for its summary, records the batch,
#                                      raises its card with its reading session in the planner's name, and closes the
#                                      tab
#   crew record   <kit> <number> --proposed|--accepted|--rejected [--settled-in-pane] [--alternatives <file>]
#                                      the design agent's, at each turn of a decision record's status once it is on the
#                                      kit's main: the status recorded with its commit; --proposed raises the record's
#                                      card in the design agent's name, or at a new commit changes it, a new card
#                                      following it once the user has answered it, unless --settled-in-pane says the
#                                      user said yes in the pane; --alternatives <file> makes it a choice, loosen the
#                                      rules as drafted, accept as ruled or send back; --accepted or --rejected closes
#                                      it with the commit. A status the file does not hold is refused
#   crew operator up <label>           the operator agent in this host's operator session <label>, with a flow tab
#                                      following the run record, a rail tab (crew rail above, a shell below) and a
#                                      board tab drawn from the rail tab's read, each tab's command run again where a
#                                      restart left its pane a shell; the agent it starts is greeted the same way
#   crew tell     <agent> "<text>"     prompt an agent crew started, wherever it runs, marked with who sent it;
#                                      refused, with nothing typed, while the agent waits on a question in its pane
#   crew revive                        after a restart, every standing agent of this host whose pane came back with no
#                                      agent in it, or dead, closed and opened again in its layout first, picked up
#                                      from its last conversation and greeted when it is a conductor or an agent
#                                      outside a team, or started fresh and greeted when it has none; a team or main
#                                      level taken down with crew down stays down
#   crew sites    [<label>] [--json]   every host's bolts, units and fixes, with the URL of each running dev server
#
# Operations on a partition's environments, a deploy being one kind (plan.14), run where the partition's main level
# runs (lib/ops.py says each in full):
#   crew ops offer <env> --label L --to <sha> --from <sha|none> [--notes <file>] [--steps <file>]
#                                      a manual environment's deploy offered as a rail row, its card raised in
#                                      main-level ops's name with the kit's changelog and after-deploy steps
#   crew ops approve <env> --label L --to <sha>
#                                      the user's word for it
#   crew ops word|quiet <env> --label L
#                                      the commit the user's word is for; whether the environment's host is quiet
#   crew ops record <env> --label L --to <sha> --act start|step|end [...]
#                                      a deploy's start, steps and end in the run record as it runs
#   crew ops step <env> --label L --key K --state S [--to <sha>] [--held] [...]
#   crew ops steps <env> --label L --json
#                                      any other operation and its state, on its own or after a deploy
#
# What happened, read from the run record every command that moves work appends on the host it ran on:
#   crew events   [--label L] [--about <object>] [--since <time>] [--follow] [--json]
#                                      the entries of the partition's branch and of every host it runs on, in time order
#   crew events   --push [--label L]   carry this host's run record to the partition's branch now
#   crew trace    <object>             one bolt's, unit's or signal's history: what was done, by whom, in which
#                                      session, with which commit, and what it led to
#   crew page     <label> [--out <file>] [--since <time>]
#                                      the partition's page, one HTML file that loads nothing: it opens on the board,
#                                      its four lanes drawn as the flywheel mockup draws them, narrowed to one team
#                                      when chosen, kept across reloads, and its header linking each other partition's
#                                      page beside it (../<label>/page.html); one switch away, the lineage: signals,
#                                      agenda items, proposals, units and bolts as columns, a line from each to what
#                                      it led to, and each one's history as crew trace prints it; and the deploys,
#                                      each environment's as a timeline, with the word, steps, checks and outcome of
#                                      each, and the bolts it carried with their proposals; written whole to
#                                      ~/.local/state/crew/<label>/page.html on this host, or --out, and its path
#                                      printed with as of when and which commit it was drawn from
#
# A team is two herdr workspaces in its session: "<team>", with a "conductor" tab (the conductor and ops) and a
# "git" tab (gitgui in the kit and the blueprints repo), and "<team> units", one pane per slot in flight, which
# exists only while a unit or fix is. A team's panes and state live on its host, so a command about a team runs
# there. Add --force to act on an agent that is working.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
py() { python3 "$here/../lib/crew.py" "$@"; }
teams() { py teams || exit 1; }
this_host() { hostname -s; }
usage() { awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

orig=("$@"); forced=(); greet=(); args=()
for a in "$@"; do case $a in --force) forced=(--force) ;; --no-greet) greet=(--no-greet) ;; *) args+=("$a") ;; esac; done
set -- ${args[@]+"${args[@]}"}
cmd=${1:-}

# ------------------------------------------------------------------------------------------- where a command runs

# Every command is one Python process (code.7): exec'd below, or run by `one`, which runs a command on a team or a main
# level on the host its agents run on. Who asks, and the Claude session behind them, go with a command run on another
# host, so what it records there names them (code.3).
identity() { echo "CREW_AGENT=${CREW_AGENT:-$(id -un)@$(this_host)}"; }
there() {  # there <host's ssh name> <crew on that host> <args...>: run a crew command on another host, never prompting
  local target=$1 remote=$2; shift 2
  ssh -o BatchMode=yes "$target" "$(printf '%q ' env "$(identity)" "CREW_LABEL=${CREW_LABEL:-}" "CREW_SESSION=${CALLER_SESSION:-}" bash "$remote" "$@")"
}
one() {  # one <plan.py entry> <args...>: the command as one Python process. Run on another host than its agents', the
  # process does nothing there but say on its descriptor 3 where they run, how crew runs there and the asker's session,
  # and the command is run there instead.
  local to rc=0
  { to=$(python3 "$here/../lib/plan.py" "$@" 3>&1 >&4 4>&-) || rc=$?; } 4>&1
  [[ -n $to ]] || exit $rc
  eval "$to"
  [[ -z ${REMOTE_CREW_REFUSED:-} ]] || { echo "$REMOTE_CREW_REFUSED" >&2; exit 1; }
  there "$SSH_TARGET" "$REMOTE_CREW" "${orig[@]}"; exit $?
}
need_team() { [[ -n ${1:-} ]] || { echo "which team? teams: $(teams | tr '\n' ' ')" >&2; exit 2; }; }
need_label() { [[ -n ${1:-} ]] || { echo "which partition? partitions: $(py labels | tr '\n' ' ')" >&2; exit 2; }; }
limits() {  # limits [--timeout <ms>] [--stuck <ms>]: a wait's limits, in `limit`
  limit=()
  while (( $# )); do
    case $1 in
      --timeout | --stuck) [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "$1 takes a number of milliseconds" >&2; exit 2; }; limit+=("$1" "$2"); shift 2 ;;
      *) echo "a wait takes --timeout <ms> and --stuck <ms>, not $1" >&2; exit 2 ;;
    esac
  done
}

# ------------------------------------------------------------------------------------------------- commands

case $cmd in
  list) teams ;;
  bolts | bolt | signal | state | plan | rail | card | record) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  events | trace) exec python3 "$here/../lib/record.py" "${args[@]}" ;;
  page) exec python3 "$here/../lib/page.py" "${args[@]}" ;;
  sites) exec python3 "$here/../lib/sites.py" "${args[@]:1}" ;;
  ops) exec python3 "$here/../lib/ops.py" "${args[@]:1}" ;;
  board | _views | _board) exec python3 "$here/../lib/board.py" "${args[@]}" ;;
  tell) py tell "${2:?usage: crew tell <agent> \"<text>\"}" "${3:?usage: crew tell <agent> \"<text>\"}" ;;
  status)
    if [[ -n ${2:-} ]]; then one _status "$2" ${forced[@]+"${forced[@]}"}
    else first=1; for t in $(teams); do [[ $first == 1 ]] || echo; first=0; bash "$0" status "$t" || true; done; fi ;;
  up | close | rebuild | down) need_team "${2:-}"; one _team "$cmd" "$2" ${forced[@]+"${forced[@]}"} ;;
  restart | resume) need_team "${2:-}"; one _team "$cmd" "$2" "${@:3}" ${forced[@]+"${forced[@]}"} ${greet[@]+"${greet[@]}"} ;;
  clear) need_team "${2:-}"; one _team clear "$2" "${3:?usage: crew clear <team> conductor|ops}" ${forced[@]+"${forced[@]}"} ;;
  unit | chore)  # a chore's stages are code, verify and merge, with no construct (plan.11)
    kind=$cmd
    if [[ $kind == chore ]]; then stages="code verify merge"; as=(--chore); else stages="construct code verify settle merge"; as=(); fi
    case ${2:-} in
      free)
        [[ -n ${3:-} && ( $# == 3 || ( $# == 5 && $4 == --team ) ) ]] || { echo "usage: crew $kind free <$kind> [--team <team>]" >&2; exit 2; }
        one _unit-free "$3" ${5:+--team "$5"} ${forced[@]+"${forced[@]}"} ;;
      wait)
        unit=${3:?usage: crew $kind wait <$kind> [--timeout <ms>] [--stuck <ms>]}; limits "${@:4}"
        one _unit-wait "$unit" ${limit[@]+"${limit[@]}"} ;;
      run)
        unit=${3:?usage: crew $kind run <$kind> ${stages// /|} [\"<words>\"]}
        stage=${4:?usage: crew $kind run <$kind> ${stages// /|} [\"<words>\"]}
        [[ " $stages " == *" $stage "* ]] || { echo "no stage '$stage' for a $kind; stages: $stages" >&2; exit 2; }
        one _unit-run "$unit" "$stage" ${as[@]+"${as[@]}"} ${forced[@]+"${forced[@]}"} -- "${5:-}" ;;
      *) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
    esac ;;
  fix)
    need_team "${2:-}"
    name=${3:?usage: crew fix <team> <name> \"<what is wrong>\" | --merge | --drop | --wait}; words=${4:?usage: crew fix <team> <name> \"<what is wrong>\" | --merge | --drop | --wait}
    case $words in
      --wait) limits "${@:5}"; one _fix-run "$2" "$name" wait ${limit[@]+"${limit[@]}"} ;;
      --merge) one _fix-run "$2" "$name" merge ${forced[@]+"${forced[@]}"} ;;
      --drop) one _fix-run "$2" "$name" drop ${forced[@]+"${forced[@]}"} ;;
      *) one _fix-run "$2" "$name" start ${forced[@]+"${forced[@]}"} -- "$words" ;;
    esac ;;
  needs)  # run by a stage's agent: the team and slot are its own name's
    words=${2:-}
    [[ -n ${words//[[:space:]]/} ]] || { echo "usage: crew needs \"<what you tried and what you need>\"" >&2; exit 2; }
    one _needs -- "$words" ;;
  _tidy)  # crew _tidy <team> [--landed <bolt> --outcome <words>]: free the slots whose work has merged or been dropped,
    # and remove the worktrees whose work is over (a plan write that ends work asks for it on the team's host); after a
    # landing, close the bolt's landing card there with the words
    need_team "${2:-}"; one _tidy "${args[@]:1}" ${forced[@]+"${forced[@]}"} ;;
  _construct-again)  # crew _construct-again <team> <unit> --by <what amended it> [--force]: an amendment's construct,
    # handed to the team's host by the plan write that made it, which answers once the host has it (plan.15, code.9)
    need_team "${2:-}"; one _construct-again "${@:2}" ${forced[@]+"${forced[@]}"} ;;
  _preview)  # crew _preview <label> <bolt> <head>: a landing card's preview of the bolt's head, asked of sluice and
    # waited on to its end in a process of its own on the team's host, which the card's raise hands it to (code.9)
    exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  main)
    need_label "${3:-}"
    case ${2:-} in up | down | status) one _main "$2" "$3" ${forced[@]+"${forced[@]}"} ;; *) echo "usage: crew main up|down|status <label>" >&2; exit 2 ;; esac ;;
  review)  # crew review <label> [--wait [--timeout <ms>]]: the partition's reviewer, fresh for one batch, in a review tab
    # of the main level's workspace beside the planner; --wait waits for its summary, records the batch and closes its tab
    need_label "${2:-}"
    if [[ ${3:-} == --wait ]]; then
      limit=(); [[ ${4:-} == --timeout ]] && { [[ ${5:-} =~ ^[0-9]+$ ]] || { echo "--timeout takes a number of milliseconds" >&2; exit 2; }; limit=(--timeout "$5"); }
      one _review "$2" --wait ${limit[@]+"${limit[@]}"}
    fi
    [[ -z ${3:-} ]] || { echo "usage: crew review <label> [--wait [--timeout <ms>]]" >&2; exit 2; }
    one _review "$2" ;;
  _dispatch) one _dispatch "${2:?usage: crew _dispatch up|down|status <label>}" "${3:?usage: crew _dispatch up|down|status <label>}" ;;
  revive) one _revive ;;
  operator)
    [[ ${2:-} == up ]] || { echo "usage: crew operator up <label>" >&2; exit 2; }
    one _operator "${3:?usage: crew operator up <label>}" ;;
  _rail)  # crew _rail <label>: the rail tab's list, printed again every 30 seconds and as soon as the run record gains
    # an entry; a burst of entries refreshes it once. Once the follow ends, it refreshes on the clock alone. Each refresh
    # is one read (crew _views), which prints the rail as crew rail does, ending the card sessions crew rail ends, and
    # writes the board for the board tab.
    label=${2:?usage: crew _rail <label>}
    exec 3< <(bash "$0" events --follow --label "$label" 2>/dev/null)
    while :; do
      out=$(bash "$0" _views "$label" 2>&1 || true)
      printf '\033[H\033[2J%s\n' "$out"
      if read -r -t 30 -u 3 _; then
        while read -r -t 2 -u 3 _; do :; done
      elif (( $? <= 128 )); then
        sleep 30
      fi
    done ;;
  *) usage; exit 2 ;;
esac
