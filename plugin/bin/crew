#!/usr/bin/env bash
# crew: run bolt teams of agents in herdr, and each partition's main level. Teams and partitions are data in
# ~/.config/crew/teams.json, version 2 or 3. Version 3 names each team's flume: the Flume stream its work runs in on
# its host, or false where it names none; version 2 names none. A team runs no conductor, ops or slot, its work running
# in Flume places on its host: up, rebuild, restart, resume, clear, down and revive of it, and unit run, unit wait,
# unit free, chore run, chore wait, chore free and fix --wait on its work, are refused at once, naming where its work
# runs and crew bolts; close still closes what an older crew left standing.
#
# A team holds as many bolts as it is given, a give never refused for the bolts it holds; a bolt that is proven, every
# unit and chore merged and sluice green at its head, waits to land:
#   crew list                          the teams that are defined
#   crew status  [team]                the conductor and ops (state, context use, compactions, age), and each unit
#                                      slot with the unit or fix it holds and its stage, a unit carried onto its
#                                      bolt inside another's merge named so, with its merge owed. It first frees each slot
#                                      whose work has merged, been dropped or left the team's bolt, once its agent
#                                      is not working, and removes, let go by sluice and then through the kit's
#                                      wt remove, the worktrees in the team's kit checkout whose work is over, naming
#                                      one kept for uncommitted changes, sluice's let-go or a remove hook
#   crew up      <team>                open the team's workspace and start its conductor and ops, each greeted: ops
#                                      told who it is, what its team holds and to wait to be told; the conductor told
#                                      to carry on with its bolt, its greeting (also on rebuild, restart and revive)
#                                      opening with the units of its bolt that wait amended, for it to start their
#                                      construct. A greeting is read back from the agent's transcript and sent once
#                                      more when not taken. A pane herdr lists with no terminal, its folder gone
#                                      when herdr started, is closed and opened again in the team's workspace, said
#                                      (also on restart, resume, revive and a stage's start); one an agent holds is
#                                      never touched
#   crew rebuild <team>                end everything the team has, close its panes, and stand it up fresh,
#                                      keeping only the slots of work still in flight on its bolt
#   crew close   <team>                end everything the team has and close its panes; nothing is started
#   crew restart <team> [role...] [--no-greet]
#                                      end the conductor's or ops' session and start a fresh one in the same pane,
#                                      greeted; --no-greet leaves the greeting to the caller, as a bolt's give does
#   crew resume  <team> [role...]      bring back the conductor or ops when not up, with its last conversation, or
#                                      fresh and greeted when it has none; a conductor brought back with its
#                                      conversation is sent, as crew's notice, the units of its bolt that wait amended
#   crew clear   <team> <role>         /clear the conductor or ops and give it its name back
#   crew down    <team>                end every session the team has; the panes stay
#   crew unit free <unit> [--team <team>]
#                                      free a slot still holding a unit no longer in the team's bolt now, rather
#                                      than at the read after its agent settles: end its agent, and remove the
#                                      worktrees whose work is over; refused while its worktree has uncommitted
#                                      changes
#   crew unit run <unit> construct|code|verify|settle|merge ["<words>"]
#                                      start the unit's stage in its slot, a fresh agent at that stage's effort:
#                                      construct writes its OpenSpec change, once each unit it comes after has
#                                      committed its own, its new place taking their work, made ready through the
#                                      kit's .config/sluice.toml (its toolchain, then its runner's setup); code
#                                      builds it as soon as it is committed, its prompt naming an overlap of
#                                      Touches; verify checks it once, naming the paths it changed and did not
#                                      declare, its report marking each finding fix or leave; code run again
#                                      with the report's path is its one round of fixes; settle takes what reached
#                                      a verified unit; merge archives its change and submits it to the bolt
#                                      through sluice, wt submit, once its verify has delivered its report, refused
#                                      naming the report it lacks, once each unit it comes after has merged and
#                                      while its branch holds no other unit's change open that the bolt does not
#                                      hold archived, its place made again from the bolt when it was carried there
#                                      and its place is gone, delivered once the bolt holds the change archived. Construct run again on a
#                                      planned unit marks it amended: code waits
#                                      until that construct has committed. An amendment to a unit's intent runs
#                                      its construct itself, and anyone may start construct on a unit that waits
#                                      amended. Refused while the team is down. The stage begins only once its
#                                      agent's transcript shows its prompt, sent once more when it does not; else
#                                      it never started, with nothing left typed, and the command fails saying so
#   crew chore run <chore> code|verify|merge ["<words>"]
#                                      start a chore's stage in its slot, a fresh agent at that stage's effort, in
#                                      places/chore-<chore> on chore/<chore> from the bolt: code does the chore's words,
#                                      each commit carrying its Chore: trailer; verify checks the commits against them;
#                                      merge merges it into the bolt as a unit's merge does. Code starts once what it
#                                      comes after has something committed to build on, its place taking their heads;
#                                      verify needs a commit of its own; merge needs its verify delivered once, the
#                                      trailer on every commit of its own, and what it comes after merged. A chore has no
#                                      construct and no review; a unit after a chore is constructed once its code has
#                                      delivered
#   crew chore wait|free <chore> ...   as a unit's wait and free
#   crew unit wait <unit> [--timeout <ms>] [--stuck <ms>]
#                                      first forecast conflicts with git merge-tree, telling each later unit once,
#                                      ordering a later unit after an earlier one whose work its settle took, and
#                                      lifting an order of crew's whose settle found nothing to change, saying so;
#                                      rebase dependents whose unit merged, and count the partition's changes due for
#                                      a batch; then wait for the unit's stage to end at what it delivers (construct's
#                                      change, code's ticked tasks, verify's report, settle's commit, merge's commit
#                                      on the bolt, a unit's change archived in it), or at its agent saying what it needs; the stage's end is
#                                      recorded. It returns sooner when
#                                      the agent has been quiet past --stuck (15 minutes) with nothing of its own
#                                      running, or is gone, or a verify's agent has ended its turn with nothing of
#                                      its own running and no report saved, which has not ended, said then and never
#                                      stuck, or the timeout (an hour) passes, or the Claude session that started
#                                      the wait ends, recording nothing, and says which
#                                      first saying, in sluice's words, each conflict or failed check sluice's
#                                      overview shows for a submission from the stage's place
#   crew fix     <team> <name> "<what is wrong>" [--bolt <bolt>]
#                                      a fix on the team's bolt: fix/<bolt>/<name> at places/fix-<bolt>--<name>,
#                                      built by a fresh code agent; a name already in use on the bolt is refused.
#                                      While the team holds two bolts a new fix names its bolt with --bolt, and
#                                      each form below takes --bolt too; a fix in flight is found by its name.
#                                      A place that could not be made ready refuses no fix: its agent starts there,
#                                      told the step that failed, since a fix is how a bolt is repaired. Its prompt,
#                                      and its merge's, is taken or sent again as a unit stage's is. On a bolt given
#                                      through Flume, the planner's or main-level ops's: a launch of a Flume fix place
#                                      <bolt>--<name> on the bolt, appended to requests.rec for the runner on its
#                                      host, which Flume builds and submits to the bolt itself; --drop drops its
#                                      launch, a merged one refused, and --merge and --wait are refused, naming
#                                      crew bolts, which shows its stage. A fix in flight holds the bolt's landing
#   crew fix     <team> <name> --merge [--bolt <bolt>]
#                                      merge the fix into the bolt: a merge stage, its submission to sluice as a
#                                      unit's is
#   crew fix     <team> <name> --drop [--force] [--bolt <bolt>]
#                                      end a fix not wanted: its slot freed, its agent ended (a working one only with
#                                      --force), its place and branch removed as a dropped unit's, its branch kept and
#                                      named when git cherry finds commits of its own beyond the bolt; a merged fix is
#                                      refused
#   crew fix     <team> <name> --wait [--timeout <ms>] [--stuck <ms>] [--bolt <bolt>]
#                                      wait for the fix's stage to end: its commits, or its merge on the bolt
#   crew answer  <work> "<words>" [--label L]
#                                      answer the Flume place of a team's work that stopped short asking, or
#                                      waits on its caller: the retry of that stage carrying the words, appended to
#                                      requests.rec for the runner on its host, or of its submission where that waits
#                                      unheld; refused, naming the place's stage, when it neither stopped short nor
#                                      waits on its caller. <work> is the unit's or chore's name, or the fix's place
#                                      (<bolt>--<name>)
#   crew needs   "<what you need>"     run by a stage's agent that can't finish without
#                                      something only someone else can give: its stage ends short, the conductor is
#                                      given the words, by its wait or by a tell, and crew ends the agent's session once
#                                      its turn ends, or half a minute on if it works on, so the slot's next start runs
#                                      a fresh agent with no --force; a unit's merge is refused, once in the stage and
#                                      naming them, while its branch holds archives it can make itself, open changes no
#                                      unit has, every task ticked, that its archive builds on
#
# The plan, the moves and the signals crew records, on the flywheel's branch <label>/main of the partition's state
# repository, with requests.rec, crew's requests of each host's runner for a team's work, appended in the
# commit of the plan write that occasions them; each runner answers on <label>/runner/<host> of the same repository,
# which crew fetches with <label>/main and never writes; a meeting's signals stay in the partition's first blueprints
# repo:
#   crew state init <label>            create the flywheel's branch, adopting plan/<label> and the moves it had
#   crew bolts [<bolt>] [--label L] [--json]
#                                      every bolt, unit and chore of the plans, each one's stage read from its kit,
#                                      or, in a bolt given through Flume, from its host's runner's records of Flume's
#                                      status of its place, a host whose runner can't be read named and its work
#                                      unknown; each bolt's head line saying its team's stream, in Flume stream <s>;
#                                      each held bolt's verification, sluice's verdict on
#                                      its last landing, and each merge and landing standing in sluice's queue with
#                                      its number and state on its line, a queue that can't be read said once on the
#                                      bolt's head line
#   crew bolt  new|give|order|drop|land ...
#                                      give has sluice make bolt/<bolt> on GitHub from main (sluice branch create, on the
#                                      team's host), with no worktree, before the plan write; refused, nothing changed,
#                                      in a kit whose .config/sluice.toml on origin/main names no checks or no remote
#                                      for its bolt branches, on a host whose sluice is older than 0.20.0, in sluice's
#                                      words when it makes none; a branch
#                                      already on GitHub at main's tip with no commit of its own, as a give that
#                                      failed after sluice made it leaves it, is taken and the give goes on. A give is
#                                      never refused for the bolts the team holds, but while its host is held, the
#                                      team names no stream, or no runner answers there (no
#                                      <label>/runner/<host>); it marks the bolt Path: flume, appends a launch to
#                                      requests.rec for each unit and chore, a dependent's naming the launches of its
#                                      After work, which the runner holds it for until that work has landed on the
#                                      bolt, and starts no agent. Plan writes reach those places: an add, an
#                                      amendment, a drop and an order of bolts are launches, retries, drops and
#                                      priorities; a move out, a split or an After change of launched work is
#                                      refused, naming drop and add
#                                      land and drop have sluice delete it (sluice branch delete) once its worktrees
#                                      are gone, a refusal named in sluice's words; a dropped bolt's is kept and named
#                                      while main lacks its tip, and deleted once main holds it. A bolt made before
#                                      gives went through sluice stays local until it lands
#   crew bolt  submit <bolt>... [--excerpt "<the user's words>"] [--label L]
#                                      main-level ops's landing of one kit's bolts, in the order the user's landings
#                                      card gives: each bolt's branch submitted to its kit's main through sluice from a
#                                      short-lived worktree on its team's host, queued behind the one before on one host,
#                                      once it ended on another, recorded queued with sluice's number as soon as sluice
#                                      has it; each waited on in order and closed as it lands, its outcome recorded and
#                                      a landed bolt closed by the first act of crew's that reads it once sluice's record
#                                      has it out, on its team's host: this command's end, the waiter it leaves there,
#                                      the team's next read or crew bolt land; a close crew refuses recorded and said
#                                      on the bolt's head line until a later read lifts it; one
#                                      that did not land recorded at its head while the rest go on: one refused for its
#                                      own content, a conflict or a check that ran and failed, held on its row; one
#                                      sluice or its host stopped keeping its box and the user's word, and submitted
#                                      again once that is cleared; a landing still standing in sluice at the bolt's
#                                      head, as after ops's session ended, waited on again with nothing submitted,
#                                      one at another head said; the command exiting non-zero naming each; sluice
#                                      pushes to GitHub, and the landing pushes nothing and levels no host. In a kit
#                                      whose main takes pull requests, it
#                                      readies each bolt's draft pull request first, and a landing that does not land
#                                      leaves it a draft, as a fix's start or a merge into the bolt keeps it, until the
#                                      next submit readies it; with --excerpt, on the user's words in ops's pane,
#                                      submitted only once crew reads them in ops's own transcript as the user's, no
#                                      words in the run record
#   crew bolt  leave <bolt>... --excerpt "<the user's words>" [--label L]
#                                      main-level ops's record of the user's words in its pane stopping the bolts'
#                                      landing, read in ops's own transcript as the user's as submit's are, refused
#                                      as it refuses, no words in the run record; the kit's landings card raised,
#                                      showing each unticked as left. A bolt the user left, so or by clearing it on
#                                      their send, is forecast against main as any, its row keeping its box and saying
#                                      whether it would take main first, and no take-main fix is told for it until they
#                                      tick it, ops lands it on their words or its head moves
#   crew unit  add|split|amend|order|after|move|drop ...
#   crew chore add|order|after|move|drop ...
#                                      planned maintenance that changes nothing a spec says, written as a unit is, by the
#                                      same hands, and built in its bolt by code, verify and merge
#   crew plan  propose|proposed|agree|approve|answer|drop ...
#                                      the planner's proposals: a change to the plan, applied once the user approves it,
#                                      crew raising its Pending You card at propose; approve --clear leaves out the new
#                                      units the user cleared; answer records the card's answers and applies the
#                                      approval once it holds them all
#   crew rail  [--label L]             what waits on the user: proposals, review batches and bolts to land,
#                                      each with when it began to wait, the command that answers it and its Pending
#                                      You card; then the questions the agents asked; then the decision records
#                                      waiting on you, each the design agent's open card for one; then any open card
#                                      whose row is gone. It sweeps the cards on this host under its sign-in: closes
#                                      a card whose row is gone, withdraws a question whose asker has ended, and
#                                      posts again a row's card Pending You no longer finds and a row's card that
#                                      has none, through its kind's raise, and on its owner's host every row's card
#                                      posted from another host or lost to its owner, and a still-proposed decision
#                                      record's, built again from the record on the kit's main, saying the older
#                                      copy is dead, one raised with alternatives named with the crew record that
#                                      raises it again; tries again the reading of a batch's, a long proposal's or a
#                                      kit's landings card that stands without it, ten minutes on, a landings card's
#                                      by raising it again, which tries each row's on its team's host as crew card
#                                      session land/<bolt> does, changing the card to carry its links; and it ends,
#                                      on every host of the partition, each card session crew
#                                      started whose card is closed or whose row is gone. It says what each did, and
#                                      each host it could not check
#   crew board [--label L] [--json]    the flow, one partition at a time, as four lanes stacked: Inception (signals
#                                      no move has taken, explorations), Bolt plan (proposals, planned bolts, the
#                                      queue), Construction (each held bolt as a ledger of its units, fixes, slots and
#                                      dev servers) and Operation (bolts landed this week, each environment's deploys
#                                      and the operations waiting); each rail row a marker on its object, what needs
#                                      attention at the foot; it answers nothing
#   crew card  session|end <key> [<unit>] [--label L]
#                                      the plannotator session on what a rail row's card asks the user to read, which
#                                      crew starts with a batch's card, a landing card and a long proposal's: session
#                                      prints its link (the running one's, else one started on this host with no
#                                      browser), a batch card's one on the whole batch, on the main level's host, a
#                                      bolt's (land/<bolt>) one on what it brings to main, on the host of the team
#                                      holding it while it is a row of its kit's landings card, the kit's card changed to
#                                      carry a new link, or one it stands without, while it waits on the user, land/<kit>
#                                      having none of its own, as a batch's and a long proposal's change the planner's,
#                                      recording the start, a proposal's only for one of more than fifteen new units, and an old
#                                      batch card's (batch/<n>-<k>) one per <unit> on that unit's team's host; end
#                                      ends it, as the card's close does, and a bolt's reading as its row's end does,
#                                      which no close of a card of the bolt's own does. Nothing of crew's waits on a
#                                      session or a card: crew card wait is refused at once, naming crew card read
#                                      <key>, which gives what the user decided
#   crew card  sweep --label L         the rail's, run on each host of the partition with what it judged on standard
#                                      input: ends the sessions there whose card is closed or whose row is gone, tells
#                                      the owner of each reading there the user sent and nobody read, once, to run crew
#                                      card read <key>, and records a batch's reading approved with no notes read; not
#                                      for hand use
#   crew card  read <key> [--label L] [--json]
#                                      where the asker's card stands: its status, whose turn, the user's answer and words,
#                                      and what the user sent from its reading: a batch's card and reading together
#                                      (batch/<n>), the planner's, its note and every annotation, the card closed and
#                                      the batch recorded read; a bolt's reading (land/<bolt>), its conductor's, its
#                                      annotations as notes on its row and its approval as landing nothing, the card
#                                      left and the reading set aside; a long proposal's reading's decision;
#                                      an approval the user declined is closed with their words; for a kit's landings
#                                      card (land/<kit>), the bolts the user ticked in its order and the crew bolt
#                                      submit that lands them, after those an earlier send still lands at their head
#                                      now; what an earlier send still lands, with or without a card open, naming a
#                                      bolt it can't tell of; a sent card is raised first, so a ticked bolt that was
#                                      left and conflicts with main takes main first, its conductor told the fix, and
#                                      the submit leaves it out
#   crew card  answer batch/<n> --excerpt "<words>" [--label L]
#                                      the planner's or the operator's: the user's answer to a batch in their own words
#                                      in its pane, recorded once crew reads the words in that agent's own session
#                                      transcript as the user's, never an agent's, a tool's or crew's own, with no
#                                      words in the run record; closes the batch's card held on this host with the
#                                      words, or names the host whose rail closes it, and tells the planner the words when the operator ran it; refused for a batch
#                                      answered already or waiting on nothing
#   crew card  preview <key> <thing> [--done] [--label L]
#                                      the card's owner's, main-level ops's for a kit's landings card (land/<kit>) and
#                                      the planner's for a batch's (batch/<n>), on the user's words on the card: brings
#                                      up a thing it carries that must run, a landings row's bolt at its head or a batch
#                                      line's <unit>/<name> at the branch and revision its stage recorded, through sluice
#                                      preview on the host of the team holding its work, and changes the card in place
#                                      to list its addresses while it is up; --done puts it away; refused for any other
#                                      caller, key or thing, naming those the card carries
#   crew signal <slug> "<what it asserts>" --excerpt "<the words, verbatim>" ...
#                                      record a finding as a signal, quoting the words that show it, which are
#                                      checked against the agent's own Claude transcript
#   crew signal show <id>              a signal, where its excerpt came from, and its move
#   crew signal move <id> attach|challenge|new-territory|answered|drop ...
#                                      curation's move for a signal
#                                      (a signal's <id>, here, in --signal and in signals/<id>, is its full id,
#                                      <capture>/<NN>-<slug>, or its short one, <capture>/<NN>)
#   crew signal land <capture-dir> --label L
#                                      a program's capture, a deployer's or another adapter's, with its signals,
#                                      landed on the flywheel's branch from the host that banked its raw record
#   (crew bolt|unit|chore|plan|signal --help says more)
#
# Each partition's main level, and its console in each operator session:
#   crew main     up|down|status <label>  the design agent, the planner, ops and the operator in the <label> workspace
#                                      of the session each runs in, the main level's unless its partition's roles name
#                                      another, and a dispatcher on each host the partition's teams run on;
#                                      each agent up starts is greeted to read where the partition stands and carry on;
#                                      a pane herdr brought back dead is closed and opened again in its workspace, said
#   crew main     fix <kit> <name> "<the failure's words>" [--team <team>] [--label L]
#                                      main-level ops's or the user's, on reading the kit's main red after a landing:
#                                      a Flume fix place on main, its submission held for the user's send and ops its
#                                      recipient, appended to requests.rec for the runner on the host of the team
#                                      that builds the kit in a stream, --team choosing among several on different
#                                      hosts; refused, naming a bolt of one chore proposed first among the planned as
#                                      the way, where no team builds the kit in a stream or no runner answers on its host
#   crew main     fix <kit> <name> --send [--excerpt "<the user's words>"] [--label L]
#                                      main-level ops's, on the user's send of the kit's landings row, which carries the
#                                      fix once its code has delivered and its submission waits held: the retry of its
#                                      submission, appended once, which the runner makes and sluice lands on main; with
#                                      --excerpt, on the user's words in ops's pane, sent only once crew reads them in
#                                      ops's own transcript as the user's, no words in the run record
#   crew main     fix <kit> <name> --drop [--label L]
#                                      drop a fix of main not wanted: its launch dropped; a landed one is refused
#   crew review   <label> [--wait [--timeout <ms>]]
#                                      the partition's reviewer, started fresh for the batch of changes due, in a
#                                      review tab beside the planner; --wait waits for its summary, records the batch,
#                                      raises its card with its reading session in the planner's name, and closes the
#                                      tab; it ends sooner, recording nothing, when the Claude session that started it
#                                      ends
#   crew record   <kit> <number> --proposed|--accepted|--rejected [--settled-in-pane --excerpt "<words>"] [--alternatives <file>]
#                                      the design agent's, at each turn of a decision record's status once it is on the
#                                      kit's main: the status recorded with its commit; --proposed raises the record's
#                                      card in the design agent's name, or at a new commit changes it, a new card
#                                      following it once the user has answered it, unless --settled-in-pane says the
#                                      user said yes in the pane, in the words --excerpt gives, which crew reads in the
#                                      design agent's transcript as the user's; --alternatives <file> makes it a
#                                      choice, loosen the rules as drafted, accept as ruled or send back, recorded on
#                                      the status with none of the file's words; a card held on a host the main level
#                                      left, or lost to the design agent, is posted again saying the older copy is
#                                      dead; --accepted or --rejected closes it with the commit. A status the file
#                                      does not hold is refused
#   crew console  up|down <label> [flow] [rail] [board]
#                                      the partition's console in this host's operator session <label>, starting no
#                                      agent: a shell tab with crew on its path, and only the tabs named, a flow tab
#                                      following the run record, a rail tab (the rail the host's follower writes above,
#                                      a shell below) and a board tab drawn from the follower's read; the rail tab opens
#                                      of itself too while no host job follows, since it then follows itself. Each tab
#                                      already open is kept, named or not, its command run again where a restart left
#                                      its pane a shell, and one the user closed stays closed unless named; down closes
#                                      them
#   crew _follow  [--once]             the host's follower with no tab, the command swancloud's job runs on each host:
#                                      one read for every partition with an operator session here, fetching once a
#                                      minute and showing this host's writes within seconds, reading only what moved
#                                      and following each kit's queue through sluice's overview watch; due restarts
#                                      handed out once crew's checkout or the teams file moved, the rail's frame, the
#                                      board's and the agents' views written, a frame stale after three minutes; one
#                                      follower to a host, holding its lock, a second waiting for it
#   crew tell     <agent> "<text>"     prompt an agent crew started, wherever it runs, marked with who sent it;
#                                      refused, with nothing typed, while the agent waits on a question in its pane
#   crew tell     --board < word.json  a word from a dock of the board, as its listener pipes it ({label, key, to,
#                                      text}): checked against the agent its item's kind goes to, one line of at most
#                                      1000 characters, and told it as the user's from the board, naming the item;
#                                      prints `sent to <agent>`, and answers no card
#   crew send     <team or partition> "<text>"
#                                      send anything for another team or partition to that partition's operator, its
#                                      one door, wherever it runs: a team by its partition, a partition by its label;
#                                      marked with who sent it and whom it was for, and recorded with its length
#   crew revive                        after a restart, every standing agent of this host whose pane came back with no
#                                      agent in it, or dead, closed and opened again in its layout first, picked up
#                                      from its last conversation and greeted when it is a conductor or an agent
#                                      outside a team, or started fresh and greeted when it has none; a team or main
#                                      level taken down with crew down stays down
#   crew sites    [<label>] [--json]   every host's bolts, units and fixes, with the URL of each running dev server
#
# A host's hold, and crew's updates reaching its agents (teams.19, lib/hold.py says each in full):
#   crew hold     <host>|--all "<why>" [--now]
#                                      crew starts no agent on each host named until crew go, and every standing agent
#                                      up there is told to finish the step it is in and start nothing new; a stage
#                                      already running ends as it would. --now ends every crew agent there at once
#   crew hold     status|wait [<host>|--all] [--timeout <ms>]
#                                      what still works on each held host; wait waits until each is quiet and then
#                                      ends every crew agent there, its panes kept, so herdr can be restarted
#   crew go       <host>|--all         lift the hold: every standing agent brought back with its conversation and
#                                      greeted, or told to carry on, and every one an update made due restarted
#   crew update   [<host>|--all]       every standing agent whose start crew's update, or its brief's, has made due
#                                      restarted on crew as it now is once it is idle, a conductor fresh and every
#                                      other with its conversation; crew's Stop hook does the same at the end of a due
#                                      agent's turn, and the host's follower once crew's checkout moves
#
# Operations on a partition's environments, a deploy being one kind (plan.14), run where the partition's main level
# runs (lib/ops.py says each in full):
#   crew ops offer <env> --label L --to <sha> --from <sha|none> [--notes <file>] [--steps <file>]
#                                      a manual environment's deploy offered as a rail row, its card raised in
#                                      main-level ops's name with the kit's changelog and after-deploy steps
#   crew ops approve <env> --label L --to <sha>
#                                      the user's word for it
#   crew ops word|quiet <env> --label L
#                                      the commit the user's word is for; whether the environment's host is quiet
#   crew ops record <env> --label L --to <sha> --act start|step|end [...]
#                                      a deploy's start, steps and end in the run record as it runs
#   crew ops step <env> --label L --key K --state S [--to <sha>] [--held] [...]
#   crew ops steps <env> --label L --json
#                                      any other operation and its state, on its own or after a deploy
#
# What happened, read from the run record every command that moves work appends on the host it ran on and pushes to
# the partition's branch as it writes it:
#   crew events   [--label L] [--about <object>] [--since <time>] [--follow] [--json]
#                                      the entries on the partition's branch, in time order; no host is asked;
#                                      --follow prints this host's entries at once and another's within the minute
#   crew events   --push [--label L]   push what of this host's run record a refused push left on it
#   crew trace    <object>             one bolt's, unit's or signal's history: what was done, by whom, in which
#                                      session, with which commit, and what it led to
#   crew page     <label> [--out <file>] [--since <time>]
#                                      the partition's page, one HTML file that loads nothing: it opens on the board,
#                                      its four lanes drawn as the flywheel mockup draws them, narrowed to one team
#                                      when chosen, kept across reloads, and its header linking the fleet page and
#                                      each other partition's page in the layout of its own file (../page.html and
#                                      ../<label>/page.html in crew's; index.html and <label>.html beside one written
#                                      as <label>.html; none, said so, when its file and folder are not the
#                                      partition's); one switch away, the lineage: signals,
#                                      agenda items, proposals, units and bolts as columns, a line from each to what
#                                      it led to, and each one's history as crew trace prints it; and the deploys,
#                                      each environment's as a timeline, with the word, steps, checks and outcome of
#                                      each, and the bolts it carried with their proposals; written whole to
#                                      ~/.local/state/crew/<label>/page.html on this host, or --out, and its path
#                                      printed with as of when and which commit it was drawn from
#   crew page     --fleet [--out <file>]
#                                      the fleet page, every partition of the teams file at once from the one read
#                                      crew board makes of them all, under its Claude subscriptions: each account a
#                                      session or a reading names, with its five-hour, seven-day and per-model use as
#                                      the host holding its sign-in published it in
#                                      ~/.local/state/crew/usage/<host>.json, which host read it and how long ago, a
#                                      reading not made marked, and the sessions and partitions on it; then a block to
#                                      each partition: each host it runs on and the herdr sessions its agents run in,
#                                      with each session's Claude account; each kit its teams build, its main's last
#                                      landing and what is queued for it; each team's bolt, its slots at work, holding
#                                      or free, and what its conductor waits on; and what needs attention; each
#                                      partition a link to its page and each team to its dock there (<label>.html
#                                      beside one written as index.html, <label>/page.html beside page.html, none,
#                                      said so, for any other name); written whole to
#                                      ~/.local/state/crew/page.html, beside the partitions' folders, or --out, its
#                                      path printed with each partition's commit, each host that did not answer, each
#                                      published file it could not read, and that no use is published when none is
#
# A team is two herdr workspaces in its session: "<team>", with a "conductor" tab (the conductor and ops) and no
# git tab, and "<team> units", one pane per slot in flight, which exists only while a unit or fix is. A team's panes
# and state live on its host, so a command about a team runs there. Add --force to act on an agent that is working.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
py() { python3 "$here/../lib/crew.py" "$@"; }
teams() { py teams || exit 1; }
this_host() { hostname -s; }
usage() { awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

orig=("$@"); forced=(); greet=(); args=()
for a in "$@"; do case $a in --force) forced=(--force) ;; --no-greet) greet=(--no-greet) ;; *) args+=("$a") ;; esac; done
set -- ${args[@]+"${args[@]}"}
cmd=${1:-}

# ------------------------------------------------------------------------------------------- where a command runs

# Every command is one Python process (code.7): exec'd below, or run by `one`, which runs a command on a team or a main
# level on the host its agents run on. Who asks, and the Claude session behind them, go with a command run on another
# host, so what it records there names them (code.3).
identity() { echo "CREW_AGENT=${CREW_AGENT:-$(id -un)@$(this_host)}"; }
there() {  # there <host's ssh name> <crew on that host> <args...>: run a crew command on another host, never prompting
  local target=$1 remote=$2; shift 2
  ssh -o BatchMode=yes "$target" "$(printf '%q ' env "$(identity)" "CREW_LABEL=${CREW_LABEL:-}" "CREW_SESSION=${CALLER_SESSION:-}" bash "$remote" "$@")"
}
one() {  # one <plan.py entry> <args...>: the command as one Python process. Run on another host than its agents', the
  # process does nothing there but say on its descriptor 3 where they run, how crew runs there and the asker's session,
  # and the command is run there instead.
  local to rc=0
  { to=$(python3 "$here/../lib/plan.py" "$@" 3>&1 >&4 4>&-) || rc=$?; } 4>&1
  [[ -n $to ]] || exit $rc
  eval "$to"
  [[ -z ${REMOTE_CREW_REFUSED:-} ]] || { echo "$REMOTE_CREW_REFUSED" >&2; exit 1; }
  there "$SSH_TARGET" "$REMOTE_CREW" "${orig[@]}"; exit $?
}
need_team() { [[ -n ${1:-} ]] || { echo "which team? teams: $(teams | tr '\n' ' ')" >&2; exit 2; }; }
need_label() { [[ -n ${1:-} ]] || { echo "which partition? partitions: $(py labels | tr '\n' ' ')" >&2; exit 2; }; }

# ------------------------------------------------------------------------------------------------- commands

case $cmd in
  list) teams ;;
  bolts | bolt | unit | chore | signal | state | plan | rail | card | record | answer) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  events | trace) exec python3 "$here/../lib/record.py" "${args[@]}" ;;
  page) exec python3 "$here/../lib/page.py" "${args[@]}" ;;
  sites) exec python3 "$here/../lib/sites.py" "${args[@]:1}" ;;
  ops) exec python3 "$here/../lib/ops.py" "${args[@]:1}" ;;
  board | _views | _board | _rail | _follow) exec python3 "$here/../lib/board.py" "${args[@]}" ;;
  hold | go | update | _hold | _go | _update | _renew) exec python3 "$here/../lib/hold.py" "${args[@]}" ;;
  tell) [[ ${2:-} == --board && $# == 2 ]] && { py tell --board; exit; }
    py tell "${2:?usage: crew tell <agent> \"<text>\"}" "${3:?usage: crew tell <agent> \"<text>\"}" ;;
  send) py send "${2:?usage: crew send <team or partition> \"<text>\"}" "${3:?usage: crew send <team or partition> \"<text>\"}" ;;
  status)
    if [[ -n ${2:-} ]]; then one _status "$2" ${forced[@]+"${forced[@]}"}
    else first=1; for t in $(teams); do [[ $first == 1 ]] || echo; first=0; bash "$0" status "$t" || true; done; fi ;;
  up | close | rebuild | down) need_team "${2:-}"; one _team "$cmd" "$2" ${forced[@]+"${forced[@]}"} ;;
  restart | resume) need_team "${2:-}"; one _team "$cmd" "$2" "${@:3}" ${forced[@]+"${forced[@]}"} ${greet[@]+"${greet[@]}"} ;;
  clear) need_team "${2:-}"; one _team clear "$2" "${3:?usage: crew clear <team> conductor|ops}" ${forced[@]+"${forced[@]}"} ;;
  fix)
    need_team "${2:-}"
    usage='usage: crew fix <team> <name> "<what is wrong>" | --merge | --drop | --wait, each with [--bolt <bolt>]'
    team=$2 name=${3:?$usage} bolt=() rest=()
    set -- "${args[@]:3}"
    while (( $# )); do  # --bolt <bolt> may follow the words or a mode flag (teams.16)
      case $1 in
        --bolt) [[ -n ${2:-} ]] || { echo "--bolt takes the bolt the fix is of" >&2; exit 2; }; bolt=(--bolt "$2"); shift 2 ;;
        *) rest+=("$1"); shift ;;
      esac
    done
    words=${rest[0]:?$usage}
    case $words in
      --wait) one _fix-run "$team" "$name" wait ${bolt[@]+"${bolt[@]}"} ;;
      --merge) one _fix-run "$team" "$name" merge ${forced[@]+"${forced[@]}"} ${bolt[@]+"${bolt[@]}"} ;;
      --drop) one _fix-run "$team" "$name" drop ${forced[@]+"${forced[@]}"} ${bolt[@]+"${bolt[@]}"} ;;
      *) one _fix-run "$team" "$name" start ${forced[@]+"${forced[@]}"} ${bolt[@]+"${bolt[@]}"} -- "$words" ;;
    esac ;;
  _tidy)  # crew _tidy <team> [--landed <bolt> --outcome <words>]: free the slots whose work has merged or been dropped,
    # and remove the worktrees whose work is over (a plan write that ends work asks for it on the team's host); after a
    # landing, have sluice delete the bolt's branch once the landing's place is gone, and close the bolt's landing card
    # there with the words
    need_team "${2:-}"; one _tidy "${args[@]:1}" ${forced[@]+"${forced[@]}"} ;;
  _preview)  # crew _preview <label> <key> <thing> <branch> <revision>: the preview of a thing a card carries, asked
    # of sluice and waited on to its end in a process of its own on the team's host, which crew card preview hands it
    # to (code.9)
    exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  _card-preview | _preview-release)  # crew _card-preview <label> <key> <thing> <team> [--done], on the team's host:
    # a card's thing brought up or put away there, which crew card preview hands it to; crew _preview-release <label>
    # <key>: every preview brought up from a card released on this host, which the card's close hands it to (code.3)
    exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  _made | _batch-card)  # crew _made <label> <unit>... [--card <key>] --json, on the units' team's host: what each
    # unit's stages recorded as made, kept there, which a batch's raise reads; crew _batch-card <label> <n> [--note
    # <words>], on the partition's main machine: batch n's card raised, which a stage's new made line hands there
    exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  _land-row | _land-card)  # crew _land-row <label> <bolt> --json, on the bolt's team's host: its row on its kit's
    # landings card, its reading and preview opened or ended there; crew _land-card <label> <kit> [--note <words>], on
    # the partition's main machine: the kit's landings card raised from each row, which every event that changes a row
    # hands there (Decision 2 of one-landings-card-lands-the-proven-bolts-in-order, code.3)
    exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  _landing-read)  # crew _landing-read <label> <bolt>, on the bolt's team's host: its landing read from sluice's record
    # of its queued submission, its outcome recorded once sluice has it out (plan.21), run by the landing's waiter as it
    # stops and by every crew act that reads the bolt after
    exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  main)
    [[ ${2:-} == fix ]] && exec python3 "$here/../lib/plan.py" "${args[@]}"  # a plan write, on the asking host
    need_label "${3:-}"
    case ${2:-} in up | down | status) one _main "$2" "$3" ${forced[@]+"${forced[@]}"} ;; *) echo "usage: crew main up|down|status <label> | fix <kit> <name> ..." >&2; exit 2 ;; esac ;;
  review)  # crew review <label> [--wait [--timeout <ms>]]: the partition's reviewer, fresh for one batch, in a review tab
    # of the main level's workspace beside the planner; --wait waits for its summary, records the batch and closes its tab
    need_label "${2:-}"
    if [[ ${3:-} == --wait ]]; then
      limit=(); [[ ${4:-} == --timeout ]] && { [[ ${5:-} =~ ^[0-9]+$ ]] || { echo "--timeout takes a number of milliseconds" >&2; exit 2; }; limit=(--timeout "$5"); }
      one _review "$2" --wait ${limit[@]+"${limit[@]}"}
    fi
    [[ -z ${3:-} ]] || { echo "usage: crew review <label> [--wait [--timeout <ms>]]" >&2; exit 2; }
    one _review "$2" ;;
  _dispatch) one _dispatch "${2:?usage: crew _dispatch up|down|status <label>}" "${3:?usage: crew _dispatch up|down|status <label>}" ;;
  revive) one _revive ;;
  console)
    need_label "${3:-}"
    case ${2:-} in up | down) one _console "$2" "$3" "${@:4}" ;; *) echo "usage: crew console up|down <label> [flow] [rail] [board]" >&2; exit 2 ;; esac ;;
  operator)  # the console's name before record 0035, which a host's timer may still run: it opens the console
    [[ ${2:-} == up ]] || { echo "usage: crew console up|down <label> [flow] [rail] [board] (crew operator up is crew console up now)" >&2; exit 2; }
    echo "crew operator up is crew console up now; the operator is <label>-operator, at the main level" >&2
    need_label "${3:-}"
    one _console up "$3" ;;
  *) usage; exit 2 ;;
esac
