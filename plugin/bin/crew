#!/usr/bin/env bash
# crew: run teams of agents in herdr. Teams are data in ~/.config/crew/teams.json.
#
#   crew list                          the teams that are defined
#   crew status  [team]                each agent's state, context use, compactions, age, and the change it holds
#   crew up      <team>                open the team's workspace and start its standing roles
#   crew rebuild <team>                end everything the team has, close its old panes, and stand it up fresh
#   crew close   <team>                end everything the team has and close its panes; nothing is started
#   crew restart <team> [role...]      end the session and start a fresh one in the same pane (standing roles by default)
#   crew resume  <team> [role...]      bring back roles that are not up, each with its last conversation
#   crew clear   <team> <role>         /clear the agent and give it its name back
#   crew opsx    <team> <role> "/opsx:…" clear the agent, then send it the OpenSpec command: every one starts fresh.
#                                      The explorer is started for it when it is not up
#   crew assign  <team> <coder-n|verifier|explorer> <change|fix/name|lookup>
#                                      a coder: make the change's worktree (or the fix's) and start fresh inside it;
#                                      the verifier: start fresh inside the worktree a coder built a change in,
#                                      named by the change or by the fix whose worktree it was built in;
#                                      the explorer: start fresh in the main checkout, for one piece of work
#   crew release <team> <coder-n|verifier|explorer>
#                                      end it, close its pane, and free it; a coder's merged worktree is removed
#   crew down    <team>                end every role's session; the panes stay
#
# A team is one herdr workspace with four tabs: "conductor" (the conductor and ops), "design" (fable), "git"
# (gitgui in each of the team's repositories), and "build", which exists only while a coder, the verifier or the
# explorer holds work. Add --force to act on an
# agent that is working. A fresh session gets its whole brief as its system prompt: the work list and the commits
# are the state.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
local_team() { [[ $(hostname -s) == "$MACHINE" ]]; }
on_machine() { if local_team; then "$@"; else ssh -o BatchMode=yes "$SSH_TARGET" "$(printf '%q ' "$@")"; fi; }
h() { on_machine herdr --session "$SESSION" "$@"; }
in_kit() { on_machine env -C "$KIT" "$@"; }
teams() { python3 "$here/../lib/crew.py" teams; }

force=0; args=()
for a in "$@"; do [[ $a == --force ]] && force=1 || args+=("$a"); done
set -- "${args[@]:-}"
cmd=${1:-}; team=${2:-}

load() {
  [[ -n $team ]] || { echo "which team? teams: $(teams | tr '\n' ' ')" >&2; exit 2; }
  eval "$(python3 "$here/../lib/crew.py" env "$team")"
  state=$STATE; panes=$state/panes; held=$state/assignments; layout=$state/layout
  standing=(conductor ops fable); pool=(); for n in $(seq "$CODERS"); do pool+=("coder-$n"); done; pool+=(verifier explorer)
  roles=("${standing[@]}" "${pool[@]}")
  mkdir -p "$state" "${REPORTS/#\~/$HOME}"; touch "$panes" "$held" "$layout"
}
name_of() { echo "$TEAM-$1"; }
get() { awk -v k="$2" '$1==k{print $2}' "$1"; }
put() { { grep -v "^$2 " "$1" || true; echo "$2 $3"; } > "$1.new"; mv "$1.new" "$1"; }
drop() { { grep -v "^$2 " "$1" || true; } > "$1.new"; mv "$1.new" "$1"; }
pane_of() { get "$panes" "$1"; }
change_of() { get "$held" "$1"; }
path_of() { awk -v r="$1" '$1==r{print $3}' "$held"; }
in_pool() { [[ $1 == coder-* || $1 == verifier || $1 == explorer ]]; }
pane_live() { [[ -n ${1:-} ]] && h pane get "$1" >/dev/null 2>&1; }
tab_live() { [[ -n ${1:-} ]] && h tab get "$1" >/dev/null 2>&1; }
agent_status() { [[ -n ${1:-} ]] || return 0; h agent get "$1" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true; }
known_role() { local r; for r in "${roles[@]}"; do [[ $r == "$1" ]] && return 0; done; echo "no role '$1' on $TEAM. roles: ${roles[*]}" >&2; exit 2; }
split() { h pane split "$1" --direction "$2" --cwd "$3" --no-focus | jq -r '.result.pane.pane_id'; }

give_name() {  # herdr drops an agent's name whenever its session changes
  local pane=$1 name=$2
  for _ in $(seq 60); do h agent rename "$pane" "$name" >/dev/null 2>&1 && return 0; sleep 1; done
  echo "$name did not come up in $pane; look at that pane." >&2; return 1
}

stop() {
  local role=$1 pane st; pane=$(pane_of "$role"); pane_live "$pane" || return 0
  st=$(agent_status "$pane"); [[ -z $st ]] && return 0
  if [[ $st == working && $force == 0 ]]; then echo "$(name_of "$role") is working; add --force to end it anyway." >&2; return 1; fi
  h agent prompt "$pane" "/exit" >/dev/null 2>&1 || h pane send-keys "$pane" ctrl+c ctrl+c >/dev/null 2>&1 || true
  for _ in $(seq 30); do [[ -z $(agent_status "$pane") ]] && return 0; sleep 1; done
  h pane send-keys "$pane" ctrl+c ctrl+c >/dev/null 2>&1 || true; sleep 2
  # Still running means anything started next would be typed into it as a message. Say so and leave it be.
  [[ -z $(agent_status "$pane") ]] || { echo "$(name_of "$role") did not exit (busy or waiting on the user); it was left running" >&2; return 1; }
}

start() {  # start <role> [resume]
  local role=$1 pane name; pane=$(pane_of "$role"); name=$(name_of "$role")
  if in_pool "$role" && [[ -z $(change_of "$role") ]]; then return 0; fi
  [[ -z $(agent_status "$pane") ]] || { echo "$name is still running; not starting another over it" >&2; return 1; }
  # A Claude that died badly leaves the pane reporting mouse movement, which types escape codes into the shell
  # and into whatever is run next. Clear the line and switch the reporting off first.
  h pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || true
  h pane run "$pane" "printf '\\033[?1000l\\033[?1002l\\033[?1003l\\033[?1006l\\033[?1015l\\033[?2004l'; clear" >/dev/null 2>&1 || true
  sleep 1
  h pane run "$pane" "bash $CREW_HOME/plugin/bin/crew-role $team $role ${2:-}" >/dev/null
  give_name "$pane" "$name" || return 1
  # Claude asks whether a folder it has not seen is trusted. A pool role's folder is a worktree crew made from the
  # team's own repository, which is trusted on main, so that one question is answered for it. Nothing else is.
  if in_pool "$role"; then
    for _ in $(seq 15); do
      sleep 2
      if h pane read "$pane" --source visible --lines 30 2>/dev/null | command grep -q "Yes, I trust this folder"; then
        h agent send-keys "$pane" down enter >/dev/null 2>&1 || true; sleep 3; break
      fi
      [[ $(agent_status "$pane") == idle ]] && break
    done
  fi
  if [[ -n ${2:-} ]]; then echo "$name resumed in $pane"; else echo "$name started in $pane"; fi
}

ensure_standing() {  # the workspace, and the three tabs that always exist
  local ws w c o f g d tab
  c=$(pane_of conductor)
  if ! pane_live "$c"; then
    ws=$(h workspace create --cwd "$DESIGN" --label "$TEAM" --no-focus)
    w=$(jq -r '.result.workspace.workspace_id' <<<"$ws"); c=$(jq -r '.result.root_pane.pane_id' <<<"$ws")
    h tab rename "$(jq -r '.result.tab.tab_id' <<<"$ws")" conductor >/dev/null
    put "$layout" workspace "$w"; put "$panes" conductor "$c"
  fi
  w=$(get "$layout" workspace)
  o=$(pane_of ops); pane_live "$o" || { o=$(split "$c" right "$KIT"); put "$panes" ops "$o"; }
  f=$(pane_of fable)
  if ! pane_live "$f"; then
    tab=$(h tab create --workspace "$w" --cwd "$DESIGN" --label design --no-focus)
    f=$(jq -r '.result.root_pane.pane_id' <<<"$tab"); put "$panes" fable "$f"
  fi
  # gitgui, one pane per repository, for the user to watch the work land. No agent runs here.
  g=$(pane_of git-kit)
  if ! pane_live "$g"; then
    tab=$(h tab create --workspace "$w" --cwd "$KIT" --label git --no-focus)
    g=$(jq -r '.result.root_pane.pane_id' <<<"$tab"); put "$panes" git-kit "$g"; h pane run "$g" gitgui >/dev/null
  fi
  d=$(pane_of git-design)
  pane_live "$d" || { d=$(split "$g" right "$DESIGN"); put "$panes" git-design "$d"; h pane run "$d" gitgui >/dev/null; }
}

ensure_pool_pane() {  # the build tab exists only while someone holds a change, and fills as tiles
  local role=$1 path=$2 p tab q r newest= open=0 w; p=$(pane_of "$role"); pane_live "$p" && return 0
  # The panes file lists roles in the order their panes opened, so the last live pool pane in it is the newest.
  # A new pane halves the newest: to its right when an odd number are open, below it when an even number are.
  for r in $(awk '{print $1}' "$panes"); do
    q=$(pane_of "$r"); if in_pool "$r" && pane_live "$q"; then newest=$q; open=$((open + 1)); fi
  done
  if [[ -n $newest ]]; then
    if (( open % 2 )); then p=$(split "$newest" right "$path"); else p=$(split "$newest" down "$path"); fi
  else
    w=$(get "$layout" workspace)
    tab=$(h tab create --workspace "$w" --cwd "$path" --label build --no-focus); p=$(jq -r '.result.root_pane.pane_id' <<<"$tab")
  fi
  put "$panes" "$role" "$p"
}

close_pane() { local pane; pane=$(pane_of "$1"); pane_live "$pane" && h pane close "$pane" >/dev/null 2>&1 || true; drop "$panes" "$1"; }
hold() { { grep -v "^$1 " "$held" || true; echo "$1 $2 $3"; } > "$held.new"; mv "$held.new" "$held"; }
start_explorer() {  # the explorer works in the main checkout, started fresh for one piece of work and released after
  hold explorer "$1" "$KIT"; ensure_standing; ensure_pool_pane explorer "$KIT"; start explorer
  h agent wait "$(pane_of explorer)" --timeout 60000 >/dev/null 2>&1 || true
}
# wt list --format=json is schema 2: an object, not an array. Branches are
# under .items[], each carrying its checkout at .worktree.path, and a branch
# with no worktree has .worktree null. Iterating the object with .[] hits the
# schema number first and fails with "Cannot index number with string".
worktree_of() { in_kit wt list --format=json 2>/dev/null | jq -r --arg b "$(branch_of "$1")" '.items[] | select(.branch==$b and .worktree != null) | .worktree.path' | head -1; }
# A change is built on build/<change>; a fix, which has no change, is held as fix/<name> and built on that branch.
branch_of() { if [[ $1 == fix/* ]]; then echo "$1"; else echo "build/$1"; fi; }

teardown() {  # end every session the team has and give its panes back
  local role pane
  for role in $(awk '{print $1}' "$panes"); do stop "$role" || true; done
  for pane in $(awk '{print $2}' "$panes"); do pane_live "$pane" && h pane close "$pane" >/dev/null 2>&1 || true; done
  : > "$panes"; : > "$held"; : > "$layout"
}

greet_conductor() {  # a fresh conductor reads the record before anyone asks it anything
  local pane; pane=$(pane_of conductor)
  h agent wait "$pane" --timeout 60000 >/dev/null 2>&1 || true
  [[ $(agent_status "$pane") == blocked ]] && { echo "$(name_of conductor) is waiting on a prompt in its pane." >&2; return 0; }
  h agent prompt "$pane" "Read the record and tell me where things stand." >/dev/null 2>&1 || true
}

status() {
  load
  printf '%-26s %-8s %-9s %8s %5s %8s  %-12s %s\n' "$TEAM@$MACHINE" pane state context pct compacts started holds
  for role in "${roles[@]}"; do
    local pane st sid f tok=- pct=- comp=- born=- holds=
    pane=$(pane_of "$role"); st=$(agent_status "$pane")
    in_pool "$role" && { holds=$(change_of "$role"); [[ -z $st ]] && st=${holds:+not up}; [[ -z $st ]] && st=free; }
    if [[ -n $(agent_status "$pane") ]] && local_team; then
      sid=$(h agent get "$pane" | jq -r '.result.agent.agent_session.value // empty' || true)
      f=$(ls "$HOME"/.claude*/projects/*/"$sid".jsonl 2>/dev/null | head -1 || true)
      if [[ -n $f ]]; then
        tok=$(command grep '"usage"' "$f" | tail -40 | jq -rs '[.[] | select(.isSidechain|not) | .message.usage | select(.) | (.input_tokens + (.cache_read_input_tokens//0) + (.cache_creation_input_tokens//0))] | last // 0' 2>/dev/null || true); tok=${tok:-0}
        pct=$(( tok * 100 / ${WINDOW:-1000000} ))%; tok=$(( tok / 1000 ))k
        comp=$(command grep -c '"isCompactSummary":true' "$f" || true)
        born=$(command grep -m1 -o '"timestamp":"[^"]*"' "$f" | cut -d'"' -f4 | cut -c6-16 || true)
      fi
    fi
    printf '%-26s %-8s %-9s %8s %5s %8s  %-12s %s\n' "$(name_of "$role")" "${pane:--}" "${st:-not up}" "$tok" "$pct" "$comp" "$born" "$holds"
  done
}

pick_roles() {  # with no role named, the standing four plus whoever holds a change
  shift 2 || true; picked=("$@")
  if [[ ${#picked[@]} -eq 0 || -z ${picked[0]:-} ]]; then picked=("${standing[@]}"); local r; for r in "${pool[@]}"; do [[ -n $(change_of "$r") ]] && picked+=("$r"); done; fi
  local r; for r in "${picked[@]}"; do known_role "$r"; done
}

case $cmd in
  list) teams ;;
  bolts|bolt|plan) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  status)
    if [[ -n $team ]]; then status; else for team in $(teams); do status; echo; done; fi ;;
  up)
    load
    for role in "${standing[@]}"; do
      [[ -n $(agent_status "$(pane_of "$role")") ]] && { echo "$(name_of "$role") is already up; use: crew restart $team" >&2; exit 1; }
    done
    ensure_standing
    for role in "${standing[@]}"; do start "$role"; done
    greet_conductor ;;
  close)
    load; force=1; teardown; echo "$TEAM is closed" ;;
  rebuild)
    load; force=1; teardown
    ensure_standing
    for role in "${standing[@]}"; do start "$role"; done
    greet_conductor ;;
  restart)
    load; pick_roles "$@"
    stopped=(); for role in "${picked[@]}"; do stop "$role" && stopped+=("$role"); done
    ensure_standing
    for role in "${stopped[@]}"; do in_pool "$role" && ensure_pool_pane "$role" "$(path_of "$role")"; start "$role"; done
    [[ " ${picked[*]} " == *" conductor "* ]] && greet_conductor || true ;;
  resume)
    load; pick_roles "$@"
    ensure_standing
    for role in "${picked[@]}"; do
      if [[ -n $(agent_status "$(pane_of "$role")") ]]; then echo "$(name_of "$role") is already up"; continue; fi
      in_pool "$role" && ensure_pool_pane "$role" "$(path_of "$role")"
      start "$role" resume || { echo "$(name_of "$role") has no conversation to resume; starting it fresh"; start "$role"; }
    done ;;
  clear)
    load; role=${3:?usage: crew clear <team> <role>}; known_role "$role"; pane=$(pane_of "$role"); st=$(agent_status "$pane")
    [[ -z $st ]] && { echo "$(name_of "$role") is not up." >&2; exit 1; }
    [[ $st == working && $force == 0 ]] && { echo "$(name_of "$role") is working; add --force to clear it anyway." >&2; exit 1; }
    h agent prompt "$pane" "/clear" >/dev/null; sleep 2
    give_name "$pane" "$(name_of "$role")" && echo "$(name_of "$role") cleared" ;;
  opsx)
    # Every OpenSpec command starts in a clean context: clear the agent, give it its name back, then send.
    load; role=${3:?usage: crew opsx <team> <role> "/opsx:<command> <slug> [...]"}; cmd=${4:?usage: crew opsx <team> <role> "/opsx:<command> <slug> [...]"}
    known_role "$role"; [[ $cmd == /opsx:* ]] || { echo "crew opsx sends only /opsx: commands" >&2; exit 2; }
    pane=$(pane_of "$role"); st=$(agent_status "$pane")
    if [[ $role == explorer && -z $st ]]; then
      slug=$(awk '{print $2}' <<<"$cmd"); start_explorer "${slug:-opsx}"
      h agent prompt "$(pane_of explorer)" "$cmd" >/dev/null && echo "$(name_of explorer) started and given: $cmd"; exit 0
    fi
    [[ -z $st ]] && { echo "$(name_of "$role") is not up." >&2; exit 1; }
    [[ $st == working && $force == 0 ]] && { echo "$(name_of "$role") is working; wait for it, or add --force." >&2; exit 1; }
    h agent prompt "$pane" "/clear" >/dev/null; sleep 2
    give_name "$pane" "$(name_of "$role")" >/dev/null
    h agent prompt "$pane" "$cmd" >/dev/null && echo "$(name_of "$role") cleared and given: $cmd" ;;
  assign)
    load; role=${3:?usage: crew assign <team> <coder-n|verifier|explorer> <change|fix/name|lookup>}; slug=${4:?usage: crew assign <team> <coder-n|verifier|explorer> <change|fix/name|lookup>}
    known_role "$role"; in_pool "$role" || { echo "only a coder, the verifier or the explorer holds work" >&2; exit 2; }
    if [[ $role == explorer ]]; then
      [[ -z $(agent_status "$(pane_of explorer)") ]] || { echo "$(name_of explorer) is up, holding $(change_of explorer); release it first" >&2; exit 1; }
      start_explorer "$slug"; exit 0
    fi
    if [[ $slug == fix/* ]]; then
      [[ $slug =~ ^fix/[a-z0-9][a-z0-9-]*$ ]] || { echo "a fix is named fix/<words-with-dashes>" >&2; exit 2; }
    else
      in_kit test -d "openspec/changes/$slug" || { echo "no change '$slug' in $KIT_NAME" >&2; exit 2; }
    fi
    if [[ $role == coder-* ]]; then
      other=$(awk -v s="$slug" -v r="$role" '$2==s && $1!=r && $1!="verifier"{print $1}' "$held")
      [[ -n $other ]] && { echo "$(name_of "$other") already holds $slug" >&2; exit 1; }
    fi
    now=$(change_of "$role"); [[ -n $now && $now != "$slug" ]] && { echo "$(name_of "$role") holds $now; release it first" >&2; exit 1; }
    stop "$role"
    path=$(worktree_of "$slug")
    if [[ -z $path && $role == verifier ]]; then echo "$slug has no worktree: verify runs where a coder built" >&2; exit 1; fi
    if [[ -z $path ]]; then
      in_kit wt switch --create "$(branch_of "$slug")" --base "$BASE" --no-cd >/dev/null
      path=$(worktree_of "$slug"); [[ -n $path ]] || { echo "the worktree for $(branch_of "$slug") did not appear; run 'wt list' in $KIT" >&2; exit 1; }
      # A kit that needs a new worktree prepared (dependencies installed) gives its devenv a `crew-prepare` script,
      # run here from the main checkout's profile since a worktree has no devenv of its own.
      on_machine env -C "$path" KIT="$KIT" bash -c 'p="$KIT/.devenv/profile/bin"; [ -x "$p/crew-prepare" ] || exit 0; PATH="$p:$PATH" crew-prepare' >/dev/null
    fi
    hold "$role" "$slug" "$path"
    ensure_standing; ensure_pool_pane "$role" "$path"; start "$role" ;;
  release)
    load; role=${3:?usage: crew release <team> <coder-n|verifier|explorer>}; known_role "$role"
    slug=$(change_of "$role"); [[ -n $slug ]] || { echo "$(name_of "$role") holds nothing"; exit 0; }
    path=$(path_of "$role"); ahead=0
    if [[ $role == coder-* ]]; then
      ahead=$(in_kit git rev-list --count "$BASE..$(branch_of "$slug")" 2>/dev/null || echo 0)
      if [[ $ahead != 0 && $force == 0 ]]; then echo "$(branch_of "$slug") has $ahead commits that are not on $BASE. Have the coder merge them, or add --force to free the coder and keep the worktree." >&2; exit 1; fi
    fi
    stop "$role"; close_pane "$role"
    [[ $role == coder-* && $ahead == 0 ]] && { on_machine env -C "$path" wt remove >/dev/null 2>&1 || true; }
    drop "$held" "$role"; echo "$(name_of "$role") is free" ;;
  down)
    load; for role in "${roles[@]}"; do stop "$role" || true; done; echo "$TEAM is down; its panes are still there." ;;
  *) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
