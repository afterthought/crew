#!/usr/bin/env bash
# crew: run bolt teams of agents in herdr, and each partition's main level. Teams and partitions are data in
# ~/.config/crew/teams.json.
#
# A team builds one bolt at a time:
#   crew list                          the teams that are defined
#   crew status  [team]                the conductor and ops (state, context use, compactions, age), and each unit
#                                      slot with the unit or fix it holds and its stage. It first frees each slot
#                                      whose work has merged, been dropped or left the team's bolt, once its agent
#                                      is not working, and removes, through the kit's wt remove, the worktrees in
#                                      the team's kit checkout whose work is over, naming one kept for uncommitted
#                                      changes or a remove hook
#   crew up      <team>                open the team's workspace and start its conductor and ops; the conductor's
#                                      greeting (also on rebuild, restart and revive) opens with the units of its bolt
#                                      that wait amended, for it to start their construct. A greeting is read back
#                                      from the agent's transcript and sent once more when not taken
#   crew rebuild <team>                end everything the team has, close its panes, and stand it up fresh,
#                                      keeping only the slots of work still in flight on its bolt
#   crew close   <team>                end everything the team has and close its panes; nothing is started
#   crew restart <team> [role...] [--no-greet]
#                                      end the conductor's or ops' session and start a fresh one in the same pane
#   crew resume  <team> [role...]      bring back the conductor or ops when not up, with its last conversation; a
#                                      conductor brought back is sent, as crew's notice, the units of its bolt that
#                                      wait amended
#   crew clear   <team> <role>         /clear the conductor or ops and give it its name back
#   crew down    <team>                end every session the team has; the panes stay
#   crew unit free <unit> [--team <team>]
#                                      free a slot still holding a unit no longer in the team's bolt now, rather
#                                      than at the read after its agent settles: end its agent, and remove the
#                                      worktrees whose work is over; refused while its worktree has uncommitted
#                                      changes
#   crew unit run <unit> construct|code|verify|settle|merge ["<words>"]
#                                      start the unit's stage in its slot, a fresh agent at that stage's effort:
#                                      construct writes its OpenSpec change, once each unit it comes after has
#                                      committed its own, its new place taking their work; code builds it as soon
#                                      as it is committed, its prompt naming an overlap of Touches; verify checks
#                                      it, naming the paths it changed and did not declare; settle takes what
#                                      reached a verified unit; merge merges it into the bolt once each unit it
#                                      comes after has merged, with wt merge, or wt submit where the kit opts into
#                                      sluice. Construct run again on a planned unit marks it amended: code waits
#                                      until that construct has committed. An amendment to a unit's intent runs
#                                      its construct itself, and anyone may start construct on a unit that waits
#                                      amended. Refused while the team is down. The stage begins only once its
#                                      agent's transcript shows its prompt, sent once more when it does not; else
#                                      it never started, with nothing left typed, and the command fails saying so
#   crew chore run <chore> code|verify|merge ["<words>"]
#                                      start a chore's stage in its slot, a fresh agent at that stage's effort, in
#                                      places/chore-<chore> on chore/<chore> from the bolt: code does the chore's words,
#                                      each commit carrying its Chore: trailer; verify checks the commits against them;
#                                      merge merges it into the bolt as a unit's merge does. Code starts once what it
#                                      comes after has something committed to build on, its place taking their heads;
#                                      verify needs a commit of its own; merge needs verify run since its code, the
#                                      trailer on every commit of its own, and what it comes after merged. A chore has no
#                                      construct and no review; a unit after a chore is constructed once its code has
#                                      delivered
#   crew chore wait|free <chore> ...   as a unit's wait and free
#   crew unit wait <unit> [--timeout <ms>] [--stuck <ms>]
#                                      first forecast conflicts with git merge-tree, telling each later unit once,
#                                      rebase dependents whose unit merged, and count the partition's changes due for
#                                      a batch; then wait for the unit's stage to end at what it delivers (construct's
#                                      change, code's ticked tasks, verify's report, settle's commit, merge's commit
#                                      on the bolt), or at its agent saying what it needs; the stage's end is
#                                      recorded. It returns sooner when
#                                      the agent has been quiet past --stuck (15 minutes) with nothing of its own
#                                      running, or is gone, or the timeout (an hour) passes, and says which
#   crew fix     <team> <name> "<what is wrong>"
#                                      a fix on the team's bolt: fix/<bolt>/<name> at places/fix-<bolt>--<name>,
#                                      built by a fresh code agent; a name already in use on the bolt is refused.
#                                      Its prompt, and its merge's, is taken or sent again as a unit stage's is
#   crew fix     <team> <name> --merge merge the fix into the bolt; or, when the fix carries the bolt onto main (the
#                                      bolt's own commits replayed onto the kit's main, each with its message and
#                                      author, and nothing else), end its agent, make its head the bolt's head, and
#                                      run the kit's post-merge checks there: the bolt is then proven again before it
#                                      lands. git range-diff of the two is printed beside the judgment as the
#                                      reading, and judges nothing
#   crew fix     <team> <name> --wait [--timeout <ms>] [--stuck <ms>]
#                                      wait for the fix's stage to end: its commits, or its merge on the bolt
#   crew prove   <team> ["<words>"]    ask the team's ops to deploy the bolt and work each unit's Proof in dev list;
#                                      its proof file in the team's reports folder is the proof's end. The request is
#                                      taken or sent again as a stage's prompt is; one not taken starts no proof
#   crew prove   <team> --wait [--timeout <ms>] [--stuck <ms>]
#                                      wait for ops's proof file
#   crew needs   "<what you need>"     run by a stage's agent, or ops during a proof, that can't finish without
#                                      something only someone else can give: its stage ends short, and the conductor
#                                      is given the words, by its wait or by a tell
#
# The plan, the moves and the signals crew records, on the flywheel's branch <label>/main of the partition's state
# repository; a meeting's signals stay in the partition's first blueprints repo:
#   crew state init <label>            create the flywheel's branch, adopting plan/<label> and the moves it had
#   crew bolts [<bolt>] [--label L] [--json]
#                                      every bolt, unit and chore of the plans, each one's stage read from its kit
#   crew bolt  new|give|order|drop|land ...
#   crew unit  add|split|amend|order|after|move|drop ...
#   crew chore add|order|after|move|drop ...
#                                      planned maintenance that changes nothing a spec says, written as a unit is, by the
#                                      same hands, and built in its bolt by code, verify and merge
#   crew plan  propose|proposed|agree|card|approve|answer|drop ...
#                                      the planner's proposals: a change to the plan, applied once the user approves it;
#                                      card prints a proposal's Pending You card and draws its picture, which link no
#                                      session; approve --clear leaves out the new units the user cleared; answer
#                                      records the card's answers and applies the approval once it holds them all
#   crew rail  [--label L]             what waits on the user: proposals, review batches, verify reports and bolts to land,
#                                      each with when it began to wait, the command that answers it and its Pending
#                                      You card; then the decision records waiting on you, each the design agent's
#                                      open card for one; then any open card whose row is gone. It ends, on every
#                                      host of the partition, each card session crew started whose card is closed or
#                                      whose row is gone, and says which, with its host and why, and each host it
#                                      could not check
#   crew board [--label L] [--json]    the flow, one partition at a time, as four lanes stacked: Inception (signals
#                                      no move has taken, explorations), Bolt plan (proposals, planned bolts, the
#                                      queue), Construction (each held bolt as a ledger of its units, fixes, slots and
#                                      dev servers) and Operation (bolts landed this week, each environment's deploys
#                                      and the operations waiting); each rail row a marker on its object, what needs
#                                      attention at the foot; it answers nothing
#   crew card  session|wait|end <key> [<unit>] [--label L]
#                                      the plannotator session on what a rail row's card asks the user to read:
#                                      session starts it on this host with no browser and prints its link (the
#                                      running one's when there is one), a batch card's one on the whole batch, on
#                                      the main level's host, and an old batch card's (batch/<n>-<k>) one per <unit>
#                                      on that unit's team's host; wait waits for the user's decision in it and prints
#                                      it with their words; end ends it, as the card's close does
#   crew card  sweep --label L         the rail's, run on each host of the partition with what it judged on standard
#                                      input: ends the sessions there whose card is closed or whose row is gone; not
#                                      for hand use
#   crew card  post|change <key> [--label L] < <JSON>
#                                      post the card on standard input to the user as the asking assistant, through the
#                                      fleet's pendingyou mcp under the host's sign-in, or change the one the asker
#                                      holds under the key; refused as crew's card hook refuses it, crew setting the
#                                      key, the session and the kit's area; recorded from Pending You's reply
#   crew card  close <key> --outcome "<line>" | --reason "<line>" [--label L]
#                                      close the asker's card once acted on, or withdraw it, and end its session
#   crew card  read <key> [--label L] [--json]
#                                      where the asker's card stands: its status, whose turn, the user's answer and words
#   crew signal <slug> "<what it asserts>" --excerpt "<the words, verbatim>" ...
#                                      record a finding as a signal, quoting the words that show it, which are
#                                      checked against the agent's own Claude transcript
#   crew signal show <id>              a signal, where its excerpt came from, and its move
#   crew signal move <id> attach|challenge|new-territory|answered|drop ...
#                                      curation's move for a signal
#   crew signal land <capture-dir> --label L
#                                      a program's capture, a deployer's or another adapter's, with its signals,
#                                      landed on the flywheel's branch from the host that banked its raw record
#   (crew bolt|unit|chore|plan|signal --help says more)
#
# Each partition's main level, and the operator agent in each operator session:
#   crew main     up|down|status <label>  the design agent, the planner and ops in the <label> workspace of the
#                                      main level's session, and a dispatcher on each host the partition's teams run on;
#                                      each agent up starts is greeted to read where the partition stands and carry on
#   crew review   <label> [--wait [--timeout <ms>]]
#                                      the partition's reviewer, started fresh for the batch of changes due, in a
#                                      review tab beside the planner; --wait waits for its summary, records the batch
#                                      and closes the tab
#   crew operator up <label>           the operator agent in this host's operator session <label>, with a flow tab
#                                      following the run record, a rail tab (crew rail above, a shell below) and a
#                                      board tab drawn from the rail tab's read; the agent it starts is greeted the
#                                      same way
#   crew tell     <agent> "<text>"     prompt an agent crew started, wherever it runs, marked with who sent it;
#                                      refused, with nothing typed, while the agent waits on a question in its pane
#   crew revive                        after a restart, every standing agent of this host whose pane came back with no
#                                      agent in it, picked up from its last conversation and greeted when it is a
#                                      conductor or an agent outside a team; a team or main level taken down with
#                                      crew down stays down
#   crew sites    [<label>] [--json]   every host's bolts, units and fixes, with the URL of each running dev server
#
# Operations on a partition's environments, a deploy being one kind (plan.14), run where the partition's main level
# runs (lib/ops.py says each in full):
#   crew ops offer|approve <env> --label L --to <sha> [--from <sha|none>]
#                                      a manual environment's deploy offered as a rail row; the user's word for it
#   crew ops word|quiet <env> --label L
#                                      the commit the user's word is for; whether the environment's host is quiet
#   crew ops record <env> --label L --to <sha> --act start|step|end [...]
#                                      a deploy's start, steps and end in the run record as it runs
#   crew ops step <env> --label L --key K --state S [--to <sha>] [...]
#   crew ops steps <env> --label L --json
#                                      any other operation and its state, on its own or after a deploy
#
# What happened, read from the run record every command that moves work appends on the host it ran on:
#   crew events   [--label L] [--about <object>] [--since <time>] [--follow] [--json]
#                                      the entries of the partition's branch and of every host it runs on, in time order
#   crew events   --push [--label L]   carry this host's run record to the partition's branch now
#   crew trace    <object>             one bolt's, unit's or signal's history: what was done, by whom, in which
#                                      session, with which commit, and what it led to
#   crew page     <label> [--out <file>] [--since <time>]
#                                      the partition's page, one HTML file that loads nothing: it opens on the board,
#                                      its four lanes drawn as the flywheel mockup draws them, narrowed to one team
#                                      when chosen, kept across reloads, and its header linking each other partition's
#                                      page beside it (../<label>/page.html); one switch away, the lineage: signals,
#                                      agenda items, proposals, units and bolts as columns, a line from each to what
#                                      it led to, and each one's history as crew trace prints it; and the deploys,
#                                      each environment's as a timeline, with the word, steps, checks and outcome of
#                                      each, and the bolts it carried with their proposals; written whole to
#                                      ~/.local/state/crew/<label>/page.html on this host, or --out, and its path
#                                      printed with as of when and which commit it was drawn from
#
# A team is two herdr workspaces in its session: "<team>", with a "conductor" tab (the conductor and ops) and a
# "git" tab (gitgui in the kit and the blueprints repo), and "<team> units", one pane per slot in flight, which
# exists only while a unit or fix is. A team's panes and state live on its host, so a command about a team runs
# there. Add --force to act on an agent that is working.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
py() { python3 "$here/../lib/crew.py" "$@"; }
plan() { python3 "$here/../lib/plan.py" "$@"; }
h() { herdr --session "$SESSION" "$@"; }
teams() { py teams || exit 1; }
this_host() { hostname -s; }
usage() { awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

orig=("$@"); force=0; forced=(); greet=1; args=(); started=(); ended=()
for a in "$@"; do case $a in --force) force=1; forced=(--force) ;; --no-greet) greet=0 ;; *) args+=("$a") ;; esac; done
set -- ${args[@]+"${args[@]}"}
cmd=${1:-}

# The command's reading (plan.12): a folder holding what its steps on this host have read of the plan and the kits, so
# the command fetches the state branch and reads each kit once however many steps it has. The steps it starts on this
# host share it through CREW_READ; a step on another host makes its own. It goes when the command ends, refused or
# not, and one a killed command left goes once it is a day old. A command run as one process (exec'd below, or run by
# one) keeps its reading in memory; the rail tab's loop and crew events make none, so each refresh reads afresh.
reads=$HOME/.cache/crew/reads
unread() { case ${CREW_READ:-} in "$reads"/????????) rm -rf -- "$CREW_READ" ;; esac; }
reading() {
  [[ -n ${CREW_READ:-} && $(cat "$CREW_READ/host" 2>/dev/null) == "$(this_host)" ]] && return 0
  mkdir -p "$reads"
  find "$reads" -mindepth 1 -maxdepth 1 -name '????????' -mtime +0 -exec rm -rf -- {} + 2>/dev/null || true
  CREW_READ=$(mktemp -d "$reads/XXXXXXXX") || { echo "crew could not make its reading in $reads" >&2; exit 1; }
  trap unread EXIT; export CREW_READ
  this_host > "$CREW_READ/host"
}
case $cmd in
  bolts | bolt | signal | state | plan | rail | board | _views | _board | card | trace | page | sites | list | tell | ops) ;;
  status | unit | chore | fix | _tidy) ;;
  events | _rail) unset CREW_READ ;;
  *) reading ;;
esac

# ------------------------------------------------------------------------------------------- what is acted on

load_team() {
  [[ -n ${1:-} ]] || { echo "which team? teams: $(teams | tr '\n' ' ')" >&2; exit 2; }
  local e; e=$(py env "$1") || exit 1; eval "$e"
  KIND=team; SCOPE=$TEAM; standing=(conductor ops); slots=()
  local n; for n in $(seq "$UNITS"); do slots+=("unit-$n"); done
  state_files
}
load_main() {
  [[ -n ${1:-} ]] || { echo "which partition? partitions: $(py labels | tr '\n' ' ')" >&2; exit 2; }
  local e; e=$(py env-main "$1") || exit 1; eval "$e"; SCOPE=$LABEL; standing=(design planner ops); slots=(); state_files
}
load_dispatch() { local e; e=$(py env-dispatch "$1") || exit 1; eval "$e"; SCOPE=$LABEL; standing=(dispatcher); slots=(); state_files; }
load_operator() { local e; e=$(py env-operator "$1") || exit 1; eval "$e"; SCOPE=$LABEL; standing=(operator); slots=(); state_files; }
state_files() { panes=$STATE/panes; layout=$STATE/layout; held=$STATE/slots; }
ensure_state() { mkdir -p "$STATE"; touch "$panes" "$layout" "$held"; }
local_here() { [[ $(this_host) == "$MACHINE" ]]; }

# Who asks, and the Claude session behind them, go with a command run on another host, so what it records there names them.
identity() { echo "CREW_AGENT=${CREW_AGENT:-$(id -un)@$(this_host)}"; }
session_of() { python3 "$here/../lib/record.py" session 2>/dev/null || true; }
there() {  # there <host's ssh name> <crew on that host> <args...>: run a crew command on another host. The caller's
  # session is the one the env of what is acted on gave (CALLER_SESSION, empty for the user), else asked of record.py.
  local target=$1 remote=$2 sid; shift 2
  if [[ ${CALLER_SESSION+set} ]]; then sid=$CALLER_SESSION; else sid=$(session_of); fi
  ssh -o BatchMode=yes "$target" "$(printf '%q ' env "$(identity)" "CREW_LABEL=${CREW_LABEL:-}" "CREW_SESSION=$sid" bash "$remote" "$@")"
}
# An entry in the run record (lib/record.py), written after the act. A failure is said on standard error and
# changes nothing about the command.
entry() { python3 "$here/../lib/record.py" emit "$@" >/dev/null || true; }
record_agents() {  # record_agents <act> <why> [role...]: one entry for an act on agents, naming each; a team's names the team
  local act=$1 why=$2 r on=(); shift 2
  [[ $KIND == team ]] && on+=(--on "team/$TEAM")
  for r in "$@"; do on+=(--on "agent/$(name_of "$r")"); done
  (( ${#on[@]} )) || return 0
  entry --label "$LABEL" --act "$act" "${on[@]}" --why "$why"
}
forward() {  # what is acted on lives on its host: run this same command there, unless this is that host. The crew
  # there came with the env (REMOTE_CREW, or REMOTE_CREW_REFUSED saying why there is none).
  local_here && return 0
  [[ -z ${REMOTE_CREW_REFUSED:-} ]] || { echo "$REMOTE_CREW_REFUSED" >&2; exit 1; }
  local remote=${REMOTE_CREW:-}; [[ -n $remote ]] || remote=$(py crew-at "$MACHINE") || exit 1
  there "$SSH_TARGET" "$remote" "${orig[@]}"; exit $?
}
one() {  # one <plan.py entry> <args...>: a team's command, one Python process on the team's host (code.7). Run on
  # another host, the process does nothing there but say on its descriptor 3 where the team runs and how crew runs
  # there, and the command is forwarded (code.3).
  local to rc=0
  { to=$(python3 "$here/../lib/plan.py" "$@" 3>&1 >&4 4>&-) || rc=$?; } 4>&1
  [[ -n $to ]] || exit $rc
  eval "$to"; forward
}
need_team() { [[ -n ${1:-} ]] || { echo "which team? teams: $(teams | tr '\n' ' ')" >&2; exit 2; }; }

name_of() {
  case $KIND in
    team | main) echo "$SCOPE-$1" ;;
    dispatch) echo "$LABEL-dispatch-$HOST" ;;
    operator) echo "$LABEL-operator-$HOST" ;;
  esac
}
is_slot() { [[ $1 == unit-* ]]; }
get() { awk -v k="$2" '$1==k{print $2}' "$1"; }
put() { { grep -v "^$2 " "$1" || true; echo "$2 $3"; } > "$1.new"; mv "$1.new" "$1"; }
drop() { { grep -v "^$2 " "$1" || true; } > "$1.new"; mv "$1.new" "$1"; }
pane_of() { get "$panes" "$1"; }
pane_live() { [[ -n ${1:-} ]] && h pane get "$1" >/dev/null 2>&1; }
agent_status() { [[ -n ${1:-} ]] || return 0; h agent get "$1" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true; }
known_role() {
  local r; for r in "${standing[@]}"; do [[ $r == "$1" ]] && return 0; done
  echo "no role '$1' here; roles: ${standing[*]}" >&2; exit 2
}
split() { h pane split "$1" --direction "$2" --cwd "$3" --no-focus | jq -r '.result.pane.pane_id'; }
close_pane() { local pane; pane=$(pane_of "$1"); if pane_live "$pane"; then h pane close "$pane" >/dev/null 2>&1 || true; fi; drop "$panes" "$1"; }

give_name() {  # herdr drops an agent's name whenever its session changes
  local pane=$1 name=$2
  for _ in $(seq 60); do h agent rename "$pane" "$name" >/dev/null 2>&1 && return 0; sleep 1; done
  echo "$name did not come up in $pane; look at that pane." >&2; return 1
}

stop() {  # end a role's session; each role whose agent it ends is added to `ended`
  local role=$1 pane st=; pane=$(pane_of "$role")
  pane_live "$pane" && st=$(agent_status "$pane")
  if [[ $st == working && $force == 0 ]]; then echo "$(name_of "$role") is working; add --force to end it anyway." >&2; return 1; fi
  # A slot's stage, or ops's proof, whose end nobody recorded ends here, with the agent that ran it: delivered when its
  # deliverable is there, else stopped.
  if [[ $KIND == team ]] && { is_slot "$role" || [[ $role == ops ]]; } && [[ -s $STATE/stages ]]; then
    plan _ends "$TEAM" --slot "$role" --ending >/dev/null 2>&1 || true
  fi
  [[ -z $st ]] && return 0
  h agent prompt "$pane" "/exit" >/dev/null 2>&1 || h pane send-keys "$pane" ctrl+c ctrl+c >/dev/null 2>&1 || true
  for _ in $(seq 30); do [[ -z $(agent_status "$pane") ]] && { ended+=("$role"); return 0; }; sleep 1; done
  h pane send-keys "$pane" ctrl+c ctrl+c >/dev/null 2>&1 || true; sleep 2
  # Still running means anything started next would be typed into it as a message. Say so and leave it be.
  [[ -z $(agent_status "$pane") ]] || { echo "$(name_of "$role") did not exit (busy or waiting on the user); it was left running" >&2; return 1; }
  ended+=("$role")
}

start() {  # start <role> [stage|resume]
  local role=$1 pane name dir; pane=$(pane_of "$role"); name=$(name_of "$role")
  [[ -z $(agent_status "$pane") ]] || { echo "$name is still running; not starting another over it" >&2; return 1; }
  dir=$(py place "$SCOPE" "$role" ${2:-}) || return 1
  # A Claude that died badly leaves the pane reporting mouse movement, which types escape codes into the shell
  # and into whatever is run next. Clear the line and switch the reporting off first.
  h pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || true
  h pane run "$pane" "printf '\\033[?1000l\\033[?1002l\\033[?1003l\\033[?1006l\\033[?1015l\\033[?2004l'; clear" >/dev/null 2>&1 || true
  sleep 1
  # The pane's own shell moves to the folder the role runs in. herdr saves a pane's shell folder and, after a restart,
  # resumes the agent's conversation there, and Claude finds a conversation only from the folder it began in.
  h pane run "$pane" "cd $(printf '%q' "$dir") && bash $(printf '%q' "$here/crew-role") $SCOPE $role ${2:-}" >/dev/null
  give_name "$pane" "$name" || return 1
  # Claude asks whether a folder it has not seen is trusted. Every role starts in a folder the hosts file names:
  # a session's space, a checkout in it, or a worktree crew made from the team's own repository. So that one
  # question is answered for it. Nothing else is: not the Bypass Permissions warning, which swancloud's settings
  # answer once for every account.
  for _ in $(seq 15); do
    sleep 2
    if h pane read "$pane" --source visible --lines 30 2>/dev/null | command grep -q "Yes, I trust this folder"; then
      h agent send-keys "$pane" down enter >/dev/null 2>&1 || true; sleep 3; break
    fi
    [[ $(agent_status "$pane") == idle ]] && break
  done
  case ${2:-} in resume) echo "$name resumed in $pane" ;; "") echo "$name started in $pane" ;; *) echo "$name started $2 in $pane" ;; esac
}

# ------------------------------------------------------------------------------------------- the workspaces

ws_key() { echo "ws:${1// /_}"; }  # a workspace's label as a key of the layout file, which splits on spaces
workspace() {  # workspace <label> <cwd>: a new workspace; its id goes in the layout, its root pane is printed
  local ws; ws=$(h workspace create --cwd "$2" --label "$1" --no-focus)
  put "$layout" "$(ws_key "$1")" "$(jq -r '.result.workspace.workspace_id' <<<"$ws")"
  echo "$(jq -r '.result.tab.tab_id' <<<"$ws") $(jq -r '.result.root_pane.pane_id' <<<"$ws")"
}
tab() {  # tab <workspace label> <tab label> <cwd> <role>: a tab with one pane for the role
  local t; t=$(h tab create --workspace "$(get "$layout" "$(ws_key "$1")")" --cwd "$3" --label "$2" --no-focus)
  put "$panes" "$4" "$(jq -r '.result.root_pane.pane_id' <<<"$t")"
}
first_tab() {  # first_tab <workspace label> <tab label> <cwd> <role>: the workspace, its first tab holding the role
  local r; r=$(workspace "$1" "$3"); h tab rename "${r% *}" "$2" >/dev/null; put "$panes" "$4" "${r#* }"
}

ensure_team() {  # "<team>": a conductor tab with the conductor and ops, and on a Mac a git tab, gitgui in each repo
  local c o g b
  c=$(pane_of conductor); pane_live "$c" || { first_tab "$TEAM" conductor "$KIT" conductor; c=$(pane_of conductor); }
  o=$(pane_of ops); pane_live "$o" || put "$panes" ops "$(split "$c" right "$KIT")"
  # gitgui draws with terminal graphics, which are too slow to use over a remote host's connection.
  [[ ${HOST_KIND:-} == darwin ]] || return 0
  g=$(pane_of git-kit)
  if ! pane_live "$g"; then tab "$TEAM" git "$KIT" git-kit; g=$(pane_of git-kit); h pane run "$g" gitgui >/dev/null; fi
  b=$(pane_of git-blueprints)
  pane_live "$b" || { b=$(split "$g" right "$BLUEPRINTS"); put "$panes" git-blueprints "$b"; h pane run "$b" gitgui >/dev/null; }
}

ensure_main() {  # "<label>": design, planner and ops tabs, one agent each
  local r p; p=$(pane_of design); pane_live "$p" || first_tab "$LABEL" design "$CWD" design
  for r in planner ops; do p=$(pane_of "$r"); pane_live "$p" || tab "$LABEL" "$r" "$CWD" "$r"; done
}
ensure_single() {  # ensure_single <workspace label> <role>: a workspace holding one agent
  local p; p=$(pane_of "$2"); pane_live "$p" || first_tab "$1" "$2" "$CWD" "$2"
}
ensure_flow() {  # the operator workspace's "flow" tab, following the partition's run record, opened once
  local p; p=$(pane_of flow); pane_live "$p" && return 0
  tab operator flow "$CWD" flow
  h pane run "$(pane_of flow)" "bash $(printf '%q' "$here/crew") events --follow --label $LABEL" >/dev/null
}
ensure_rail() {  # the operator workspace's "rail" tab, opened once: what waits on the user above, kept current by
  # crew _rail, and a shell below with this crew on its path, to paste a row's command into
  local p s; p=$(pane_of rail)
  if ! pane_live "$p"; then
    tab operator rail "$CWD" rail; p=$(pane_of rail)
    h pane run "$p" "bash $(printf '%q' "$here/crew") _rail $LABEL" >/dev/null
  fi
  s=$(pane_of rail-shell); pane_live "$s" && return 0
  s=$(split "$p" down "$CWD"); put "$panes" rail-shell "$s"
  h pane run "$s" "export PATH=$(printf '%q' "$here"):\$PATH" >/dev/null
}
ensure_board() {  # the operator workspace's "board" tab, after "rail", opened once: the partition's board, drawn by
  # crew _board from what the rail tab's loop read at its last refresh
  local p; p=$(pane_of board); pane_live "$p" && return 0
  tab operator board "$CWD" board
  h pane run "$(pane_of board)" "bash $(printf '%q' "$here/crew") _board $LABEL" >/dev/null
}

teardown() {  # end every session and give the panes back; the slots still say what is in flight
  local role pane
  for role in $(awk '{print $1}' "$panes"); do stop "$role" || true; done
  for pane in $(awk '{print $2}' "$panes"); do if pane_live "$pane"; then h pane close "$pane" >/dev/null 2>&1 || true; fi; done
  for pane in $(awk '$1 ~ /^ws:/ {print $2}' "$layout"); do h workspace close "$pane" >/dev/null 2>&1 || true; done
  : > "$panes"; : > "$layout"
}

greet_conductor() {  # a fresh conductor reads where its bolt stands and carries on, before anyone asks it anything;
  # the greeting opens with the units of its bolt that wait amended, for it to start their construct
  local first; first=$(plan _amended "$TEAM" 2>/dev/null || true)
  py greet "$TEAM" ${first:+--first "$first"} || true
}
greet_started() {  # greet_started [role...]: each agent outside a team that this command started or brought back is
  # greeted, each in the background, so one waiting on a question holds back nobody else; the command waits for them
  # before it ends, and a greeting that can't be sent fails nothing
  local r; for r in "$@"; do { py greet-agent "$(name_of "$r")" || true; } & done
}

# A team or main level taken down stays down through a restart: crew revive leaves it be until it is brought up.
mark_down() { touch "$STATE/down"; }
mark_up() { rm -f "$STATE/down"; }

revive() {  # start, from its last conversation, each standing role whose pane is there with no agent in it; a team's
  # conductor is greeted, and every agent brought back outside a team, together once all are back
  local role pane back=()
  [[ -s $panes ]] || return 0
  [[ -e $STATE/down ]] && { echo "$SCOPE was taken down; it stays down"; return 0; }
  for role in "${standing[@]}"; do
    pane=$(pane_of "$role"); pane_live "$pane" || continue
    [[ -z $(agent_status "$pane") ]] || continue
    sleep 10; [[ -z $(agent_status "$pane") ]] || continue  # herdr may still be resuming it
    start "$role" resume || continue
    record_agents agent.resume "${KIND}($SCOPE): resume $(name_of "$role")" "$role"
    if [[ $KIND != team ]]; then back+=("$role"); elif [[ $role == conductor ]]; then greet_conductor; fi
  done
  greet_started ${back[@]+"${back[@]}"}; wait
}

start_standing() {  # start each standing role that is not up; each one started is added to `started`
  local role
  for role in "${standing[@]}"; do
    if [[ -n $(agent_status "$(pane_of "$role")") ]]; then echo "$(name_of "$role") is already up"; else start "$role"; started+=("$role"); fi
  done
}

# ----------------------------------------------------------------------------------------------- unit slots

reap() {  # the team's read (plan.py reap): the stages that ended with nobody waiting recorded; every slot freed whose
  # unit or fix has merged into its bolt, been dropped from the plan or left the team's bolt, once its agent is not
  # working; each dependent rebased whose After unit has merged; then the worktrees removed whose work is over
  plan _tidy "$TEAM" ${forced[@]+"${forced[@]}"} || true
}
limits() {  # limits [--timeout <ms>] [--stuck <ms>]: a wait's limits, as plan _wait takes them, in `limit`
  limit=()
  while (( $# )); do
    case $1 in
      --timeout | --stuck) [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "$1 takes a number of milliseconds" >&2; exit 2; }; limit+=("$1" "$2"); shift 2 ;;
      *) echo "a wait takes --timeout <ms> and --stuck <ms>, not $1" >&2; exit 2 ;;
    esac
  done
}
stage_wait() {  # stage_wait <slot|ops> [--timeout <ms>] [--stuck <ms>]: wait on the stage it owes, on the team's host
  local slot=$1; shift; limits "$@"
  plan _wait "$TEAM" --slot "$slot" ${limit[@]+"${limit[@]}"}
}
prove() {  # prove "<words>": ask ops to prove the team's bolt, and owe the proof's end like a stage's
  local words=$1 bolt= err id
  if ! err=$(plan _bolt-of "$TEAM" 2>&1); then
    echo "$err" >&2; entry --label "$LABEL" --act stage.start --on "team/$TEAM" --on "agent/$TEAM-ops" --refused "$err"; exit 1
  fi
  eval "$(grep '^BOLT=' <<<"$err")"; bolt=$BOLT
  if [[ -z $(agent_status "$(pane_of ops)") ]]; then
    err="$TEAM-ops is not up: crew resume $TEAM ops brings it back"
    echo "$err" >&2; entry --label "$LABEL" --act stage.start --on "stage/$bolt/proof" --on "bolt/$bolt" --on "agent/$TEAM-ops" --refused "$err"; exit 1
  fi
  # A proof still owed is over once another is asked for.
  if [[ -s $STATE/stages ]]; then plan _ends "$TEAM" --slot ops --ending >/dev/null 2>&1 || true; fi
  # The request is taken or sent again (teams.15); one ops never took, or one crew can't tell it took, starts no proof.
  if ! err=$(py tell "$TEAM-ops" "Deploy the bolt and work the Proof in dev list of each of its units.${words:+ $words}" --taken 2>&1); then
    echo "$err" >&2; echo "the proof of $bolt never started, and no proof is owed: crew prove $TEAM asks ops again" >&2
    entry --label "$LABEL" --act stage.start --on "stage/$bolt/proof" --on "bolt/$bolt" --on "agent/$TEAM-ops" --refused "$err"; exit 1
  fi
  id=$(python3 "$here/../lib/record.py" emit --label "$LABEL" --act stage.start --on "stage/$bolt/proof" --on "bolt/$bolt" \
    --on "agent/$TEAM-ops" --why "bolt($bolt): start proof" || true)
  [[ -n $id ]] && echo "ops $bolt proof $id bolt/$bolt" >> "$STATE/stages"
  echo "$TEAM-ops is asked to prove bolt/$bolt: crew prove $TEAM --wait waits for its proof file"
}

pick_roles() {  # with no role named, the standing roles
  shift 2 || true; picked=(${@+"$@"})
  [[ ${#picked[@]} -eq 0 ]] && picked=("${standing[@]}")
  local r; for r in "${picked[@]}"; do known_role "$r"; done
}

# ------------------------------------------------------------------------------------------------- commands

case $cmd in
  list) teams ;;
  bolts | bolt | signal | state | plan | rail | card) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  events | trace) exec python3 "$here/../lib/record.py" "${args[@]}" ;;
  page) exec python3 "$here/../lib/page.py" "${args[@]}" ;;
  sites) exec python3 "$here/../lib/sites.py" "${args[@]:1}" ;;
  ops) exec python3 "$here/../lib/ops.py" "${args[@]:1}" ;;
  board | _views | _board) exec python3 "$here/../lib/board.py" "${args[@]}" ;;
  tell) py tell "${2:?usage: crew tell <agent> \"<text>\"}" "${3:?usage: crew tell <agent> \"<text>\"}" ;;
  status)
    if [[ -n ${2:-} ]]; then one _status "$2" ${forced[@]+"${forced[@]}"}
    else first=1; for t in $(teams); do [[ $first == 1 ]] || echo; first=0; bash "$0" status "$t" || true; done; fi ;;
  up)
    load_team "${2:-}"; forward; ensure_state
    for role in "${standing[@]}"; do
      [[ -n $(agent_status "$(pane_of "$role")") ]] && { echo "$(name_of "$role") is already up; use: crew restart $TEAM" >&2; exit 1; }
    done
    mark_up; ensure_team; for role in "${standing[@]}"; do start "$role"; started+=("$role"); done
    record_agents team.up "team($TEAM): up" "${started[@]}"; greet_conductor ;;
  close)
    load_team "${2:-}"; forward; ensure_state; force=1; teardown; mark_down
    record_agents team.close "team($TEAM): close" ${ended[@]+"${ended[@]}"}; echo "$TEAM is closed" ;;
  rebuild)  # a slot whose work is over, its agent ended with the rest, is freed rather than kept
    load_team "${2:-}"; forward; ensure_state; force=1; teardown; reap
    mark_up; ensure_team; for role in "${standing[@]}"; do start "$role"; started+=("$role"); done
    record_agents team.rebuild "team($TEAM): rebuild" "${started[@]}"; greet_conductor ;;
  restart)
    load_team "${2:-}"; forward; ensure_state; pick_roles "$@"; mark_up
    stopped=(); for role in "${picked[@]}"; do stop "$role" && stopped+=("$role"); done
    ensure_team
    for role in ${stopped[@]+"${stopped[@]}"}; do start "$role"; record_agents agent.restart "team($TEAM): restart $role" "$role"; done
    [[ $greet == 1 && " ${picked[*]} " == *" conductor "* ]] && greet_conductor || true ;;
  resume)
    load_team "${2:-}"; forward; ensure_state; pick_roles "$@"; mark_up; ensure_team; back=0
    for role in "${picked[@]}"; do
      if [[ -n $(agent_status "$(pane_of "$role")") ]]; then echo "$(name_of "$role") is already up"; continue; fi
      if start "$role" resume; then record_agents agent.resume "team($TEAM): resume $role" "$role"
      else
        echo "$(name_of "$role") did not come back with its conversation; starting it fresh"
        start "$role"; record_agents agent.start "team($TEAM): start $role" "$role"
      fi
      if [[ $role == conductor ]]; then back=1; fi
    done
    # resume greets nobody: a conductor it brought back is sent, as crew's notice, the units of its bolt that wait amended
    if [[ $back == 1 ]]; then
      line=$(plan _amended "$TEAM" 2>/dev/null || true)
      if [[ -n $line ]]; then py notice "$TEAM-conductor" "$line" || true; fi
    fi ;;
  clear)
    load_team "${2:-}"; forward; ensure_state; role=${3:?usage: crew clear <team> conductor|ops}; known_role "$role"
    pane=$(pane_of "$role"); st=$(agent_status "$pane")
    [[ -z $st ]] && { echo "$(name_of "$role") is not up." >&2; exit 1; }
    [[ $st == working && $force == 0 ]] && { echo "$(name_of "$role") is working; add --force to clear it anyway." >&2; exit 1; }
    h agent prompt "$pane" "/clear" >/dev/null; sleep 2
    give_name "$pane" "$(name_of "$role")" && { record_agents agent.clear "team($TEAM): clear $role" "$role"; echo "$(name_of "$role") cleared"; } ;;
  down)
    load_team "${2:-}"; forward; ensure_state
    for role in "${standing[@]}" "${slots[@]}"; do stop "$role" || true; done; mark_down
    record_agents team.down "team($TEAM): down" ${ended[@]+"${ended[@]}"}; echo "$TEAM is down; its panes are still there." ;;
  unit | chore)  # a chore's stages are code, verify and merge, with no construct (plan.11)
    kind=$cmd
    if [[ $kind == chore ]]; then stages="code verify merge"; as=(--chore); else stages="construct code verify settle merge"; as=(); fi
    case ${2:-} in
      free)
        [[ -n ${3:-} && ( $# == 3 || ( $# == 5 && $4 == --team ) ) ]] || { echo "usage: crew $kind free <$kind> [--team <team>]" >&2; exit 2; }
        one _unit-free "$3" ${5:+--team "$5"} ${forced[@]+"${forced[@]}"} ;;
      wait)
        unit=${3:?usage: crew $kind wait <$kind> [--timeout <ms>] [--stuck <ms>]}; limits "${@:4}"
        one _unit-wait "$unit" ${limit[@]+"${limit[@]}"} ;;
      run)
        unit=${3:?usage: crew $kind run <$kind> ${stages// /|} [\"<words>\"]}
        stage=${4:?usage: crew $kind run <$kind> ${stages// /|} [\"<words>\"]}
        [[ " $stages " == *" $stage "* ]] || { echo "no stage '$stage' for a $kind; stages: $stages" >&2; exit 2; }
        one _unit-run "$unit" "$stage" ${as[@]+"${as[@]}"} ${forced[@]+"${forced[@]}"} -- "${5:-}" ;;
      *) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
    esac ;;
  fix)
    need_team "${2:-}"
    name=${3:?usage: crew fix <team> <name> \"<what is wrong>\" | --merge | --wait}; words=${4:?usage: crew fix <team> <name> \"<what is wrong>\" | --merge | --wait}
    case $words in
      --wait) limits "${@:5}"; one _fix-run "$2" "$name" wait ${limit[@]+"${limit[@]}"} ;;
      --merge) one _fix-run "$2" "$name" merge ${forced[@]+"${forced[@]}"} ;;
      *) one _fix-run "$2" "$name" start ${forced[@]+"${forced[@]}"} -- "$words" ;;
    esac ;;
  needs)  # run by a stage's agent, or ops during a proof: the team and slot are its own name's
    words=${2:-}; who=${CREW_AGENT:-$(id -un)@$(this_host)}; team= slot=
    [[ -n ${words//[[:space:]]/} ]] || { echo "usage: crew needs \"<what you tried and what you need>\"" >&2; exit 2; }
    for t in $(teams); do
      if [[ $who == "$t-ops" || $who == "$t-conductor" ]]; then team=$t; slot=${who#"$t"-}
      elif [[ $who =~ ^$t-(unit-[1-9][0-9]*)$ ]]; then team=$t; slot=${BASH_REMATCH[1]}; fi
    done
    [[ -n $team ]] || { echo "$who runs no stage crew is waiting on" >&2; exit 1; }
    load_team "$team"; forward; ensure_state
    plan _needs "$TEAM" --slot "$slot" "$words" ;;
  prove)
    load_team "${2:-}"; forward; ensure_state
    if [[ ${3:-} == --wait ]]; then stage_wait ops "${@:4}"; else prove "${3:-}"; fi ;;
  _tidy)  # crew _tidy <team>: free the slots whose work has merged or been dropped, and remove the worktrees whose work
    # is over (a plan write that ends work asks for it on the team's host)
    need_team "${2:-}"; one _tidy "$2" ${forced[@]+"${forced[@]}"} ;;
  main)
    sub=${2:-}; load_main "${3:-}"; forward; ensure_state
    case $sub in
      up)
        mark_up; ensure_main; start_standing; record_agents main.up "main($LABEL): up" ${started[@]+"${started[@]}"}
        greet_started ${started[@]+"${started[@]}"}  # each host's own _dispatch up greets its dispatcher
        ups=() rc=0  # side by side, so a dispatcher waiting on a question holds back no other host's; one that fails fails main up
        while read -r host target remote; do
          if [[ $host == $(this_host) ]]; then bash "$0" _dispatch up "$LABEL" </dev/null &
          else there "$target" "$remote" _dispatch up "$LABEL" </dev/null & fi
          ups+=($!)
        done < <(py hosts "$LABEL")
        for p in ${ups[@]+"${ups[@]}"}; do wait "$p" || rc=$?; done
        wait; exit $rc ;;
      down)
        for role in "${standing[@]}"; do stop "$role" || true; done; mark_down
        record_agents main.down "main($LABEL): down" ${ended[@]+"${ended[@]}"}; echo "$LABEL's main level is down; its panes are still there."
        while read -r host target remote; do
          if [[ $host == $(this_host) ]]; then bash "$0" _dispatch down "$LABEL"; else there "$target" "$remote" _dispatch down "$LABEL"; fi
        done < <(py hosts "$LABEL") ;;
      status)
        for role in "${standing[@]}"; do st=$(agent_status "$(pane_of "$role")"); printf '%-34s %-8s %s\n' "$(name_of "$role")" "$(pane_of "$role")" "${st:-not up}"; done
        while read -r host target remote; do
          if [[ $host == $(this_host) ]]; then bash "$0" _dispatch status "$LABEL"; else there "$target" "$remote" _dispatch status "$LABEL" || echo "$LABEL-dispatch-$host  $host did not answer"; fi
        done < <(py hosts "$LABEL") ;;
      *) echo "usage: crew main up|down|status <label>" >&2; exit 2 ;;
    esac ;;
  review)  # crew review <label> [--wait [--timeout <ms>]]: the partition's reviewer, fresh for one batch, in a review tab
    # of the main level's workspace beside the planner; --wait waits for its summary, records the batch and closes its tab
    load_main "${2:-}"; forward; ensure_state
    if [[ ${3:-} == --wait ]]; then
      limit=(); [[ ${4:-} == --timeout ]] && { [[ ${5:-} =~ ^[0-9]+$ ]] || { echo "--timeout takes a number of milliseconds" >&2; exit 2; }; limit=(--timeout "$5"); }
      rc=0; out=$(plan _review-wait "$LABEL" ${limit[@]+"${limit[@]}"}) || rc=$?
      if [[ $rc == 0 ]]; then
        stop reviewer || true; close_pane reviewer
        t=$(get "$layout" tab:review); [[ -n $t ]] && { h tab close "$t" >/dev/null 2>&1 || true; drop "$layout" tab:review; }
        echo "batch summary: $out"
      fi
      exit $rc
    fi
    [[ -n ${3:-} ]] && { echo "usage: crew review <label> [--wait [--timeout <ms>]]" >&2; exit 2; }
    [[ -z $(agent_status "$(pane_of reviewer)") ]] || { echo "$(name_of reviewer) is still reviewing a batch: crew review $LABEL --wait waits for its summary" >&2; exit 1; }
    [[ -n $(get "$layout" "$(ws_key "$LABEL")") ]] || { echo "$LABEL's main level is not up: crew main up $LABEL" >&2; exit 1; }
    e=$(plan _review "$LABEL") || exit 1; eval "$e"
    p=$(pane_of reviewer)
    if ! pane_live "$p"; then  # the tab is kept in the layout, so the batch's end closes it
      t=$(h tab create --workspace "$(get "$layout" "$(ws_key "$LABEL")")" --cwd "$CWD" --label review --no-focus)
      put "$layout" tab:review "$(jq -r '.result.tab.tab_id' <<<"$t")"; put "$panes" reviewer "$(jq -r '.result.root_pane.pane_id' <<<"$t")"
    fi
    start reviewer || exit 1
    h agent prompt "$(pane_of reviewer)" "$PROMPT" >/dev/null
    on=(--on "batch/$N" --on "agent/$(name_of reviewer)"); for u in $NAMES; do on+=(--on "unit/$u"); done
    entry --label "$LABEL" --act review.start "${on[@]}" --field "Batch=$N" --field "Units=$UNITS" --why "batch($N): start review"
    echo "$(name_of reviewer) is reviewing batch $N of $LABEL, into $FILE: crew review $LABEL --wait waits for it" ;;
  _dispatch)  # crew _dispatch up|down|status <label>: this host's dispatcher of the partition
    sub=${2:-}; load_dispatch "${3:?}"; ensure_state
    case $sub in
      up)
        mark_up; ensure_single "$LABEL dispatch" dispatcher; start_standing; record_agents main.up "main($LABEL): up $(name_of dispatcher)" ${started[@]+"${started[@]}"}
        greet_started ${started[@]+"${started[@]}"}; wait ;;
      down) stop dispatcher || true; mark_down; record_agents main.down "main($LABEL): down $(name_of dispatcher)" ${ended[@]+"${ended[@]}"}; echo "$(name_of dispatcher) is down" ;;
      status) st=$(agent_status "$(pane_of dispatcher)"); printf '%-34s %-8s %s\n' "$(name_of dispatcher)" "$(pane_of dispatcher)" "${st:-not up}" ;;
    esac ;;
  revive)  # each team, main level, dispatcher and operator agent of this host, in a process of its own
    while read -r kind scope; do [[ -n $kind ]] && { bash "$0" _revive "$kind" "$scope" || true; }; done < <(py here) ;;
  _revive)  # crew _revive team|main|dispatch|operator <name>
    case ${2:-} in
      team) load_team "${3:?}" ;; main) load_main "${3:?}" ;; dispatch) load_dispatch "${3:?}" ;; operator) load_operator "${3:?}" ;;
      *) echo "usage: crew _revive team|main|dispatch|operator <name>" >&2; exit 2 ;;
    esac
    revive ;;
  operator)
    [[ ${2:-} == up ]] || { echo "usage: crew operator up <label>" >&2; exit 2; }
    load_operator "${3:?usage: crew operator up <label>}"; ensure_state
    ensure_single operator operator
    if [[ -n $(agent_status "$(pane_of operator)") ]]; then echo "$(name_of operator) is already up"
    else start operator; started+=(operator); record_agents operator.up "operator($LABEL): up $(name_of operator)" operator; fi
    ensure_flow; ensure_rail; ensure_board
    greet_started ${started[@]+"${started[@]}"}; wait ;;
  _rail)  # crew _rail <label>: the rail tab's list, printed again every 30 seconds and as soon as the run record gains
    # an entry; a burst of entries refreshes it once. Once the follow ends, it refreshes on the clock alone. Each refresh
    # is one read (crew _views), which prints the rail as crew rail does, ending the card sessions crew rail ends, and
    # writes the board for the board tab.
    label=${2:?usage: crew _rail <label>}
    exec 3< <(bash "$0" events --follow --label "$label" 2>/dev/null)
    while :; do
      out=$(bash "$0" _views "$label" 2>&1 || true)
      printf '\033[H\033[2J%s\n' "$out"
      if read -r -t 30 -u 3 _; then
        while read -r -t 2 -u 3 _; do :; done
      elif (( $? <= 128 )); then
        sleep 30
      fi
    done ;;
  *) usage; exit 2 ;;
esac
