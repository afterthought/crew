#!/usr/bin/env bash
# crew: run bolt teams of agents in herdr, and each partition's main level. Teams and partitions are data in
# ~/.config/crew/teams.json.
#
# A team builds one bolt at a time:
#   crew list                          the teams that are defined
#   crew status  [team]                the conductor and ops (state, context use, compactions, age), and each unit
#                                      slot with the unit or fix it holds and its stage. It first frees each slot
#                                      whose work has merged, been dropped or left the team's bolt, once its agent
#                                      is not working, and removes the worktrees in the team's kit checkout whose
#                                      work is over, naming one kept for uncommitted changes
#   crew up      <team>                open the team's workspace and start its conductor and ops
#   crew rebuild <team>                end everything the team has, close its panes, and stand it up fresh,
#                                      keeping only the slots of work still in flight on its bolt
#   crew close   <team>                end everything the team has and close its panes; nothing is started
#   crew restart <team> [role...] [--no-greet]
#                                      end the conductor's or ops' session and start a fresh one in the same pane
#   crew resume  <team> [role...]      bring back the conductor or ops when not up, with its last conversation
#   crew clear   <team> <role>         /clear the conductor or ops and give it its name back
#   crew down    <team>                end every session the team has; the panes stay
#   crew unit free <unit> [--team <team>]
#                                      free a slot still holding a unit no longer in the team's bolt now, rather
#                                      than at the read after its agent settles: end its agent, and remove the
#                                      worktrees whose work is over; refused while its worktree has uncommitted
#                                      changes
#   crew unit run <unit> construct|code|verify|merge ["<words>"]
#                                      start the unit's stage in its slot, a fresh agent at that stage's effort:
#                                      construct writes its OpenSpec change, code builds it once the user has
#                                      approved it, verify checks it, merge merges it into the bolt. Construct
#                                      run again on an approved unit marks it amended: code waits for the user
#                                      to approve it again
#   crew unit wait <unit> [--timeout <ms>]
#                                      wait for the unit's stage agent to settle, and record the stage's end
#   crew fix     <team> <name> "<what is wrong>"
#                                      a fix on the team's bolt: fix/<bolt>/<name> at places/fix-<bolt>--<name>,
#                                      built by a fresh code agent; a name already in use on the bolt is refused
#   crew fix     <team> <name> --merge merge the fix into the bolt
#
# The plan, the moves and the signals crew records, on the flywheel's branch <label>/main of the partition's state
# repository; a meeting's signals stay in the partition's first blueprints repo:
#   crew state init <label>            create the flywheel's branch, adopting plan/<label> and the moves it had
#   crew bolts [<bolt>] [--label L] [--json]
#                                      every bolt and unit of the plans, each unit's stage read from its kit
#   crew bolt  new|give|order|drop|land ...
#   crew unit  add|split|amend|order|after|move|drop|approve ...
#   crew plan  propose|proposed|agree|approve|drop ...
#                                      the planner's proposals: a change to the plan, applied once the user approves it
#   crew rail  [--label L]             what waits on the user: proposals, reviews, verify reports and bolts to land,
#                                      each with when it began to wait and the command that answers it
#   crew signal <slug> "<what it asserts>" --excerpt "<the words, verbatim>" ...
#                                      record a finding as a signal, quoting the words that show it, which are
#                                      checked against the agent's own Claude transcript
#   crew signal show <id>              a signal, where its excerpt came from, and its move
#   crew signal move <id> attach|challenge|new-territory|answered|drop ...
#                                      curation's move for a signal
#   (crew bolt|unit|plan|signal --help says more)
#
# Each partition's main level, and the operator agent in each operator session:
#   crew main     up|down|status <label>  the design agent, the planner and ops in the <label> workspace of the
#                                      main level's session, and a dispatcher on each host the partition's teams run on
#   crew operator up <label>           the operator agent in this host's operator session <label>, with a flow tab
#                                      following the run record and a rail tab: crew rail above, a shell below
#   crew tell     <agent> "<text>"     prompt an agent crew started, wherever it runs, marked with who sent it
#   crew revive                        after a restart, every standing agent of this host whose pane came back with no
#                                      agent in it, picked up from its last conversation; a team or main level taken
#                                      down with crew down stays down
#   crew sites    [<label>] [--json]   every host's bolts, units and fixes, with the URL of each running dev server
#
# What happened, read from the run record every command that moves work appends on the host it ran on:
#   crew events   [--label L] [--about <object>] [--since <time>] [--follow] [--json]
#                                      the entries of the partition's branch and of every host it runs on, in time order
#   crew events   --push [--label L]   carry this host's run record to the partition's branch now
#   crew trace    <object>             one bolt's, unit's or signal's history: what was done, by whom, in which
#                                      session, with which commit, and what it led to
#
# A team is two herdr workspaces in its session: "<team>", with a "conductor" tab (the conductor and ops) and a
# "git" tab (gitgui in the kit and the blueprints repo), and "<team> units", one pane per slot in flight, which
# exists only while a unit or fix is. A team's panes and state live on its host, so a command about a team runs
# there. Add --force to act on an agent that is working.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
py() { python3 "$here/../lib/crew.py" "$@"; }
plan() { python3 "$here/../lib/plan.py" "$@"; }
h() { herdr --session "$SESSION" "$@"; }
teams() { py teams || exit 1; }
this_host() { hostname -s; }
usage() { awk 'NR == 1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

orig=("$@"); force=0; greet=1; args=(); started=(); ended=()
for a in "$@"; do case $a in --force) force=1 ;; --no-greet) greet=0 ;; *) args+=("$a") ;; esac; done
set -- ${args[@]+"${args[@]}"}
cmd=${1:-}

# ------------------------------------------------------------------------------------------- what is acted on

load_team() {
  [[ -n ${1:-} ]] || { echo "which team? teams: $(teams | tr '\n' ' ')" >&2; exit 2; }
  local e; e=$(py env "$1") || exit 1; eval "$e"
  KIND=team; SCOPE=$TEAM; standing=(conductor ops); slots=()
  local n; for n in $(seq "$UNITS"); do slots+=("unit-$n"); done
  state_files
}
load_main() {
  [[ -n ${1:-} ]] || { echo "which partition? partitions: $(py labels | tr '\n' ' ')" >&2; exit 2; }
  local e; e=$(py env-main "$1") || exit 1; eval "$e"; SCOPE=$LABEL; standing=(design planner ops); slots=(); state_files
}
load_dispatch() { local e; e=$(py env-dispatch "$1") || exit 1; eval "$e"; SCOPE=$LABEL; standing=(dispatcher); slots=(); state_files; }
load_operator() { local e; e=$(py env-operator "$1") || exit 1; eval "$e"; SCOPE=$LABEL; standing=(operator); slots=(); state_files; }
state_files() { panes=$STATE/panes; layout=$STATE/layout; held=$STATE/slots; }
ensure_state() { mkdir -p "$STATE"; touch "$panes" "$layout" "$held"; }
local_here() { [[ $(this_host) == "$MACHINE" ]]; }

# Who asks, and the Claude session behind them, go with a command run on another host, so what it records there names them.
identity() { echo "CREW_AGENT=${CREW_AGENT:-$(id -un)@$(this_host)}"; }
session_of() { python3 "$here/../lib/record.py" session 2>/dev/null || true; }
there() {  # there <host's ssh name> <crew on that host> <args...>: run a crew command on another host
  local target=$1 remote=$2; shift 2
  ssh -o BatchMode=yes "$target" "$(printf '%q ' env "$(identity)" "CREW_LABEL=${CREW_LABEL:-}" "CREW_SESSION=$(session_of)" bash "$remote" "$@")"
}
# An entry in the run record (lib/record.py), written after the act. A failure is said on standard error and
# changes nothing about the command.
entry() { python3 "$here/../lib/record.py" emit "$@" >/dev/null || true; }
record_agents() {  # record_agents <act> <why> [role...]: one entry for an act on agents, naming each; a team's names the team
  local act=$1 why=$2 r on=(); shift 2
  [[ $KIND == team ]] && on+=(--on "team/$TEAM")
  for r in "$@"; do on+=(--on "agent/$(name_of "$r")"); done
  (( ${#on[@]} )) || return 0
  entry --label "$LABEL" --act "$act" "${on[@]}" --why "$why"
}
forward() {  # what is acted on lives on its host: run this same command there, unless this is that host
  local_here && return 0
  local remote; remote=$(py crew-at "$MACHINE") || exit 1
  there "$SSH_TARGET" "$remote" "${orig[@]}"; exit $?
}

name_of() {
  case $KIND in
    team | main) echo "$SCOPE-$1" ;;
    dispatch) echo "$LABEL-dispatch-$HOST" ;;
    operator) echo "$LABEL-operator-$HOST" ;;
  esac
}
is_slot() { [[ $1 == unit-* ]]; }
get() { awk -v k="$2" '$1==k{print $2}' "$1"; }
put() { { grep -v "^$2 " "$1" || true; echo "$2 $3"; } > "$1.new"; mv "$1.new" "$1"; }
drop() { { grep -v "^$2 " "$1" || true; } > "$1.new"; mv "$1.new" "$1"; }
pane_of() { get "$panes" "$1"; }
pane_live() { [[ -n ${1:-} ]] && h pane get "$1" >/dev/null 2>&1; }
agent_status() { [[ -n ${1:-} ]] || return 0; h agent get "$1" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true; }
known_role() {
  local r; for r in "${standing[@]}"; do [[ $r == "$1" ]] && return 0; done
  echo "no role '$1' here; roles: ${standing[*]}" >&2; exit 2
}
split() { h pane split "$1" --direction "$2" --cwd "$3" --no-focus | jq -r '.result.pane.pane_id'; }
close_pane() { local pane; pane=$(pane_of "$1"); if pane_live "$pane"; then h pane close "$pane" >/dev/null 2>&1 || true; fi; drop "$panes" "$1"; }

give_name() {  # herdr drops an agent's name whenever its session changes
  local pane=$1 name=$2
  for _ in $(seq 60); do h agent rename "$pane" "$name" >/dev/null 2>&1 && return 0; sleep 1; done
  echo "$name did not come up in $pane; look at that pane." >&2; return 1
}

stop() {  # end a role's session; each role whose agent it ends is added to `ended`
  local role=$1 pane st=; pane=$(pane_of "$role")
  pane_live "$pane" && st=$(agent_status "$pane")
  if [[ $st == working && $force == 0 ]]; then echo "$(name_of "$role") is working; add --force to end it anyway." >&2; return 1; fi
  # A slot's stage whose end nobody recorded ends here, with the agent that ran it.
  if is_slot "$role" && [[ -s $STATE/stages ]]; then plan _ends "$TEAM" --slot "$role" --ending >/dev/null 2>&1 || true; fi
  [[ -z $st ]] && return 0
  h agent prompt "$pane" "/exit" >/dev/null 2>&1 || h pane send-keys "$pane" ctrl+c ctrl+c >/dev/null 2>&1 || true
  for _ in $(seq 30); do [[ -z $(agent_status "$pane") ]] && { ended+=("$role"); return 0; }; sleep 1; done
  h pane send-keys "$pane" ctrl+c ctrl+c >/dev/null 2>&1 || true; sleep 2
  # Still running means anything started next would be typed into it as a message. Say so and leave it be.
  [[ -z $(agent_status "$pane") ]] || { echo "$(name_of "$role") did not exit (busy or waiting on the user); it was left running" >&2; return 1; }
  ended+=("$role")
}

start() {  # start <role> [stage|resume]
  local role=$1 pane name dir; pane=$(pane_of "$role"); name=$(name_of "$role")
  [[ -z $(agent_status "$pane") ]] || { echo "$name is still running; not starting another over it" >&2; return 1; }
  dir=$(py place "$SCOPE" "$role" ${2:-}) || return 1
  # A Claude that died badly leaves the pane reporting mouse movement, which types escape codes into the shell
  # and into whatever is run next. Clear the line and switch the reporting off first.
  h pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || true
  h pane run "$pane" "printf '\\033[?1000l\\033[?1002l\\033[?1003l\\033[?1006l\\033[?1015l\\033[?2004l'; clear" >/dev/null 2>&1 || true
  sleep 1
  # The pane's own shell moves to the folder the role runs in. herdr saves a pane's shell folder and, after a restart,
  # resumes the agent's conversation there, and Claude finds a conversation only from the folder it began in.
  h pane run "$pane" "cd $(printf '%q' "$dir") && bash $(printf '%q' "$here/crew-role") $SCOPE $role ${2:-}" >/dev/null
  give_name "$pane" "$name" || return 1
  # Claude asks whether a folder it has not seen is trusted. Every role starts in a folder the hosts file names:
  # a session's space, a checkout in it, or a worktree crew made from the team's own repository. So that one
  # question is answered for it. Nothing else is: not the Bypass Permissions warning, which swancloud's settings
  # answer once for every account.
  for _ in $(seq 15); do
    sleep 2
    if h pane read "$pane" --source visible --lines 30 2>/dev/null | command grep -q "Yes, I trust this folder"; then
      h agent send-keys "$pane" down enter >/dev/null 2>&1 || true; sleep 3; break
    fi
    [[ $(agent_status "$pane") == idle ]] && break
  done
  case ${2:-} in resume) echo "$name resumed in $pane" ;; "") echo "$name started in $pane" ;; *) echo "$name started $2 in $pane" ;; esac
}

# ------------------------------------------------------------------------------------------- the workspaces

ws_key() { echo "ws:${1// /_}"; }  # a workspace's label as a key of the layout file, which splits on spaces
workspace() {  # workspace <label> <cwd>: a new workspace; its id goes in the layout, its root pane is printed
  local ws; ws=$(h workspace create --cwd "$2" --label "$1" --no-focus)
  put "$layout" "$(ws_key "$1")" "$(jq -r '.result.workspace.workspace_id' <<<"$ws")"
  echo "$(jq -r '.result.tab.tab_id' <<<"$ws") $(jq -r '.result.root_pane.pane_id' <<<"$ws")"
}
tab() {  # tab <workspace label> <tab label> <cwd> <role>: a tab with one pane for the role
  local t; t=$(h tab create --workspace "$(get "$layout" "$(ws_key "$1")")" --cwd "$3" --label "$2" --no-focus)
  put "$panes" "$4" "$(jq -r '.result.root_pane.pane_id' <<<"$t")"
}
first_tab() {  # first_tab <workspace label> <tab label> <cwd> <role>: the workspace, its first tab holding the role
  local r; r=$(workspace "$1" "$3"); h tab rename "${r% *}" "$2" >/dev/null; put "$panes" "$4" "${r#* }"
}

ensure_team() {  # "<team>": a conductor tab with the conductor and ops, and on a Mac a git tab, gitgui in each repo
  local c o g b
  c=$(pane_of conductor); pane_live "$c" || { first_tab "$TEAM" conductor "$KIT" conductor; c=$(pane_of conductor); }
  o=$(pane_of ops); pane_live "$o" || put "$panes" ops "$(split "$c" right "$KIT")"
  # gitgui draws with terminal graphics, which are too slow to use over a remote host's connection.
  [[ ${HOST_KIND:-} == darwin ]] || return 0
  g=$(pane_of git-kit)
  if ! pane_live "$g"; then tab "$TEAM" git "$KIT" git-kit; g=$(pane_of git-kit); h pane run "$g" gitgui >/dev/null; fi
  b=$(pane_of git-blueprints)
  pane_live "$b" || { b=$(split "$g" right "$BLUEPRINTS"); put "$panes" git-blueprints "$b"; h pane run "$b" gitgui >/dev/null; }
}

ensure_slot_pane() {  # "<team> units" exists only while a slot is in flight, its panes laid out as tiles
  local slot=$1 path=$2 p q r newest= open=0
  p=$(pane_of "$slot"); pane_live "$p" && return 0
  # The panes file lists roles in the order their panes opened, so the last live slot pane in it is the newest.
  # A new pane halves the newest: to its right when an odd number are open, below it when an even number are.
  for r in $(awk '{print $1}' "$panes"); do
    q=$(pane_of "$r"); if is_slot "$r" && pane_live "$q"; then newest=$q; open=$((open + 1)); fi
  done
  if [[ -n $newest ]]; then
    if (( open % 2 )); then p=$(split "$newest" right "$path"); else p=$(split "$newest" down "$path"); fi
  else
    r=$(workspace "$TEAM units" "$path"); h tab rename "${r% *}" units >/dev/null; p=${r#* }
  fi
  put "$panes" "$slot" "$p"
}

ensure_main() {  # "<label>": design, planner and ops tabs, one agent each
  local r p; p=$(pane_of design); pane_live "$p" || first_tab "$LABEL" design "$CWD" design
  for r in planner ops; do p=$(pane_of "$r"); pane_live "$p" || tab "$LABEL" "$r" "$CWD" "$r"; done
}
ensure_single() {  # ensure_single <workspace label> <role>: a workspace holding one agent
  local p; p=$(pane_of "$2"); pane_live "$p" || first_tab "$1" "$2" "$CWD" "$2"
}
ensure_flow() {  # the operator workspace's "flow" tab, following the partition's run record, opened once
  local p; p=$(pane_of flow); pane_live "$p" && return 0
  tab operator flow "$CWD" flow
  h pane run "$(pane_of flow)" "bash $(printf '%q' "$here/crew") events --follow --label $LABEL" >/dev/null
}
ensure_rail() {  # the operator workspace's "rail" tab, opened once: what waits on the user above, kept current by
  # crew _rail, and a shell below with this crew on its path, to paste a row's command into
  local p s; p=$(pane_of rail)
  if ! pane_live "$p"; then
    tab operator rail "$CWD" rail; p=$(pane_of rail)
    h pane run "$p" "bash $(printf '%q' "$here/crew") _rail $LABEL" >/dev/null
  fi
  s=$(pane_of rail-shell); pane_live "$s" && return 0
  s=$(split "$p" down "$CWD"); put "$panes" rail-shell "$s"
  h pane run "$s" "export PATH=$(printf '%q' "$here"):\$PATH" >/dev/null
}

teardown() {  # end every session and give the panes back; the slots still say what is in flight
  local role pane
  for role in $(awk '{print $1}' "$panes"); do stop "$role" || true; done
  for pane in $(awk '{print $2}' "$panes"); do if pane_live "$pane"; then h pane close "$pane" >/dev/null 2>&1 || true; fi; done
  for pane in $(awk '$1 ~ /^ws:/ {print $2}' "$layout"); do h workspace close "$pane" >/dev/null 2>&1 || true; done
  : > "$panes"; : > "$layout"
}

greet_conductor() {  # a fresh conductor reads where its bolt stands and carries on, before anyone asks it anything
  py greet "$TEAM" || true
}

# A team or main level taken down stays down through a restart: crew revive leaves it be until it is brought up.
mark_down() { touch "$STATE/down"; }
mark_up() { rm -f "$STATE/down"; }

revive() {  # start, from its last conversation, each standing role whose pane is there with no agent in it
  local role pane
  [[ -s $panes ]] || return 0
  [[ -e $STATE/down ]] && { echo "$SCOPE was taken down; it stays down"; return 0; }
  for role in "${standing[@]}"; do
    pane=$(pane_of "$role"); pane_live "$pane" || continue
    [[ -z $(agent_status "$pane") ]] || continue
    sleep 10; [[ -z $(agent_status "$pane") ]] || continue  # herdr may still be resuming it
    start "$role" resume || continue
    record_agents agent.resume "${KIND}($SCOPE): resume $(name_of "$role")" "$role"
    [[ $KIND == team && $role == conductor ]] && greet_conductor
  done
}

start_standing() {  # start each standing role that is not up; each one started is added to `started`
  local role
  for role in "${standing[@]}"; do
    if [[ -n $(agent_status "$(pane_of "$role")") ]]; then echo "$(name_of "$role") is already up"; else start "$role"; started+=("$role"); fi
  done
}

# ----------------------------------------------------------------------------------------------- unit slots

slot_of() { awk -v u="$1" '$3==u{print $1}' "$held"; }
holds() { awk -v s="$1" '$1==s{print $3}' "$held"; }
take_slot() {  # take_slot <kind> <name> <place>: the slot holding it, or a free one; refused when all are in flight
  local s; s=$(slot_of "$2"); [[ -n $s ]] && { echo "$s"; return 0; }
  for s in "${slots[@]}"; do
    [[ -z $(holds "$s") ]] && { echo "$s $1 $2 $3" >> "$held"; echo "$s"; return 0; }
  done
  echo "all $UNITS of $TEAM's slots are in flight: $(awk '{printf "%s%s holds %s", sep, $1, $3; sep="; "}' "$held")" >&2
  return 1
}
held_obj() {  # held_obj <unit|fix> <name>: what a slot holds, as an object; a fix started as fix/<name> takes its
  # bolt from its branch's upstream
  local b
  if [[ $1 == fix && $2 == fix/*/* ]]; then echo "$2"
  elif [[ $1 == fix ]]; then
    b=${BOLT:-$(git -C "$KIT" for-each-ref --format='%(upstream:short)' "refs/heads/$2" 2>/dev/null || true)}
    echo "fix/${b#bolt/}/${2#fix/}"
  else echo "unit/$2"; fi
}
free() {  # end a slot's agent, close its pane and give the slot back; the units workspace goes with the last one
  local slot=$1 s w kind name; stop "$slot" || return 1
  read -r kind name < <(awk -v s="$slot" '$1==s{print $2, $3}' "$held") || true
  drop "$held" "$slot"
  [[ -n ${name:-} ]] && entry --label "$LABEL" --act slot.free --on "agent/$(name_of "$slot")" --on "$(held_obj "$kind" "$name")" \
    --why "team($TEAM): free $(name_of "$slot")"
  if [[ -n $(awk 'NF' "$held") ]]; then close_pane "$slot"; return 0; fi
  w=$(get "$layout" "$(ws_key "$TEAM units")"); [[ -n $w ]] && { h workspace close "$w" >/dev/null 2>&1 || true; }
  drop "$layout" "$(ws_key "$TEAM units")"; for s in "${slots[@]}"; do drop "$panes" "$s"; done
}
fix_refused() {  # fix_refused <act> <why>: a fix's start or merge refused, said and recorded
  echo "$2" >&2
  entry --label "$LABEL" --act "$1" --on "fix/$BOLT/$name" --on "bolt/$BOLT" --refused "$2"; exit 1
}
own_place() {  # own_place <place> <branch>: the fix's place is on its own branch, made from the team's bolt. A merge
  # stopped partway through its rebase is on no branch, and is taken as on the branch it is rebasing.
  local on up= d
  on=$(git -C "$1" branch --show-current 2>/dev/null || true)
  for d in rebase-merge rebase-apply; do
    [[ -z $on ]] && on=$(cat "$(git -C "$1" rev-parse --path-format=absolute --git-path "$d/head-name" 2>/dev/null)" 2>/dev/null || true)
  done
  on=${on#refs/heads/}
  [[ -n $on ]] && up=$(git -C "$1" for-each-ref --format='%(upstream:short)' "refs/heads/$on" 2>/dev/null || true)
  [[ $on == "$2" && $up == "bolt/$BOLT" ]] && return 0
  echo "$1 is on ${on:-no branch}, made from ${up:-no bolt}, not $2 from bolt/$BOLT: crew starts a fix only in its own place"
  return 1
}
reap() {  # record the stages that ended with nobody waiting; free every slot whose unit or fix has merged into its
  # bolt, been dropped from the plan or left the team's bolt, once its agent is not working; then remove the
  # worktrees whose work is over
  local slot kind name stage rest
  if [[ -s $STATE/stages ]]; then plan _ends "$TEAM" >/dev/null 2>&1 || true; fi
  while read -r slot kind name stage rest; do
    case $stage in merged | landed | dropped | left) ;; *) continue ;; esac
    if [[ $(agent_status "$(pane_of "$slot")") == working ]]; then
      case $stage in
        dropped) echo "$(name_of "$slot") still holds $name, dropped from the plan: its agent is working; it is freed once that settles" ;;
        left) echo "$(name_of "$slot") still holds $name, which has left $TEAM's bolt: its agent is working; it is freed once that settles" ;;
      esac
      continue
    fi
    free "$slot" || continue
    case $stage in
      dropped) echo "$(name_of "$slot") is free: $name was dropped from the plan" ;;
      left) echo "$(name_of "$slot") is free: $name has left $TEAM's bolt" ;;
      *) echo "$(name_of "$slot") is free: $name has merged into its bolt" ;;
    esac
  done < <(plan _slots "$TEAM" 2>/dev/null || true)
  plan _tidy "$TEAM" || true
}
unit_free() {  # unit_free <unit> [--team <team>]: a slot still holding a unit no longer in the team's bolt
  local unit=${1:?usage: crew unit free <unit> [--team <team>]} team= t slot path out rc=0
  [[ ${2:-} == --team ]] && team=${3:?usage: crew unit free <unit> [--team <team>]}
  if [[ -z $team ]]; then  # the team of this host whose slot holds it
    for t in $(py here | awk '$1 == "team" {print $2}'); do
      awk -v u="$unit" '$3 == u {f = 1} END {exit !f}' "$HOME/.local/state/$t-team/slots" 2>/dev/null && { team=$t; break; }
    done
    [[ -n $team ]] || { echo "no team on this host holds $unit in a slot; name its team: crew unit free $unit --team <team>" >&2; exit 1; }
  fi
  load_team "$team"; forward; ensure_state
  slot=$(slot_of "$unit"); [[ -n $slot ]] || { echo "no slot of $TEAM holds $unit" >&2; exit 1; }
  out=$(plan _in-bolt "$unit" "$TEAM" 2>&1) || rc=$?
  [[ $rc == 0 ]] && { echo "$out: drop it with crew unit drop, which frees its slot" >&2; exit 1; }
  [[ $rc == 3 ]] || { echo "$out" >&2; exit 1; }
  path=$(awk -v s="$slot" '$1 == s {print $4}' "$held")
  if [[ -d $path && -n $(git -C "$path" status --porcelain 2>/dev/null) ]]; then
    echo "$path has uncommitted changes: they are the user's to keep or discard before the slot is freed" >&2; exit 1
  fi
  free "$slot" || exit 1
  echo "$(name_of "$slot") is free"
  plan _tidy "$TEAM" || true
}
free_elsewhere() {  # a unit moved from another team's bolt in this checkout leaves that team's slot
  local f other
  for f in "$HOME"/.local/state/*-team/slots; do
    [[ -f $f ]] || continue; other=$(basename "$(dirname "$f")"); other=${other%-team}
    [[ $other != "$TEAM" ]] && awk -v u="$1" '$3==u{found=1} END{exit !found}' "$f" && bash "$here/crew" _free "$other" "$1" || true
  done
}
run_stage() {  # run_stage <slot> <stage> <prompt> <act> <held name> <object> <--on X...>: end the slot's agent, start
  # the stage fresh and send it its prompt. The start is recorded as <act>, and its end is owed in the stages file.
  local slot=$1 stage=$2 prompt=$3 act=$4 what=$5 obj=$6 err id; shift 6
  if ! err=$(stop "$slot" 2>&1); then echo "$err" >&2; entry --label "$LABEL" --act "$act" "$@" --refused "$err"; exit 1; fi
  start "$slot" "$stage" || exit 1
  h agent prompt "$(pane_of "$slot")" "$prompt" >/dev/null
  id=$(python3 "$here/../lib/record.py" emit --label "$LABEL" --act "$act" "$@" --why "${obj%%/*}(${what##*/}): start $stage" || true)
  [[ -n $id ]] && echo "$slot $what $stage $id $obj" >> "$STATE/stages"
  return 0
}
unit_wait() {  # unit_wait <unit> [--timeout <ms>]: wait for the unit's stage agent to settle, and record the stage's end
  local unit=${1:?usage: crew unit wait <unit> [--timeout <ms>]} ms=3600000 slot e
  [[ ${2:-} == --timeout ]] && ms=${3:?usage: crew unit wait <unit> [--timeout <ms>]}
  e=$(plan _team-of "$unit") || exit 1; eval "$e"
  load_team "$TEAM"; forward; ensure_state
  slot=$(slot_of "$unit"); [[ -n $slot ]] || { echo "no slot of $TEAM holds $unit" >&2; exit 1; }
  h agent wait "$(name_of "$slot")" --timeout "$ms" >/dev/null 2>&1 || true
  if [[ $(agent_status "$(pane_of "$slot")") == working ]]; then
    echo "$(name_of "$slot") is still working on $unit after the wait's $ms ms; nothing is recorded yet"; return 0
  fi
  plan _ends "$TEAM" --slot "$slot" --waited
}

status() {
  printf '%-26s %-8s %-9s %8s %5s %8s  %-12s %s\n' "$TEAM@$MACHINE" pane state context pct compacts started holds
  local role
  for role in "${standing[@]}"; do
    local pane st sid f tok=- pct=- comp=- born=-
    pane=$(pane_of "$role"); st=$(agent_status "$pane")
    if [[ -n $st ]]; then
      sid=$(h agent get "$pane" | jq -r '.result.agent.agent_session.value // empty' || true)
      f=$(ls "$HOME"/.claude*/projects/*/"$sid".jsonl 2>/dev/null | head -1 || true)
      if [[ -n $f ]]; then
        tok=$(command grep '"usage"' "$f" | tail -40 | jq -rs '[.[] | select(.isSidechain|not) | .message.usage | select(.) | (.input_tokens + (.cache_read_input_tokens//0) + (.cache_creation_input_tokens//0))] | last // 0' 2>/dev/null || true); tok=${tok:-0}
        pct=$(( tok * 100 / ${WINDOW:-1000000} ))%; tok=$(( tok / 1000 ))k
        comp=$(command grep -c '"isCompactSummary":true' "$f" || true)
        born=$(command grep -m1 -o '"timestamp":"[^"]*"' "$f" | cut -d'"' -f4 | cut -c6-16 || true)
      fi
    fi
    printf '%-26s %-8s %-9s %8s %5s %8s  %-12s %s\n' "$(name_of "$role")" "${pane:--}" "${st:-not up}" "$tok" "$pct" "$comp" "$born" ""
  done
  local stages slot line
  stages=$(plan _slots "$TEAM" 2>/dev/null || true)
  for slot in "${slots[@]}"; do
    local pane st= holds=
    pane=$(pane_of "$slot"); line=$(awk -v s="$slot" '$1==s' <<<"$stages")
    if [[ -n $line ]]; then
      st=$(agent_status "$pane"); st=${st:-not up}
      holds=$(awk '{print $3 "  " $4 ($5 == "-" ? "" : " " $5)}' <<<"$line")
    elif [[ -n $(holds "$slot") ]]; then
      st=$(agent_status "$pane"); st=${st:-not up}; holds="$(holds "$slot")  unknown"
    fi
    printf '%-26s %-8s %-9s %8s %5s %8s  %-12s %s\n' "$(name_of "$slot")" "${pane:--}" "${st:-free}" - - - - "$holds"
  done
}

pick_roles() {  # with no role named, the standing roles
  shift 2 || true; picked=(${@+"$@"})
  [[ ${#picked[@]} -eq 0 ]] && picked=("${standing[@]}")
  local r; for r in "${picked[@]}"; do known_role "$r"; done
}

# ------------------------------------------------------------------------------------------------- commands

case $cmd in
  list) teams ;;
  bolts | bolt | signal | state | plan | rail) exec python3 "$here/../lib/plan.py" "${args[@]}" ;;
  events | trace) exec python3 "$here/../lib/record.py" "${args[@]}" ;;
  sites) exec python3 "$here/../lib/sites.py" "${args[@]:1}" ;;
  tell) py tell "${2:?usage: crew tell <agent> \"<text>\"}" "${3:?usage: crew tell <agent> \"<text>\"}" ;;
  status)
    if [[ -n ${2:-} ]]; then load_team "$2"; forward; ensure_state; reap; status
    else first=1; for t in $(teams); do [[ $first == 1 ]] || echo; first=0; bash "$0" status "$t" || true; done; fi ;;
  up)
    load_team "${2:-}"; forward; ensure_state
    for role in "${standing[@]}"; do
      [[ -n $(agent_status "$(pane_of "$role")") ]] && { echo "$(name_of "$role") is already up; use: crew restart $TEAM" >&2; exit 1; }
    done
    mark_up; ensure_team; for role in "${standing[@]}"; do start "$role"; started+=("$role"); done
    record_agents team.up "team($TEAM): up" "${started[@]}"; greet_conductor ;;
  close)
    load_team "${2:-}"; forward; ensure_state; force=1; teardown; mark_down
    record_agents team.close "team($TEAM): close" ${ended[@]+"${ended[@]}"}; echo "$TEAM is closed" ;;
  rebuild)  # a slot whose work is over, its agent ended with the rest, is freed rather than kept
    load_team "${2:-}"; forward; ensure_state; force=1; teardown; reap
    mark_up; ensure_team; for role in "${standing[@]}"; do start "$role"; started+=("$role"); done
    record_agents team.rebuild "team($TEAM): rebuild" "${started[@]}"; greet_conductor ;;
  restart)
    load_team "${2:-}"; forward; ensure_state; pick_roles "$@"; mark_up
    stopped=(); for role in "${picked[@]}"; do stop "$role" && stopped+=("$role"); done
    ensure_team
    for role in ${stopped[@]+"${stopped[@]}"}; do start "$role"; record_agents agent.restart "team($TEAM): restart $role" "$role"; done
    [[ $greet == 1 && " ${picked[*]} " == *" conductor "* ]] && greet_conductor || true ;;
  resume)
    load_team "${2:-}"; forward; ensure_state; pick_roles "$@"; mark_up; ensure_team
    for role in "${picked[@]}"; do
      if [[ -n $(agent_status "$(pane_of "$role")") ]]; then echo "$(name_of "$role") is already up"; continue; fi
      if start "$role" resume; then record_agents agent.resume "team($TEAM): resume $role" "$role"
      else
        echo "$(name_of "$role") did not come back with its conversation; starting it fresh"
        start "$role"; record_agents agent.start "team($TEAM): start $role" "$role"
      fi
    done ;;
  clear)
    load_team "${2:-}"; forward; ensure_state; role=${3:?usage: crew clear <team> conductor|ops}; known_role "$role"
    pane=$(pane_of "$role"); st=$(agent_status "$pane")
    [[ -z $st ]] && { echo "$(name_of "$role") is not up." >&2; exit 1; }
    [[ $st == working && $force == 0 ]] && { echo "$(name_of "$role") is working; add --force to clear it anyway." >&2; exit 1; }
    h agent prompt "$pane" "/clear" >/dev/null; sleep 2
    give_name "$pane" "$(name_of "$role")" && { record_agents agent.clear "team($TEAM): clear $role" "$role"; echo "$(name_of "$role") cleared"; } ;;
  down)
    load_team "${2:-}"; forward; ensure_state
    for role in "${standing[@]}" "${slots[@]}"; do stop "$role" || true; done; mark_down
    record_agents team.down "team($TEAM): down" ${ended[@]+"${ended[@]}"}; echo "$TEAM is down; its panes are still there." ;;
  unit)
    [[ ${2:-} == free ]] && { unit_free "${@:3}"; exit 0; }
    [[ ${2:-} == wait ]] && { unit_wait "${@:3}"; exit 0; }
    [[ ${2:-} == run ]] || exec python3 "$here/../lib/plan.py" "${args[@]}"
    unit=${3:?usage: crew unit run <unit> construct|code|verify|merge [\"<words>\"]}
    stage=${4:?usage: crew unit run <unit> construct|code|verify|merge [\"<words>\"]}
    case $stage in construct | code | verify | merge) ;; *) echo "no stage '$stage'; stages: construct code verify merge" >&2; exit 2 ;; esac
    e=$(plan _team-of "$unit") || exit 1; eval "$e"
    load_team "$TEAM"; forward; ensure_state; reap; free_elsewhere "$unit"
    slot=$(slot_of "$unit"); taken=0
    if [[ -z $slot ]]; then
      slot=$(take_slot unit "$unit" "$KIT_DIR/places/$unit") || {
        entry --label "$LABEL" --act stage.start --on "stage/$unit/$stage" --on "unit/$unit" --refused "all $UNITS of $TEAM's slots are in flight"; exit 1; }
      taken=1
    fi
    if ! e=$(plan _run "$unit" "$stage" "${5:-}"); then [[ $taken == 1 ]] && drop "$held" "$slot"; exit 1; fi
    eval "$e"
    ensure_slot_pane "$slot" "$PLACE"
    # A construct that marked the unit amended says so, and is the entry the plan's commit names.
    amended=(); [[ -n $AMENDED ]] && amended=(--field Amended=yes --commit "$AMENDED" --id "$ENTRY")
    run_stage "$slot" "$stage" "$PROMPT" stage.start "$unit" "unit/$unit" --on "stage/$unit/$stage" --on "unit/$unit" --on "agent/$(name_of "$slot")" \
      ${amended[@]+"${amended[@]}"}
    echo "$(name_of "$slot") has $unit: $stage, in $PLACE" ;;
  fix)
    load_team "${2:-}"; forward; ensure_state
    name=${3:?usage: crew fix <team> <name> \"<what is wrong>\" | --merge}; words=${4:?usage: crew fix <team> <name> \"<what is wrong>\" | --merge}
    [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "a fix is named with lowercase words and dashes" >&2; exit 2; }
    reap; e=$(plan _bolt-of "$TEAM") || exit 1; eval "$e"
    # A fix is named within its bolt. One a slot holds, under that name or as the fix/<name> it was given before a
    # fix's name held its bolt, keeps the branch and place its slot recorded.
    fix=fix/$BOLT/$name; path=$KIT_DIR/places/fix-$BOLT--$name
    slot=$(slot_of "$fix"); [[ -n $slot ]] || slot=$(slot_of "fix/$name")
    [[ -n $slot ]] && read -r fix path < <(awk -v s="$slot" '$1==s{print $3, $4}' "$held")
    if [[ $words == --merge ]]; then
      [[ -n $slot ]] || { echo "$TEAM has no fix $name in flight" >&2; exit 1; }
      err=$(own_place "$path" "$fix") || fix_refused fix.merge "$err"
      ensure_slot_pane "$slot" "$path"
      run_stage "$slot" merge "Merge $fix into bolt/$BOLT: wt merge bolt/$BOLT --no-squash --no-remove" fix.merge "$fix" "fix/$BOLT/$name" \
        --on "fix/$BOLT/$name" --on "bolt/$BOLT" --on "agent/$(name_of "$slot")"
      echo "$(name_of "$slot") has $fix: merge, in $path"
    else
      taken=0
      if [[ -z $slot ]]; then  # a new fix never takes over a branch or place that is already there
        if [[ -e $path ]]; then fix_refused fix.start "$fix already has a place at $path that no slot of $TEAM holds: name this fix differently"
        elif git -C "$KIT" rev-parse --verify -q "refs/heads/$fix" >/dev/null; then
          fix_refused fix.start "$fix already has a branch that no slot of $TEAM holds, though no place at $path: name this fix differently"
        fi
        slot=$(take_slot fix "$fix" "$path") || {
          entry --label "$LABEL" --act fix.start --on "fix/$BOLT/$name" --on "bolt/$BOLT" --refused "all $UNITS of $TEAM's slots are in flight"; exit 1; }
        taken=1
      fi
      if ! err=$(plan _place "$TEAM" "$path" "$fix" "bolt/$BOLT" 2>&1) || ! err=$(own_place "$path" "$fix"); then
        [[ $taken == 1 ]] && drop "$held" "$slot"
        fix_refused fix.start "$err"
      fi
      ensure_slot_pane "$slot" "$path"
      run_stage "$slot" fix "Fix: $words" fix.start "$fix" "fix/$BOLT/$name" --on "fix/$BOLT/$name" --on "bolt/$BOLT" --on "agent/$(name_of "$slot")"
      echo "$(name_of "$slot") has $fix: code, in $path"
    fi ;;
  _free)  # crew _free <team> <unit|fix/name>: free the slot holding it (a unit moved to another team's bolt leaves it)
    load_team "${2:-}"; forward; ensure_state; slot=$(slot_of "${3:?}")
    if [[ -n $slot ]]; then free "$slot" || exit 1; echo "$(name_of "$slot") is free"; fi ;;
  _tidy)  # crew _tidy <team>: free the slots whose work has merged or been dropped, and remove the worktrees whose work
    # is over (a plan write that ends work asks for it on the team's host)
    load_team "${2:-}"; forward; ensure_state; reap ;;
  main)
    sub=${2:-}; load_main "${3:-}"; forward; ensure_state
    case $sub in
      up)
        mark_up; ensure_main; start_standing; record_agents main.up "main($LABEL): up" ${started[@]+"${started[@]}"}
        while read -r host target remote; do
          if [[ $host == $(this_host) ]]; then bash "$0" _dispatch up "$LABEL"; else there "$target" "$remote" _dispatch up "$LABEL"; fi
        done < <(py hosts "$LABEL") ;;
      down)
        for role in "${standing[@]}"; do stop "$role" || true; done; mark_down
        record_agents main.down "main($LABEL): down" ${ended[@]+"${ended[@]}"}; echo "$LABEL's main level is down; its panes are still there."
        while read -r host target remote; do
          if [[ $host == $(this_host) ]]; then bash "$0" _dispatch down "$LABEL"; else there "$target" "$remote" _dispatch down "$LABEL"; fi
        done < <(py hosts "$LABEL") ;;
      status)
        for role in "${standing[@]}"; do st=$(agent_status "$(pane_of "$role")"); printf '%-34s %-8s %s\n' "$(name_of "$role")" "$(pane_of "$role")" "${st:-not up}"; done
        while read -r host target remote; do
          if [[ $host == $(this_host) ]]; then bash "$0" _dispatch status "$LABEL"; else there "$target" "$remote" _dispatch status "$LABEL" || echo "$LABEL-dispatch-$host  $host did not answer"; fi
        done < <(py hosts "$LABEL") ;;
      *) echo "usage: crew main up|down|status <label>" >&2; exit 2 ;;
    esac ;;
  _dispatch)  # crew _dispatch up|down|status <label>: this host's dispatcher of the partition
    sub=${2:-}; load_dispatch "${3:?}"; ensure_state
    case $sub in
      up) mark_up; ensure_single "$LABEL dispatch" dispatcher; start_standing; record_agents main.up "main($LABEL): up $(name_of dispatcher)" ${started[@]+"${started[@]}"} ;;
      down) stop dispatcher || true; mark_down; record_agents main.down "main($LABEL): down $(name_of dispatcher)" ${ended[@]+"${ended[@]}"}; echo "$(name_of dispatcher) is down" ;;
      status) st=$(agent_status "$(pane_of dispatcher)"); printf '%-34s %-8s %s\n' "$(name_of dispatcher)" "$(pane_of dispatcher)" "${st:-not up}" ;;
    esac ;;
  revive)  # each team, main level, dispatcher and operator agent of this host, in a process of its own
    while read -r kind scope; do [[ -n $kind ]] && { bash "$0" _revive "$kind" "$scope" || true; }; done < <(py here) ;;
  _revive)  # crew _revive team|main|dispatch|operator <name>
    case ${2:-} in
      team) load_team "${3:?}" ;; main) load_main "${3:?}" ;; dispatch) load_dispatch "${3:?}" ;; operator) load_operator "${3:?}" ;;
      *) echo "usage: crew _revive team|main|dispatch|operator <name>" >&2; exit 2 ;;
    esac
    revive ;;
  operator)
    [[ ${2:-} == up ]] || { echo "usage: crew operator up <label>" >&2; exit 2; }
    load_operator "${3:?usage: crew operator up <label>}"; ensure_state
    ensure_single operator operator
    if [[ -n $(agent_status "$(pane_of operator)") ]]; then echo "$(name_of operator) is already up"
    else start operator; record_agents operator.up "operator($LABEL): up $(name_of operator)" operator; fi
    ensure_flow; ensure_rail ;;
  _rail)  # crew _rail <label>: the rail tab's list, printed again every 30 seconds and as soon as the run record gains
    # an entry; a burst of entries refreshes it once. Once the follow ends, it refreshes on the clock alone.
    label=${2:?usage: crew _rail <label>}
    exec 3< <(bash "$0" events --follow --label "$label" 2>/dev/null)
    while :; do
      out=$(bash "$0" rail --label "$label" 2>&1 || true)
      printf '\033[H\033[2J%s\n' "$out"
      if read -r -t 30 -u 3 _; then
        while read -r -t 2 -u 3 _; do :; done
      elif (( $? <= 128 )); then
        sleep 30
      fi
    done ;;
  *) usage; exit 2 ;;
esac
